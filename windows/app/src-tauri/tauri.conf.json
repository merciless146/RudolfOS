{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blitzen",
  "version": "0.1.1",
  "identifier": "io.github.merciless146.blitzen",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blitzen",
        "width": 1000,
        "height": 760,
        "minWidth": 420,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Rudolf OS",
    "copyright": "GPL-2.0-or-later",
    "category": "DeveloperTool",
    "shortDescription": "Offline coding assistant",
    "longDescription": "Blitzen answers coding questions in BlockLua, JavaScript, C++ and Python with a model that runs on this PC, and checks its code by running it in a sandbox.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
