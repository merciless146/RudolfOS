#!/bin/sh
# 1.5.7 (plan stage 5): rudolf-selftest. The checks that were run by hand over the development link during the 1.5.6
# betas, as one script: the account's folders as Linux apps see them, Downloads, Debian's view, the camera, the
# battery limit, memory, the logs, the network. It only reads: nothing is changed, started or stopped. One line per
# check: "PASS name - detail", "FAIL name - detail" or "SKIP name - why"; then a summary line. Exit status 1 when a
# check failed. Run by rudolfd (GET selftest, Settings › System health › Run the self-test) and over the devlink.
# The places can be moved for the host test (ST_SYS, ST_RUN, ST_PERSIST, ST_HOME, ST_DEV, ST_PROC, ST_CONF, and since
# 1.5.7 ST_MEMCONF, ST_JOYPERM, ST_FLATPAK, ST_FLATPAK_BIN, ST_LIBDIR, ST_WEBKIT, and since 1.5.8 ST_DMESG).
# GPL-2.0-or-later.
SYS=${ST_SYS:-/sys}; RUN=${ST_RUN:-/run/rudolf}; P=${ST_PERSIST:-/persist}; H=${ST_HOME:-/home/rudolf}; DEV=${ST_DEV:-/dev}; PROC=${ST_PROC:-/proc}
NP=0; NF=0; NS=0
pass() { NP=$((NP+1)); echo "PASS $1 - $2"; }
fail() { NF=$((NF+1)); echo "FAIL $1 - $2"; }
skip() { NS=$((NS+1)); echo "SKIP $1 - $2"; }
ino() { stat -L -c %d:%i "$1" 2>/dev/null; }
rd1() { head -c 200 "$1" 2>/dev/null | head -1; }
running() { for c in "$PROC"/[0-9]*/comm; do [ "$(rd1 "$c")" = "$1" ] && return 0; done; return 1; }

# ---- the system
if running rudolfd; then pass rudolfd "running"; else fail rudolfd "not running: the desktop cannot reach the system"; fi
PERS=0; [ -e "$RUN/persistent" ] && PERS=1
if [ $PERS = 1 ]; then pass storage "your data partition (RUDOLFDATA) is in use"
else skip storage "a live start: nothing is kept after a restart"; fi
if [ $PERS = 1 ]; then
	l=$(readlink "$RUN/rudolfd.log" 2>/dev/null)
	if [ "$l" = "$P/var/log/rudolfd.log" ] && [ -f "$l" ]; then pass logs "rudolfd's log is kept on the disk ($(ls "$P"/var/log/rudolfd.log.* 2>/dev/null | wc -l) earlier start-ups)"
	else fail logs "rudolfd's log is not kept on the disk (/run/rudolf/rudolfd.log -> ${l:-nothing})"; fi
	if [ -f "$P/var/log/health.log" ]; then pass health-log "$(wc -l < "$P/var/log/health.log") events"; else fail health-log "the health log is missing"; fi
	fr=$(df -P "$P" 2>/dev/null | awk 'NR==2{print int($4*100/($2+1))}')
	if [ -z "$fr" ]; then skip disk-space "not measured"; elif [ "$fr" -ge 5 ]; then pass disk-space "$fr % free"; else fail disk-space "only $fr % free: delete or move files"; fi
fi

# 1.5.9 (plan 8.3): which system runs: the Official Rudolf OS (every file in a release list signed by the official key),
# or a Custom build in Developer mode (said, not a failure); whether the recovery system is the official one.
# ST_UPDATE names a stand-in rudolf-update.
U=${ST_UPDATE:-/usr/bin/rudolf-update}
if [ ! -x "$U" ]; then skip build "no system updates on this start (a test disc)"
else us=$("$U" status 2>/dev/null)
	sg=$(printf '%s' "$us" | sed -n 's/.*"signer":"\([a-z]*\)".*/\1/p'); ky=$(printf '%s' "$us" | sed -n 's/.*"signerKey":"\([A-Za-z0-9+\/=]*\)".*/\1/p')
	ro=$(printf '%s' "$us" | sed -n 's/.*"recoveryOfficial":\(true\|false\).*/\1/p'); dv=$(printf '%s' "$us" | sed -n 's/.*"developer":\(true\|false\).*/\1/p')
	rn=""; [ "$ro" = false ] && [ $PERS = 1 ] && rn=" (no official recovery system kept yet: it is kept once an official release has started)"
	case "$sg" in
	official) pass build "Official Rudolf OS$([ "$dv" = true ] && echo ', Developer mode on')$rn";;
	custom) pass build "Custom build, signed by key $(printf '%.8s' "$ky")… in Developer mode; Recovery mode starts the official Rudolf OS$rn";;
	*) skip build "not started from a signed release (a disc or a build of one's own)";;
	esac
fi

# ---- the signed-in account's folders, as Linux apps see them
ACCT=$(rd1 "$RUN/home-session")
if [ -z "$ACCT" ]; then skip folders "nobody is signed in with their files on the disk"
else
	A="$P/accounts/$ACCT"; bad=""; n=0
	for f in Documents Pictures Music Videos; do n=$((n+1)); [ -n "$(ino "$A/$f")" ] && [ "$(ino "$A/$f")" = "$(ino "$H/$f")" ] || bad="$bad $f"; done
	if [ -z "$bad" ]; then pass folders "Linux apps see the account's Documents, Pictures, Music and Videos"
	else fail folders "Linux apps do not see the account's:$bad"; fi
fi

# ---- Downloads
if [ $PERS = 1 ]; then
	S="$RUN/dl"
	if [ -L "$S" ]; then pass downloads-store "Downloads is shared (a link: $(readlink "$S"))"
	elif [ -d "$S" ] && grep -q " $S " "$PROC/self/mountinfo" 2>/dev/null; then pass downloads-store "the downloads store is bound"
	else fail downloads-store "the downloads store is missing ($S)"; fi
	if [ -d "$S/.incoming" ]; then
		old=$(find "$S/.incoming" -maxdepth 1 -name '*.crdownload' -mtime +1 2>/dev/null | wc -l)
		if [ "$old" = 0 ]; then pass downloads-partial "no unfinished downloads older than a day"
		else fail downloads-partial "$old unfinished download(s) older than a day in .incoming"; fi
	fi
	if [ -n "$ACCT" ]; then
		if [ "$(ino "$P/accounts/$ACCT/Downloads")" = "$(ino "$H/Downloads")" ]; then pass downloads-folder "Linux apps' Downloads is the account's"
		else skip downloads-folder "Linux apps' Downloads is shared, not the account's own"; fi
	fi
fi

# ---- Debian (Linux programs, Wine)
K=$(rd1 "$RUN/debian/init.pid")
if [ ! -e "$P/debian/.rudolf-ready" ]; then skip debian "Linux (Debian) is not set up"
elif [ -z "$K" ] || [ "$(rd1 "$PROC/$K/comm")" != debian-init ]; then skip debian "Linux (Debian) is not running now"
elif [ -z "$ACCT" ]; then skip debian "nobody is signed in"
elif ! ls "$PROC/$K/root/home/" >/dev/null 2>&1; then skip debian "Debian's files cannot be looked at from here (run the self-test as root: Settings › System health)"
else
	bad=""; for f in Documents Pictures Music Videos; do [ "$(ino "$PROC/$K/root/home/rudolf/$f")" = "$(ino "$P/accounts/$ACCT/$f")" ] || bad="$bad $f"; done
	if [ -z "$bad" ]; then pass debian "Debian's programs see the account's folders"; else fail debian "Debian's programs do not see the account's:$bad"; fi
fi

# ---- the camera
# 1.5.9 (plan 7.2): also when it is missing (switched off in Privacy, or a USB camera without its driver) and which
# app has it open (a camera is used by one app at a time: a call cannot have it while another app does)
cams=$(ls "$DEV"/video[0-9]* 2>/dev/null)
if [ -z "$cams" ]; then
	if [ -e "$RUN/camera-off" ]; then skip camera "no camera: it is switched off (Settings › Privacy › Camera)"
	elif cat "$SYS"/bus/usb/devices/*/modalias 2>/dev/null | grep -q 'ic0Eisc01'; then fail camera "a camera is connected but has no driver (uvcvideo): no app can use it"
	else skip camera "no camera found"; fi
else
	bad=""; for c in $cams; do g=$(stat -c %G "$c" 2>/dev/null); m=$(stat -c %a "$c" 2>/dev/null); gm=$(( (0${m:-0} >> 3) & 6 ))
		{ [ "$g" = video ] || [ "$(stat -c %g "$c" 2>/dev/null)" = 1000 ]; } && [ $gm = 6 ] || bad="$bad ${c##*/}($g $m)"; done
	use=""; for f in "$PROC"/[0-9]*/fd/*; do l=$(readlink "$f" 2>/dev/null); case "$l" in "$DEV"/video[0-9]*|/dev/video[0-9]*)
		a=$(rd1 "${f%/fd/*}/comm"); case " $use " in *" $a "*) ;; *) use="$use $a";; esac;; esac; done
	inuse=""; [ -n "$use" ] && inuse=" (in use now by$use)"
	if [ -z "$bad" ]; then pass camera "$(echo $cams | wc -w) camera device(s), usable by apps$inuse"; else fail camera "not usable by apps:$bad$inuse"; fi
fi

# ---- the battery limit
B=$(ls -d "$SYS"/class/power_supply/BAT* 2>/dev/null | head -1)
CONF=${ST_CONF:-$P/etc/power.conf}; [ -f "$CONF" ] || CONF=$RUN/power.conf
if [ -z "$B" ]; then skip battery-limit "no battery"
elif [ ! -e "$B/charge_control_end_threshold" ]; then skip battery-limit "this computer does not let Rudolf OS limit charging"
else
	want=$(sed -n 's/^care=//p' "$CONF" 2>/dev/null | tail -1); [ "$want" = 60 ] && want=70; [ -n "$want" ] || want=100
	have=$(rd1 "$B/charge_control_end_threshold")
	if [ "$have" = "$want" ]; then pass battery-limit "charging stops at $have %"
	else fail battery-limit "set to $want %, the battery keeps $have % (this computer may allow only some limits)"; fi
fi

# ---- memory
# (1.5.9: a cgroup's files report a size of 0, so whether the browser is in the desktop's group is read, not sized:
#  test -s said "its browser is not in it" on the Vivobook with 14 of its processes there)
Z="$SYS/block/zram0"
MSET=$(sed -n 's/^zram=//p' "${ST_MEMCONF:-$P/etc/rudolf-memory}" 2>/dev/null | tail -1); [ -n "$MSET" ] || MSET=auto
if [ "$MSET" = off ]; then skip compressed-memory "off (Settings › System health › Memory)"
elif [ ! -e "$Z/disksize" ]; then skip compressed-memory "off (or not in this kernel)"
elif [ "$(rd1 "$Z/disksize")" -gt 0 ] 2>/dev/null && grep -q zram0 "$PROC/swaps" 2>/dev/null; then
	# 1.5.7: its size as set: as large as the memory (Automatic) or half of it (Smaller), at most 8 GiB
	ds=$(rd1 "$Z/disksize"); mt=$(( $(sed -n 's/^MemTotal: *\([0-9]*\).*/\1/p' "$PROC/meminfo" 2>/dev/null) * 1024 )); want=$mt; [ "$MSET" = small ] && want=$((mt / 2)); [ $want -gt 8589934592 ] && want=8589934592
	if [ $mt -gt 0 ] && { [ $ds -lt $((want * 95 / 100)) ] || [ $ds -gt $((want * 105 / 100)) ]; }; then fail compressed-memory "$((ds / 1048576)) MiB, but $MSET means $((want / 1048576)) MiB (restart to apply a new setting)"
	else pass compressed-memory "$((ds / 1048576)) MiB ($MSET), in use"; fi
else fail compressed-memory "made but not in use"; fi
G="$SYS/fs/cgroup/desktop"
if [ ! -d "$SYS/fs/cgroup" ] || [ ! -e "$SYS/fs/cgroup/cgroup.controllers" ]; then skip desktop-memory "no memory groups in this kernel"
elif [ -e "$G/memory.low" ] && [ "$(rd1 "$G/memory.low")" != 0 ]; then pass desktop-memory "the desktop keeps $(( $(rd1 "$G/memory.low") / 1048576 )) MiB$( grep -q . "$G/cgroup.procs" 2>/dev/null && echo ", with its browser in it" || echo ", but its browser is not in it")"
else fail desktop-memory "the desktop's memory group is missing or keeps nothing"; fi
# 1.5.9 (plan 15.1): only the desktop gets rudolfd's page and API (by its memory group), and Yama keeps programs from
# reading another's memory (the browser's) by ptrace
if [ ! -d "$SYS/fs/cgroup" ] || [ ! -e "$SYS/fs/cgroup/cgroup.controllers" ]; then skip desktop-guard "no memory groups in this kernel: any program can reach the desktop's page"
elif [ -e "$RUN/peer-unchecked" ]; then fail desktop-guard "not enforced: the desktop's memory group was missing or empty when a program asked (see System health)"
elif grep -q . "$G/cgroup.procs" 2>/dev/null; then pass desktop-guard "only the desktop gets its page and the system API"
else skip desktop-guard "no desktop running"; fi
YS=$(rd1 "$PROC/sys/kernel/yama/ptrace_scope")
case "$YS" in 1|2|3) pass ptrace "programs cannot read each other's memory (Yama $YS)";; '') fail ptrace "this kernel has no Yama: a program can read the browser's memory";; *) fail ptrace "Yama is off (ptrace_scope 0)";; esac
# 1.5.9 (plan 15.5): nothing listens that the list of listeners (/usr/share/rudolf/listeners) does not name: TCP ports
# being listened on (/proc/net/tcp, tcp6: state 0A) and Unix sockets accepting connections (/proc/net/unix: flags
# 00010000), each matched against the list's places (* any name, @ abstract)
LST=${ST_LISTENERS:-/usr/share/rudolf/listeners}
if [ ! -r "$LST" ]; then fail listeners "the list of listeners is missing ($LST)"
else
	HEX='function h(x,  i,v){v=0;x=toupper(x);for(i=1;i<=length(x);i++)v=v*16+index("0123456789ABCDEF",substr(x,i,1))-1;return v}'
	got=$( { awk "$HEX"'NR>1&&$4=="0A"{split($2,a,":");x=a[1];printf "tcp %d.%d.%d.%d:%d\n",h(substr(x,7,2)),h(substr(x,5,2)),h(substr(x,3,2)),h(substr(x,1,2)),h(a[2])}' "$PROC/net/tcp" 2>/dev/null
		awk "$HEX"'NR>1&&$4=="0A"{split($2,a,":");x=a[1];ad=x;if(x=="00000000000000000000000000000000")ad="::";else if(x=="00000000000000000000000001000000")ad="::1";printf "tcp6 %s:%d\n",ad,h(a[2])}' "$PROC/net/tcp6" 2>/dev/null
		awk 'NR>1&&$4=="00010000"&&$8!=""{print "unix " $8}' "$PROC/net/unix" 2>/dev/null; } | sort -u)
	pats=$(grep -v '^#' "$LST" | awk -F'\t' 'NF>=3&&($1=="tcp"||$1=="tcp6"||$1=="unix"){print $1 " " $2 " " $3}')
	unk=""; n=0; LAPPS=""
	for l in $(echo "$got" | tr ' ' '|'); do k=${l%%|*}; w=${l#*|}; n=$((n+1)); hit=""
		while read -r pk pw pp; do [ "$pk" = "$k" ] || continue
			# (a pattern's * stands for any characters; the patterns come from the list, not from the computer)
			case "$w" in $pw) hit=$pp; break;; esac
		done <<E
$pats
E
		[ -n "$hit" ] || unk="$unk $k $w,"
	done
	# 2026-11-14: a Unix socket of a Linux app's own, in Debian's container or a Flatpak sandbox (the Claude app's,
	# an Electron app's SingletonSocket), in a folder of its own inside that container (its /tmp or runtime folder,
	# 0700 for its user): the app's business, not a door into Rudolf OS. Found through the socket's inode and the
	# process holding it; anything else stays a failure (and a TCP port of a Linux app always does).
	case "$unk" in *"unix "*)
		DR=""; [ -n "$K" ] && DR=$(stat -L -c %d:%i "$PROC/$K/root" 2>/dev/null)
		FD=$(for f in "$PROC"/[0-9]*/fd/*; do t=$(readlink "$f" 2>/dev/null); case "$t" in socket:*) q=${f#"$PROC"/}; echo "${t#socket:} ${q%%/*}";; esac; done)
		left=""; apps=0
		for e in $(echo "$unk" | tr ' ' '|' | tr ',' ' '); do e=${e#|}; k=${e%%|*}; w=${e#*|}; own=""
			if [ "$k" = unix ]; then case "$w" in /tmp/*|/run/user/*)
				ino=$(awk -v p="$w" 'NR>1&&$4=="00010000"&&$8==p{print $7; exit}' "$PROC/net/unix" 2>/dev/null)
				pid=$(echo "$FD" | awk -v i="[$ino]" '$1==i{print $2; exit}')
				if [ -n "$ino" ] && [ -n "$pid" ] && [ "$(stat -c %u "$PROC/$pid" 2>/dev/null)" != 0 ]; then
					if [ -n "$DR" ] && [ "$(stat -L -c %d:%i "$PROC/$pid/root" 2>/dev/null)" = "$DR" ]; then own=1
					elif [ -e "$PROC/$pid/root/.flatpak-info" ]; then own=1; fi
				fi;; esac; fi
			if [ -n "$own" ]; then apps=$((apps+1)); else left="$left $k $w,"; fi
		done
		unk=$left; [ $apps -gt 0 ] && LAPPS=" (and $apps of Linux apps' own, inside their containers)";;
	esac
	# (not root, as over the read-only development link: other users' processes cannot be looked into, so a Unix socket
	# in a /tmp or runtime folder cannot be told to be a Linux app's own; said, not failed)
	if [ -n "$unk" ] && [ "$(id -u)" != 0 ] && ! echo "$unk" | tr ',' '\n' | grep -v '^ *$' | grep -qv '^ *unix /\(tmp\|run/user\)/'; then skip listeners "the sockets of other users' programs cannot be looked at from here (run the self-test as root: Settings › System health):${unk%,}"
	elif [ -n "$unk" ]; then fail listeners "something listens that the list of listeners does not name:${unk%,}"
	else pass listeners "$n listening, each named in the list (who may use it and how it checks)${LAPPS}"; fi
fi

# ---- 1.5.8: every sound chip answered at start-up (or was reset): one that did not has no card, so no speakers
DM=$( { [ -n "$ST_DMESG" ] && cat "$ST_DMESG" || dmesg; } 2>/dev/null)
bad=""; for a in $(echo "$DM" | sed -n 's/.*snd_hda_intel \([0-9a-f:.]*\): no codecs initialized.*/\1/p' | sort -u); do
	ls -d "$SYS/bus/pci/devices/$a/sound/card"* >/dev/null 2>&1 || bad="$bad $a"; done
if [ -n "$bad" ]; then fail sound-chip "the sound chip did not answer at start-up ($(echo $bad)): shut the computer down fully (not Restart), wait 10 seconds and turn it on"
elif echo "$DM" | grep -q 'no codecs initialized'; then pass sound-chip "it did not answer at start-up, and was reset"
elif [ -d "$SYS/class/sound" ] || [ -n "$ST_DMESG" ]; then pass sound-chip "every sound chip answered at start-up"
else skip sound-chip "no sound cards"; fi

# ---- 1.5.7: the Lite desktop engine has what it opens while running (on the Vivobook it closed as it started: no
# libGLESv2.so.2 in the system)
ML=${ST_LIBDIR:-/usr/lib/x86_64-linux-gnu}
if [ ! -x "${ST_WEBKIT:-/usr/bin/rudolf-webkit}" ]; then skip lite-engine "not in this Rudolf OS"
else bad=""; for l in libGLESv2.so.2 libEGL.so.1 libGLdispatch.so.0 libepoxy.so.0; do [ -e "$ML/$l" ] || bad="$bad $l"; done
	[ -x "$ML/webkit2gtk-4.1/WebKitWebProcess" ] || bad="$bad WebKitWebProcess"
	if [ -z "$bad" ]; then pass lite-engine "WebKit and the graphics libraries it opens are there"; else fail lite-engine "missing:$bad (Lite would close as it starts; Standard is used)"; fi
fi
# 1.5.8: Mesa's GLX: without it GTK finds no OpenGL and WebKit turns its hardware acceleration off (Lite still works,
# drawing everything with the processor)
if [ -x "${ST_WEBKIT:-/usr/bin/rudolf-webkit}" ]; then soft=""; for l in libGLX_mesa.so.0 libxcb-glx.so.0; do [ -e "$ML/$l" ] || soft="$soft $l"; done
	if [ -z "$soft" ]; then pass lite-gpu "Mesa's GLX is there: Lite can draw with the GPU"; else fail lite-gpu "missing:$soft (Lite draws in software, without the GPU)"; fi
fi

# ---- 1.6.0: OpenGL for Linux apps and games (GLX): the X server on the graphics card loads Mesa's driver for it. 1.5.9's
# looked in "/usr/lib/$MA/dri" (a build mistake), found none and offered no OpenGL to any program: Unvanquished showed
# "Couldn't load a renderer.", SuperTuxKart did not start (the desktop itself, drawn through EGL, was fine)
XL=$RUN/Xorg.log
if [ "$(rd1 "$RUN/display-mode")" != gpu ] || [ ! -f "$XL" ]; then skip linux-opengl "the X server is not on the graphics card (the software display)"
elif grep -q 'GLX: Initialized .* GL provider' "$XL"; then pass linux-opengl "the X server offers OpenGL (GLX) to Linux apps and games ($(sed -n 's/.*GLX: Initialized \([A-Za-z0-9]*\) GL provider.*/\1/p' "$XL" | head -1))"
elif grep -q 'GLX: no usable GL providers' "$XL"; then fail linux-opengl "the X server offers no OpenGL to Linux apps and games: $(grep -m1 -o 'AIGLX error: dlopen of [^ ]* failed' "$XL" || echo 'no GL provider') (games stop: \"Couldn't load a renderer\")"
else skip linux-opengl "the X server's log says nothing about GLX yet"; fi

# ---- 1.5.7 (plan stage 8): Linux apps and games
bad=""; for n in fd stdin stdout stderr; do [ -e "$DEV/$n" ] || [ -L "$DEV/$n" ] || bad="$bad /dev/$n"; done
if [ -z "$bad" ]; then pass dev-fd "/dev/fd, /dev/stdin, /dev/stdout and /dev/stderr are there (Steam's interface needs them)"
else fail dev-fd "missing:$bad (Steam's interface and scripts fail without them)"; fi
pads=""; bad=""; for e in "$DEV"/input/event[0-9]*; do [ -e "$e" ] || continue; n=${e##*/}
	if [ -f "$SYS/class/input/$n/device/capabilities/key" ] && RUDOLF_TEST_SYS=$SYS ${ST_JOYPERM:-/usr/lib/rudolf/joyperm} check "$n" 2>/dev/null; then pads="$pads $n"; g=$(stat -c %g "$e"); m=$(stat -c %a "$e"); gm=$(( (0${m:-0} >> 3) & 6 ))
		[ "$g" = 1000 ] && [ $gm = 6 ] || bad="$bad $n($g $m)"; fi; done
js=$(ls "$DEV"/input/js[0-9]* 2>/dev/null | wc -l)
if [ -z "$pads" ]; then skip controllers "no game controller plugged in"
elif [ -z "$bad" ]; then pass controllers "$(echo $pads | wc -w) controller(s)$([ "$js" -gt 0 ] && echo ", $js joystick device(s)"), usable by games"
else fail controllers "not usable by games:$bad"; fi
FP=${ST_FLATPAK:-/var/lib/flatpak}
if [ ! -x "${ST_FLATPAK_BIN:-/usr/bin/flatpak}" ]; then skip flatpak "this Rudolf OS has no Linux apps (Flatpak)"
elif [ $PERS = 0 ]; then skip flatpak "a live start: Linux apps are not kept"
elif [ -L "$P/flatpak" ] && ! grep -q " ${FP%/} " "$PROC/self/mountinfo" 2>/dev/null; then
	if [ -n "$ACCT" ]; then fail flatpak "Linux apps are in the encrypted folder, but it was not opened at sign-in"; else skip flatpak "Linux apps are in the encrypted folder, which opens at sign-in"; fi
else n=$(ls "$FP/app" 2>/dev/null | wc -l); pass flatpak "$n Linux app(s) installed"; fi
if [ -e "$P/debian/.rudolf-ready" ]; then
	if [ -x "$P/debian/usr/bin/wine" ] || [ -x "$P/debian/usr/lib/wine/wine64" ] || ls "$P"/debian/usr/bin/wine* >/dev/null 2>&1; then pass debian-wine "Debian is set up, with Wine for Windows programs"
	else pass debian-wine "Debian is set up (no Wine: Windows programs need it)"; fi
elif [ -L "$P/debian" ] && [ ! -e "$P/debian/" ]; then skip debian-wine "Debian is in the encrypted folder, which opens at sign-in"
else skip debian-wine "Linux (Debian) is not set up"; fi
WF="$RUN/windows"
if [ ! -e "$WF" ]; then skip windows "the display is not running"
else nw=$(grep -c . "$WF" 2>/dev/null); nf=$(awk -F'\t' '$5==1' "$WF" 2>/dev/null | wc -l)
	pass windows "$nw app window(s) on screen$([ "$nf" -gt 0 ] && echo ", $nf full screen")$( [ "$nw" -gt 0 ] && echo ": $(cut -f3 "$WF" | sort -u | head -6 | tr '\n' ' ' | sed 's/ $//')")"; fi

# ---- the network
W=""; for d in "$SYS"/class/net/*; do [ -e "$d/wireless" ] && W=${d##*/}; done
if [ -z "$W" ]; then skip wifi "no Wi-Fi adapter"
elif running wpa_supplicant; then
	if ip -4 addr show "$W" 2>/dev/null | grep -q 'inet '; then pass wifi "$W has an address"; else skip wifi "$W is not connected to a network now"; fi
else fail wifi "the Wi-Fi service is not running ($W)"; fi
# 1.6.0 (plan Part 15): the start-up files on the drive: recovery.efi always Rudolf OS's own (Recovery mode); rudolf.efi
# too unless a custom build replaced it (Developer mode). Read as root only (espcheck mounts the drive's EFI image).
if [ "$(id -u)" != 0 ] || [ ! -x /usr/lib/rudolf/espcheck ] || [ ! -e "${ESP_IMG:-/live/media/efi/efiboot.img}" ]; then skip startfiles "not checked here (it needs root and the drive's EFI image)"
else es=$(/usr/lib/rudolf/espcheck status 2>/dev/null)
	case "$es" in
	"start=official recovery=official") pass startfiles "rudolf.efi and recovery.efi are signed by Rudolf OS";;
	"start=other recovery=official") if [ -s /persist/etc/rudolf/extra-keys ]; then pass startfiles "recovery.efi is Rudolf OS's; rudolf.efi is a custom build's (Developer mode)"
		else fail startfiles "rudolf.efi is not signed by Rudolf OS, and Developer mode is off: an official start puts it back"; fi;;
	*) fail startfiles "the start-up files are not as they should be ($es): an official start puts them back";;
	esac
fi
# 1.6.0 (plan Part 9): devices through udev: udevd running and answering, its database filled; mdev only as the fallback
dv=$(rd1 "$RUN/devices")
case "$dv" in
udev) if ! running systemd-udevd; then fail devices "udev was started but is not running now (devices plugged in are not set up): $RUN/udev.log"
	elif [ -z "$(ls "${UDEVDB:-/run/udev/data}" 2>/dev/null | head -1)" ]; then fail devices "udev runs but its device database is empty ($RUN/udev.log)"
	else pass devices "udev: $(ls "${UDEVDB:-/run/udev/data}" | wc -l) devices in its database"; fi;;
*rudolf.udev=0*) skip devices "mdev, as asked at start-up (rudolf.udev=0)";;
mdev*) fail devices "the devices are set up by mdev, the fallback, not udev ${dv#mdev }";;
*) skip devices "not said at start-up ($RUN/devices)";;
esac
# 1.5.9 (plan Part 1): a cellular modem: ModemManager runs while one is there, can read its own rules (it runs without
# udev, /usr/lib/rudolf/modem) and has found it (mmcli only reads); 1.6.0 (Part 5): its driver, SIM, network and data
# connection (ST_MODEM: the modem service for the host test)
md=$(ls "$DEV"/cdc-wdm* "$DEV"/wwan* 2>/dev/null | head -3 | tr '\n' ' ')
if [ -z "$md" ]; then skip modem "no cellular modem"
elif ! running ModemManager; then fail modem "a modem is there (${md% }) but ModemManager is not running ($RUN/modem.log)"
elif grep -q 'Invalid rule match' "$RUN/modem.log" 2>/dev/null; then fail modem "ModemManager could not read its port rules (\"Invalid rule match\" in $RUN/modem.log): it may not see the modem"
else n=$(mmcli -L 2>/dev/null | grep -c '/Modem/')
	if [ "$n" -gt 0 ]; then
		# 1.6.0 (plan Part 5): the first modem, its driver, the SIM, the network, the data connection (modem status)
		J=$(${ST_MODEM:-/usr/lib/rudolf/modem} status 2>/dev/null | tr -d '\n'); jv() { printf '%s' "$J" | sed -n "s/.*\"modems\":\[{[^]]*\"$1\":\"\([^\"]*\)\".*/\1/p" | head -1; }
		if ! printf '%s' "$J" | grep -q '"modems":\[{'; then pass modem "$n modem(s) found by ModemManager"
		else nm="$(jv maker) $(jv model) ($(jv driver))"; st=$(jv state); lk=$(jv locked); fr=$(jv failed); reg=$(jv reg); IFC=$(jv iface)
			if printf '%s' "$J" | grep -q '"sim":false' || [ "$fr" = sim-missing ]; then fail modem "$nm: no SIM card"
			elif [ "$fr" = sim-error ]; then fail modem "$nm: the SIM card is blocked for good or does not work"
			elif [ -n "$lk" ] && [ "$lk" != none ]; then fail modem "$nm: the SIM is locked ($lk): Settings › Mobile network"
			elif [ "$st" != registered ] && [ "$st" != connected ] && [ "$st" != connecting ]; then fail modem "$nm: no network (${st:-?}${reg:+, $reg})"
			elif [ -z "$IFC" ]; then fail modem "$nm: on the network ($(jv operator), $reg) but no data connection: Connect in Settings › Mobile network, or check the APN there"
			else pass modem "$nm: SIM $(jv simName), on $(jv operator) ($reg, $(jv tech), signal $(jv signal) %), connected on $IFC"; fi; fi
	else fail modem "ModemManager runs but has found no modem (${md% }): see $RUN/modem.log"; fi; fi

# 1.6.0 (plan Part 13): the signed system extensions this start laid over the base (/usr/lib/rudolf/sysext): those in
# use, and a failure for each one left out (a clash with the base, built for another base or kernel, its file changed,
# revoked, or left out after a start that never reached the desktop)
XS="$RUN/ext/state"; xh=$(awk -F'\t' '$1=="start"{print $2; exit}' "$XS" 2>/dev/null)
if [ ! -f "$XS" ]; then skip extensions "not laid over at this start (no data partition)"
elif [ "$xh" = "none installed" ]; then skip extensions "none installed"
elif [ "$xh" != "with extensions" ]; then skip extensions "$xh"
else xu=$(awk -F'\t' '$3=="in-use"{printf "%s %s, ", $1, $2}' "$XS"); xl=$(awk -F'\t' '$3=="left-out"{printf "%s %s (%s); ", $1, $2, $4}' "$XS")
	if [ -n "$xl" ]; then fail extensions "left out: ${xl%; }${xu:+; in use: ${xu%, }}"; else pass extensions "in use: ${xu%, }"; fi; fi

# 1.6.0 (plan Part 8): printers plugged in by USB (/usr/lib/rudolf/usbprint): each one found and its kind; an IPP over
# USB one has ipp-usb's address (the USB printers extension) and ipp-usb answers there (rudolf-print info only asks)
UP="$RUN/usb-printers"; RPR=${ST_PRINT:-/usr/bin/rudolf-print}
if [ ! -s "$UP" ]; then skip usb-printer "no USB printer plugged in"
else upl=$(awk -F'\t' '{printf "%s (%s), ", $2, $1}' "$UP"); upb=
	if awk -F'\t' '$1=="ipp" && $3==""' "$UP" | grep -q .; then upb="an IPP over USB printer has no address: the USB printers extension is not installed, or ipp-usb did not start ($RUN/usbprint.log)"
	else for u in $(awk -F'\t' '$1=="ipp"{print $3}' "$UP"); do [ -x "$RPR" ] && ! timeout 10 "$RPR" info "$u" >/dev/null 2>&1 && upb="ipp-usb does not answer at $u ($RUN/ipp-usb.log)"; done; fi
	if [ -n "$upb" ]; then fail usb-printer "$upb; found: ${upl%, }"; else pass usb-printer "${upl%, }"; fi; fi

echo "$NP passed, $NF failed, $NS skipped"
[ $NF = 0 ]
