#!/bin/sh
# Rudolf OS: devices plugged in and out. GPL-2.0-or-later.
#
# mdev (the device manager) runs this for every USB device and every disk or SD card partition it sees
# (/etc/mdev.conf). It works out what the device is, mounts USB drives and SD cards under /media/<name>, and
# tells the desktop through /run/rudolf/events, one line per event:
#   dev {"a":"add","t":"drive","dev":"sdb1","label":"STICK","bytes":16000000000,"fs":"vfat","path":"/media/sdb1","model":"SanDisk Ultra"}
#   dev {"a":"add","t":"usb","kind":"Mouse","name":"Logitech USB Receiver","id":"046d:c52b","driver":1}
# The desktop shows a notification and refreshes File Explorer. Internal disks are not mounted by themselves
# (File Explorer mounts them when opened), so a Windows disk is never touched unless you ask.
#
#   devplug                  from mdev (ACTION, MDEV, SUBSYSTEM, DEVTYPE, DEVPATH in the environment)
#   devplug list             JSON of the connected USB devices, drives and input devices (Settings > Devices)
#   devplug unsupported [json]  1.5.3: every device no driver took (PCI, USB, and known ACPI parts), one a line:
#                            "bus|id|kind|name", or JSON (Settings > Devices > Not supported yet, system reports)
#   devplug hwlog            1.5.3: one "hardware" line in the health log the first time Rudolf OS starts on a computer
#   devplug mount DEV        mount a partition under /media/DEV (File Explorer)
#   devplug eject DISK       unmount every partition of a disk and power it off, so it can be pulled out
#   devplug release DISK     unmount what this script mounted from a disk (under /media), before the disk is written
#                            (1.2.6). While /run/rudolf/busy/DISK exists, nothing on that disk is mounted.
RUN=/run/rudolf
# test hooks (iso/qt/host/devunsup_t.sh): RUDOLF_SYS (a stand-in /sys), RUDOLF_RUN
SYS=${RUDOLF_SYS:-/sys}; [ -n "$RUDOLF_RUN" ] && RUN=$RUDOLF_RUN
mkdir -p $RUN/usb $RUN/drives 2>/dev/null; [ -n "$RUDOLF_SYS" ] || mkdir -p /media 2>/dev/null

clean() { tr -d '"\\\000-\037' | tr -s ' ' | sed 's/^ //; s/ $//' | cut -c1-80; }
event() { echo "dev $1" >> $RUN/events; }
rd() { [ -r "$1" ] && clean < "$1"; }

# ---------------------------------------------------------------- drives
disk_of() { case $1 in mmcblk*p[0-9]*|nvme*p[0-9]*) echo "${1%p[0-9]*}";; sd*) echo "$1" | sed 's/[0-9]*$//';; *) echo "$1";; esac; }

# 1 when the disk is a USB drive, an SD card or otherwise removable (not the computer's own disk)
removable() {
	local d=/sys/block/$1
	[ "$(cat $d/removable 2>/dev/null)" = 1 ] && return 0
	case "$(readlink -f $d/device 2>/dev/null)" in
	*/usb*) return 0;;
	*/mmc*) [ "$(cat $d/device/type 2>/dev/null)" = SD ] && return 0;;   # SD cards, not a laptop's built-in eMMC
	esac
	return 1
}

# Rudolf OS's own disc, stick or data partition
system_disk() {
	local p n b
	for p in /sys/block/$1/$1* /sys/block/$1; do
		n=${p##*/}; [ -e /dev/$n ] || continue
		b=$(blkid /dev/$n 2>/dev/null)
		case "$b" in *LABEL=\"RUDOLFDATA\"*|*TYPE=\"iso9660\"*) return 0;; esac
	done
	grep -q "^/dev/$1" /proc/mounts && ! grep -q "^/dev/$1[^ ]* /media/" /proc/mounts && return 0
	return 1
}

mount_part() {
	local p=$1 mp=/media/$1 fs t
	grep -q "^/dev/$p " /proc/mounts && return 0
	fs=$(blkid /dev/$p 2>/dev/null | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p')
	[ -n "$fs" ] || return 1
	case $fs in swap|crypto_LUKS|LVM2_member|linux_raid_member|BitLocker) return 1;; esac
	t=""; [ "$fs" = ntfs ] && t="-t ntfs3"
	mkdir -p $mp
	mount $t -o rw,nosuid,nodev,noexec /dev/$p $mp 2>/dev/null || mount $t -o ro,nosuid,nodev,noexec /dev/$p $mp 2>/dev/null || { rmdir $mp; return 1; }
	return 0
}

drive_json() {
	local p=$1 d b fs lb sz model ro; d=$(disk_of $p)
	b=$(blkid /dev/$p 2>/dev/null)
	fs=$(echo "$b" | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p')
	lb=$(echo "$b" | sed -n 's/.* LABEL="\([^"]*\)".*/\1/p' | clean)
	sz=$(( $(cat /sys/class/block/$p/size 2>/dev/null || echo 0) * 512 ))
	model=$( (cat /sys/block/$d/device/vendor /sys/block/$d/device/model 2>/dev/null; cat /sys/block/$d/device/name 2>/dev/null) | tr '\n' ' ' | clean)
	ro=$(grep "^/dev/$p " /proc/mounts | awk '{print $4}' | grep -q '^ro' && echo true || echo false)
	printf '{"t":"drive","dev":"%s","label":"%s","bytes":%s,"fs":"%s","path":"/media/%s","model":"%s","readonly":%s}' "$p" "$lb" "$sz" "$fs" "$p" "$model" "$ro"
}

block_add() {
	local p=$MDEV d j; d=$(disk_of $p)
	[ -f $RUN/drives/$p ] && return 0   # already mounted and announced (a "change" event)
	[ -e $RUN/busy/$d ] && return 0     # being written (a stick being made, Install here)
	removable $d || return 0
	system_disk $d && return 0
	# a disk with partitions: its partitions are what gets mounted
	[ "$p" = "$d" ] && ls /sys/block/$d/ 2>/dev/null | grep -q "^$d.*[0-9]$" && return 0
	for i in 1 2 3 4 5 6; do blkid /dev/$p >/dev/null 2>&1 && break; sleep 0.5; done
	[ -e $RUN/busy/$d ] && return 0
	mount_part $p || return 0
	j=$(drive_json $p); echo "$j" > $RUN/drives/$p
	event "{\"a\":\"add\",${j#\{}"
}

block_remove() {
	local p=$MDEV j
	[ -f $RUN/drives/$p ] || return 0
	j=$(cat $RUN/drives/$p); rm -f $RUN/drives/$p
	umount -l /media/$p 2>/dev/null; rmdir /media/$p 2>/dev/null
	event "{\"a\":\"remove\",${j#\{}"
}

# ---------------------------------------------------------------- USB devices
# what a USB device is, from its interface classes: prints "kind|name|vid:pid|driver(0/1)"
usb_identify() {
	local s=$1 vid pid dc cls drv kb ms joy net wl i c sc pr n kind name
	vid=$(cat $s/idVendor 2>/dev/null); pid=$(cat $s/idProduct 2>/dev/null)
	[ -n "$vid" ] || return 1
	dc=$(cat $s/bDeviceClass 2>/dev/null)
	[ "$dc" = 09 ] && return 1                       # hubs
	cls=""; drv=0; kb=0; ms=0; joy=0; net=""; wl=0
	for i in $s/*:*; do
		[ -f $i/bInterfaceClass ] || continue
		c=$(cat $i/bInterfaceClass); sc=$(cat $i/bInterfaceSubClass); pr=$(cat $i/bInterfaceProtocol)
		cls="$cls $c"
		[ -e $i/driver ] && drv=1
		[ "$c" = 03 ] && [ "$pr" = 01 ] && kb=1
		[ "$c" = 03 ] && [ "$pr" = 02 ] && ms=1
		[ "$c" = ff ] && [ "$sc" = 5d ] && joy=1          # Xbox controllers
		ls $i/input/*/ 2>/dev/null | grep -q '^js' && joy=1
		for n in $i/net/*; do [ -e "$n" ] && net=1 && [ -e "$n/wireless" -o -e "$n/phy80211" ] && wl=1; done
	done
	[ -n "$cls" ] || cls=" $dc"
	has() { case " $cls " in *" $1 "*) return 0;; esac; return 1; }
	if has 08; then kind="USB drive"
	elif has 01; then kind="Audio device"
	elif has 0e; then kind="Camera"
	elif [ $joy = 1 ]; then kind="Game controller"
	elif [ $kb = 1 ] && [ $ms = 1 ]; then kind="Keyboard and mouse"
	elif [ $kb = 1 ]; then kind="Keyboard"
	elif [ $ms = 1 ]; then kind="Mouse"
	elif has 03; then kind="Input device"
	elif has 06; then kind="Phone or camera"
	elif has 07; then kind="Printer"
	elif has e0; then kind="Bluetooth adapter"
	elif [ $wl = 1 ]; then kind="Wi-Fi adapter"
	elif [ -n "$net" ] || has 02 || has 0a; then kind="Network adapter"
	elif has 0b; then kind="Smart card reader"
	else
		# 1.5.3: a device that does not say what it is (its own "vendor" class, like most Wi-Fi dongles): by its name
		case "$(rd $s/product | tr A-Z a-z)" in
		*wlan*|*wi-fi*|*wifi*|*802.11*|*"wireless lan"*|*"wireless adapter"*) kind="Wi-Fi adapter";;
		*bluetooth*) kind="Bluetooth adapter";;
		*ethernet*|*" lan"*|*gigabit*) kind="Network adapter";;
		*camera*|*webcam*) kind="Camera";;
		*fingerprint*) kind="Fingerprint reader";;
		*) kind="USB device";;
		esac
	fi
	name=$(printf '%s %s' "$(rd $s/manufacturer)" "$(rd $s/product)" | clean)
	[ -n "$name" ] || name="$kind ($vid:$pid)"
	echo "$kind|$name|$vid:$pid|$drv|$(usb_speeds $s)"
}
# 1.5.3: the speed a USB device runs at, and the fastest its port can (its own hub, or the SuperSpeed hub its port is
# paired with), in Mbit/s: "480 10000" is a USB 2 device in a USB 3 port
usb_speeds() {
	local s=$1 sp p q h ps=0
	sp=$(cat $s/speed 2>/dev/null); sp=${sp%%.*}
	p=$(readlink -f $s/port 2>/dev/null)
	for q in "$p" "$(readlink -f "$p/peer" 2>/dev/null)"; do
		[ -n "$q" ] && [ -d "$q" ] || continue
		h=$(cat "$(dirname "$(dirname "$q")")/speed" 2>/dev/null); h=${h%%.*}
		[ "${h:-0}" -gt "$ps" ] && ps=$h
	done
	echo "${sp:-0}|$ps"
}

usb_json() { IFS='|' read -r kind name id drv sp ps; printf '{"t":"usb","kind":"%s","name":"%s","id":"%s","driver":%s,"speed":%s,"port":%s}' "$kind" "$name" "$id" "$( [ "$drv" = 1 ] && echo 1 || echo 0)" "${sp:-0}" "${ps:-0}"; }

# ---------------------------------------------------------------- devices without a driver (1.5.3)
# Makers of the parts a laptop has, so the list says more than numbers (the rest show their PCI or USB ID)
maker() {
	case $1 in
	8086|8087) echo Intel;; 1022|1002) echo AMD;; 10ec|0bda) echo Realtek;; 14c3|0e8d) echo MediaTek;; 168c|17cb|0cf3) echo Qualcomm;;
	10de) echo NVIDIA;; 14e4|0a5c) echo Broadcom;; 1814|148f) echo Ralink;; 1b21) echo ASMedia;; 1217) echo O2Micro;; 1180) echo Ricoh;;
	144d) echo Samsung;; 15b7) echo "Western Digital";; 1c5c) echo "SK hynix";; 1344) echo Micron;; 126f) echo "Silicon Motion";;
	06cb) echo Synaptics;; 27c6) echo Goodix;; 04f3) echo Elan;; 138a) echo Validity;; 2808) echo FocalTech;; 1c7a) echo LighTuning;;
	esac
}
# a PCI device's kind, from its class (and, for multimedia, its maker); nothing for parts that need no driver
pci_kind() {
	local c=$1 v=$2
	case $c in
	0600*|0601*|0604*|0680*|05*|0b*|0c05*|1180*|1080*|0806*|0880*|ff*) ;;   # bridges, memory, processor, SMBus, sensors, crypto, IOMMU
	0280*) echo "Wi-Fi adapter";;
	0d11*) echo "Bluetooth adapter";;
	02*) echo "Network adapter";;
	0401*|0403*) echo "Sound card";;
	0480*) [ "$v" = 1022 ] && echo "Sound processor" || echo "Camera or sound processor";;
	04*) echo "Multimedia device";;
	03*) echo "Graphics card";;
	0c0340) echo "USB4 controller";;
	0c03*) echo "USB controller";;
	0c0a*) echo "Thunderbolt controller";;
	01*) echo "Storage controller";;
	0805*) echo "SD card reader";;
	1200*) echo "AI processor (NPU)";;
	0780*|0700*) echo "Communication device";;
	*) echo "Device";;
	esac
}
# parts behind ACPI (I2C and SPI) that a laptop needs for sound, cameras and touchpads: by their ACPI ID
acpi_kind() {
	case $1 in
	CSC3551|CSC3554|CSC3556) echo "Speaker amplifier|Cirrus";; TIAS2781|TXNW2781) echo "Speaker amplifier|TI";;
	INT3472) echo "Camera power control|Intel";; OVTI*) echo "Camera sensor|OmniVision";; HIMX*) echo "Camera sensor|Himax";;
	PNP0C50|ACPI0C50) echo "Touchpad or touchscreen (I2C)|";;
	OBDA8723|OBDA8C21|BCM2E*|INT33E1|QCOM6390) echo "Bluetooth adapter (UART)|";;   # 1.5.4: Bluetooth on the board's serial line
	esac
}
unsupported() {
	local d c v i kind id h a n
	for d in $SYS/bus/pci/devices/*; do
		# 1.5.4: Intel's camera processor (IPU6, IPU7) has its driver, but apps cannot use the camera yet: that needs
		# libcamera, which comes later. Listed, so it is clear why the built-in camera does not show up.
		case "$(readlink $d/driver 2>/dev/null)" in */intel-ipu6|*/intel_ipu6|*/intel-ipu7|*/intel_ipu7)
			i=$(cat $d/device); echo "pci|8086:${i#0x}|Camera|Intel built-in camera (IPU): driver ready, apps cannot use it yet"; continue;; esac
		[ -f $d/class ] && [ ! -e $d/driver ] || continue
		c=$(cat $d/class); c=${c#0x}; v=$(cat $d/vendor); v=${v#0x}; i=$(cat $d/device); i=${i#0x}
		kind=$(pci_kind $c $v); [ -n "$kind" ] || continue
		n=$(maker $v); echo "pci|$v:$i|$kind|${n:+$n }$kind"
	done
	for d in $SYS/bus/usb/devices/*; do
		[ -f $d/idVendor ] || continue
		case ${d##*/} in usb*) continue;; esac
		i=$(usb_identify $d) || continue
		[ "$(echo "$i" | cut -d'|' -f4)" = 1 ] && continue
		echo "usb|$(echo "$i" | cut -d'|' -f3)|$(echo "$i" | cut -d'|' -f1)|$(echo "$i" | cut -d'|' -f2)"
	done
	for d in $SYS/bus/acpi/devices/*; do
		h=${d##*/}; h=${h%%:*}; a=$(acpi_kind $h); [ -n "$a" ] || continue
		[ -f $d/status ] && [ "$(cat $d/status)" = 0 ] && continue   # described by the firmware, but not there
		n=0; for p in $d/physical_node*; do [ -e "$p/driver" ] && n=1; done
		[ $n = 1 ] && continue
		kind=${a%%|*}; v=${a#*|}; echo "acpi|$h|$kind|${v:+$v }$kind"
	done
}

# 1.5.8 (plan 7.2): an Android phone with USB debugging on (an ADB interface: class ff, subclass 42, protocol 01) is the
# desktop user's to use, so scrcpy and adb in Linux (Debian) can reach it; nothing else on the phone changes
adb_perm() {
	local s=$1 i n
	for i in $s/*:*; do [ "$(cat $i/bInterfaceClass 2>/dev/null)$(cat $i/bInterfaceSubClass 2>/dev/null)$(cat $i/bInterfaceProtocol 2>/dev/null)" = ff4201 ] || continue
		n=$(sed -n 's/^DEVNAME=//p' $s/uevent 2>/dev/null); [ -n "$n" ] && [ -c "${RUDOLF_DEV:-/dev}/$n" ] && chgrp 1000 "${RUDOLF_DEV:-/dev}/$n" && chmod 660 "${RUDOLF_DEV:-/dev}/$n"; return 0; done
}
usb_add() {
	local s=/sys$DEVPATH key info j; key=$(echo "$DEVPATH" | tr '/' '_')
	sleep 2   # the device's interfaces and drivers appear after the device itself
	adb_perm $s
	info=$(usb_identify $s) || return 0
	echo "$info" > $RUN/usb/$key
	case "$info" in "USB drive|"*) return 0;; esac   # the drive's own events say more
	j=$(echo "$info" | usb_json); event "{\"a\":\"add\",${j#\{}"
}

usb_remove() {
	local key info j
	key=$(echo "$DEVPATH" | tr '/' '_')
	[ -f $RUN/usb/$key ] || return 0
	info=$(cat $RUN/usb/$key); rm -f $RUN/usb/$key
	case "$info" in "USB drive|"*) return 0;; esac
	j=$(echo "$info" | usb_json); event "{\"a\":\"remove\",${j#\{}"
}

# ---------------------------------------------------------------- commands
case "$1" in
unsupported)
	if [ "$2" = json ]; then
		printf '{"ok":true,"devices":['; f=1
		unsupported | while IFS='|' read -r b id k n; do [ $f = 1 ] || printf ','; f=0; printf '{"bus":"%s","id":"%s","kind":"%s","name":"%s"}' "$b" "$(echo "$id" | clean)" "$k" "$(echo "$n" | clean)"; done
		printf ']}\n'
	else unsupported; fi
	exit 0;;
hwlog)
	# once per computer (its model, as the firmware names it): what it has that Rudolf OS cannot use yet
	M=$(printf '%s %s' "$(rd $SYS/class/dmi/id/sys_vendor)" "$(rd $SYS/class/dmi/id/product_name)" | clean)
	F=/persist/etc/hardware-logged; [ -n "$RUDOLF_RUN" ] && F=$RUN/hardware-logged
	[ -d "$(dirname $F)" ] || exit 0
	[ "$(cat $F 2>/dev/null)" = "$M" ] && exit 0
	L=$(unsupported | awk -F'|' '{printf "%s%s (%s %s)", (NR>1?", ":""), (index($4,$3)?$4:$4", "$3), $1, $2}')
	if [ -n "$L" ]; then T="$M: no driver yet for $(unsupported | wc -l) device(s): $L"; else T="$M: every device has a driver"; fi
	${RUDOLF_HEALTH:-rudolfd --health} hardware "$(echo "$T" | cut -c1-400)" && echo "$M" > $F
	exit 0;;
list)
	printf '{"ok":true,"usb":['; f=1
	for s in $SYS/bus/usb/devices/*; do
		[ -f $s/idVendor ] || continue
		case ${s##*/} in usb*) continue;; esac
		info=$(usb_identify $s) || continue
		[ $f = 1 ] || printf ','; f=0; echo "$info" | usb_json
	done
	printf '],"drives":['; f=1
	for j in $RUN/drives/*; do [ -f "$j" ] || continue; [ $f = 1 ] || printf ','; f=0; cat "$j" | tr -d '\n'; done
	printf '],"inputs":['; f=1
	[ -f $RUN/inputs ] && while IFS='|' read -r k n; do [ $f = 1 ] || printf ','; f=0; printf '{"kind":"%s","name":"%s"}' "$k" "$(echo "$n" | clean)"; done < $RUN/inputs
	printf ']}\n'
	exit 0;;
mount)
	p=$2; case "$p" in ""|*[!a-z0-9]*) echo "bad device" >&2; exit 2;; esac
	mount_part $p || { echo "could not mount $p" >&2; exit 1; }
	j=$(drive_json $p); echo "$j" > $RUN/drives/$p; exit 0;;
eject)
	d=$2; case "$d" in ""|*[!a-z0-9]*) echo "bad device" >&2; exit 2;; esac
	system_disk $d && { echo "this is Rudolf OS's own disk" >&2; exit 1; }
	sync
	for m in $(grep "^/dev/$d" /proc/mounts | awk '{print $2}'); do umount "$m" 2>/dev/null || { echo "a file on the drive is still open" >&2; exit 1; }; rmdir "$m" 2>/dev/null; done
	for j in $RUN/drives/$d*; do [ -f "$j" ] || continue; p=${j##*/}; event "{\"a\":\"eject\",$(cut -c2- $j)"; rm -f "$j"; done
	[ -w /sys/block/$d/device/delete ] && echo 1 > /sys/block/$d/device/delete
	exit 0;;
release)
	# no refusal of Rudolf OS disks here (1.2.7): an older Rudolf OS stick is one, and this only ever unmounts what
	# devplug mounted under /media (never a Rudolf OS disk). The drive Rudolf OS runs from is refused by the callers.
	d=$2; case "$d" in ""|*[!a-z0-9]*) echo "bad device" >&2; exit 2;; esac
	sync
	for m in $(grep -E "^/dev/${d}p?[0-9]* /media/" /proc/mounts | awk '{print $2}'); do umount "$m" 2>/dev/null || { echo "a file on the drive is still open" >&2; exit 1; }; rmdir "$m" 2>/dev/null; done
	for j in $RUN/drives/$d*; do [ -f "$j" ] || continue; event "{\"a\":\"remove\",$(cut -c2- $j)"; rm -f "$j"; done
	exit 0;;
esac

# from mdev
[ -n "$MDEV$DEVPATH" ] || exit 0
case "$SUBSYSTEM" in
block)
	case "$ACTION" in remove) block_remove;; add|change) ( block_add ) & ;; esac;;
usb)
	[ "$DEVTYPE" = usb_device ] || exit 0
	# devices already there at start-up are recorded but not announced (the desktop also ignores events from before it started)
	case "$ACTION" in remove) usb_remove;; add) ( usb_add ) & ;; esac;;
esac
exit 0
