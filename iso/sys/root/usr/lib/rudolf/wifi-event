#!/bin/sh
# Called by wpa_cli -a when Wi-Fi joins or leaves a network: get an address by DHCP, or drop it.
#   wifi-event IF CONNECTED|DISCONNECTED [now]     (WPA_ID: the network's id, from wpa_cli)   GPL-2.0-or-later.
# 1.5.6: a short drop keeps the address. On the Vivobook the router's 2.4 and 5 GHz radios (the same network) took
# turns, a few seconds apart, and each change dropped the address and asked DHCP again from scratch, breaking every
# open connection. Now a drop waits GRACE seconds (10) before the address goes; joining the same network again within
# them renews the lease it has (udhcpc's SIGUSR1) instead of starting over; another network starts over.
# And a network set aside is taken back: on 2026111014 the move to the 2.4 GHz radio failed (it did not answer), and
# wpa_supplicant set the whole network aside after its failures (TEMP-DISABLED, longer each time), 5 GHz radio
# included: 5.5 minutes off the network. Still off after the grace, and the network set aside, it is chosen again
# (select_network clears that; the radio that failed stays on wpa_supplicant's own ignore list, longer each time it
# fails), every RETRY seconds (15), up to 4 times.
export PATH=${WIFI_EVENT_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}
R=${WIFI_EVENT_RUN:-/run/rudolf}
IF=$1; P=$R/udhcpc-$IF.pid; D=$R/wifi-drop-$IF; N=$R/wifi-net-$IF; GRACE=${WIFI_EVENT_GRACE:-10}; RETRY=${WIFI_EVENT_RETRY:-15}
W() { wpa_cli -p ${WIFI_EVENT_CTRL:-/run/rudolf/wpa} -i "$IF" "$@"; }
# the network was set aside by wpa_supplicant (and we are still off): choose it again, the others enabled as before
# (or wpa_supplicant has stopped trying: DISCONNECTED or INACTIVE rather than SCANNING or joining)
recover() { [ -n "$1" ] || return 1; ST=$(W status 2>/dev/null | sed -n 's/^wpa_state=//p'); [ "$ST" = COMPLETED ] && return 1
	W list_networks 2>/dev/null | awk -F'\t' -v id="$1" '$1==id' | grep -q 'TEMP-DISABLED' || case "$ST" in DISCONNECTED|INACTIVE) ;; *) return 1;; esac
	W select_network "$1" >/dev/null 2>&1; W enable_network all >/dev/null 2>&1
	echo "$(date) wifi: network $1 was set aside after failures; chosen again" >> $R/wifi.log; return 0; }
# 1.5.6: a radio that did not answer stays out for the rest of the session. On 2026111016 the router's 2.4 GHz radio
# never accepted the Vivobook, and wpa_supplicant tried it twice in 25 minutes (1.3 s and 5.6 s off the network: a
# game disconnected); its own ignore list forgets after 10 s at first. On joining, the radios on that list (other
# than the one joined) go into the network's own bssid_ignore, for this session only (SI, never saved: wifi.sh
# leaves them out of save_config). Off the network for longer than the grace, they are let in again: maybe only that
# radio reaches here.
SI=$R/wifi-ignore-$IF
# 1.5.9: two more sources, and kept across restarts. On 2026111302 (2026-11-13) the Vivobook left the router's 5 GHz
# radio (-53 dBm) for its 2.4 GHz one, which again did not answer, and was off the network for 45 s; it had not been
# left out, as wpa_supplicant's own list had forgotten it (after 10 s at first) by the time the Wi-Fi was back. So the
# kernel's own messages ("authentication with X timed out") count too, and a radio that did not answer stays out for
# a day (PI: SSID in hex, the radio, when), restarts included. If the network is then reached through that radio after
# all, it is taken off the list.
PI=${WIFI_EVENT_PERSIST:-/persist/etc/wifi-ignore}; DAY=86400
# (1.5.9: and the radios turned off by hand: Settings › Network › Wi-Fi › Radios; never forgotten, never let in again)
OFF=${WIFI_EVENT_OFF:-/persist/etc/wifi-radios-off}
hexs() { printf %s "$1" | od -An -tx1 | tr -d ' \n'; }
session_ignore() { [ -n "$1" ] || return 0; ST=$(W status 2>/dev/null); CUR=$(echo "$ST" | sed -n 's/^bssid=//p'); SS=$(echo "$ST" | sed -n 's/^ssid=//p')
	H=$(hexs "$SS"); [ -n "$H" ] && echo "$H" > $R/wifi-ssid-$IF; NOW=$(date +%s); L=$(grep "^$1 " $SI 2>/dev/null | cut -d' ' -f2); NEW=
	# kept from earlier (a day), this network's; the radio in use now is not left out (and is dropped from the list)
	if [ -n "$H" ] && [ -f "$PI" ]; then
		awk -v h="$H" -v c="$CUR" -v now="$NOW" -v d=$DAY '!($1==h && (tolower($2)==tolower(c) || now-$3>=d))' "$PI" > "$PI.n" 2>/dev/null && mv "$PI.n" "$PI"
		for b in $(awk -v h="$H" '$1==h{print $2}' "$PI"); do echo "$L" | grep -qix "$b" || L="$L $b"; done; fi
	[ -n "$H" ] && for b in $(awk -v h="$H" '$1==h{print $2}' "$OFF" 2>/dev/null); do echo "$L" | grep -qix "$b" || L="$L $b"; done
	for b in $( { W bssid_ignore 2>/dev/null; dmesg 2>/dev/null | sed -n 's/.*\(authentication\|association\) with \(\([0-9a-f]\{2\}:\)\{5\}[0-9a-f]\{2\}\) timed out.*/\2/p'; } | grep -Eio '([0-9a-f]{2}:){5}[0-9a-f]{2}' | sort -u); do
		[ "$b" = "$CUR" ] && continue
		echo "$L" | grep -qix "$b" || { L="$L $b"; NEW="$NEW $b"; }
		[ -n "$H" ] && ! grep -qi "^$H $b " "$PI" 2>/dev/null && echo "$H $b $NOW" >> "$PI"; done
	L=$(echo $L); [ -n "$L" ] || return 0
	[ "$(W get_network "$1" bssid_ignore 2>/dev/null)" = "$L" ] && return 0
	if W set_network "$1" bssid_ignore "$L" 2>/dev/null | grep -q OK; then
		{ grep -v "^$1 " $SI 2>/dev/null; for b in $L; do echo "$1 $b"; done; } > $SI.n; mv $SI.n $SI
		echo "$(date) wifi: network $1: left out (did not answer):$( [ -n "$NEW" ] && echo "$NEW" || echo " $L (kept from earlier)")" >> $R/wifi.log
	else echo "$(date) wifi: network $1: could not leave out$NEW" >> $R/wifi.log; fi; }
session_unignore() { [ -n "$1" ] && grep -q "^$1 " $SI 2>/dev/null || return 0
	# (1.5.9: those turned off by hand stay off)
	H=$(hexs "$(W status 2>/dev/null | sed -n 's/^ssid=//p')"); [ -n "$H" ] || H=$(cat $R/wifi-ssid-$IF 2>/dev/null)
	KO=$(awk -v h="$H" '$1==h{print $2}' "$OFF" 2>/dev/null | tr '\n' ' ')
	W set_network "$1" bssid_ignore "${KO% }" >/dev/null 2>&1
	grep -v "^$1 " $SI > $SI.n; mv $SI.n $SI; echo "$(date) wifi: network $1: every radio allowed again (off the network)" >> $R/wifi.log; }
stop() { [ -f $P ] && kill "$(cat $P)" 2>/dev/null; rm -f $P; }
running() { [ -f $P ] && kill -0 "$(cat $P)" 2>/dev/null; }
case "$2" in
CONNECTED)
	rm -f $D
	if running && [ -n "$WPA_ID" ] && [ "$(cat $N 2>/dev/null)" = "$WPA_ID" ] && ip -4 -o addr show dev "$IF" | grep -q inet; then
		kill -USR1 "$(cat $P)" 2>/dev/null   # the same network: renew the address it has
	else
		stop
		udhcpc -b -i "$IF" -t 6 -T 2 -A 5 -O 43 -p $P -s /usr/lib/rudolf/udhcpc.sh >/dev/null 2>&1
	fi
	echo "${WPA_ID:-}" > $N
	session_ignore "${WPA_ID:-}"
	echo "wifi connected" >> $R/events ;;
DISCONNECTED)
	# switching adapters (wifi.sh: "now"): at once
	if [ "$3" = now ]; then rm -f $D $N; stop; ip addr flush dev "$IF" 2>/dev/null; echo "wifi disconnected" >> $R/events; exit 0; fi
	# the address goes only if the Wi-Fi is still off the network GRACE seconds later
	T="$(date +%s).$$"; echo $T > $D
	ID=$(cat $N 2>/dev/null)
	( sleep $GRACE; [ "$(cat $D 2>/dev/null)" = "$T" ] || exit 0
	  rm -f $N; stop; ip addr flush dev "$IF" 2>/dev/null; echo "wifi disconnected" >> $R/events; session_unignore "$ID"
	  for i in 1 2 3 4; do [ "$(cat $D 2>/dev/null)" = "$T" ] || exit 0; recover "$ID"; sleep $RETRY; done; rm -f $D ) </dev/null >/dev/null 2>&1 &
	;;
esac
exit 0
