#!/bin/sh
# Rudolf OS 1.5.1: Bluetooth (BlueZ). Controllers, keyboards, mice and headphones.
#   bluetooth boot              at start-up: wait up to 20 s for an adapter, then start unless it was turned off
#   bluetooth start | stop      the system D-Bus (BlueZ needs it), bluetoothd and bluealsa (headphones)
#   bluetooth on | off          the adapter's power, remembered (/persist/etc/bluetooth-off)
#   bluetooth status            JSON: adapter, powered, discovering, devices (paired, connected, kind, battery)
#   bluetooth scan SECONDS      look for devices nearby (the laptop is visible to others only meanwhile)
#   bluetooth pair MAC | connect MAC | disconnect MAC | remove MAC
#   bluetooth audio             (after a connect or a disconnect) headphones as a PulseAudio output, or not
# Pairing uses the "no input, no output" agent: controllers, mice, headphones and most keyboards pair with a press of
# their pairing button; nothing is typed. Pairings are kept in /persist/bluetooth. GPL-2.0-or-later.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/libexec/bluetooth
OFF=/persist/etc/bluetooth-off
BD=$(command -v bluetoothd || echo /usr/libexec/bluetooth/bluetoothd)
BC="bluetoothctl"
BUS=/run/dbus/system_bus_socket
export DBUS_SYSTEM_BUS_ADDRESS=unix:path=$BUS
mac_ok() { echo "$1" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; }
adapter() { ls /sys/class/bluetooth 2>/dev/null | grep -E '^hci[0-9]+$' | head -1; }
bc() { timeout "${T:-10}" $BC "$@" 2>&1; }

start() {
	[ -x "$BD" ] || { echo "BlueZ is missing"; return 1; }
	mkdir -p /run/dbus
	if [ ! -S $BUS ] || ! pgrep -f '[d]bus-daemon --config-file=/etc/rudolf/dbus-system.conf' >/dev/null; then
		rm -f $BUS; dbus-daemon --config-file=/etc/rudolf/dbus-system.conf --fork --nopidfile
		for i in $(seq 30); do [ -S $BUS ] && break; sleep 0.1; done
	fi
	if [ -d /persist ] && [ -w /persist ]; then mkdir -p /persist/bluetooth; chmod 700 /persist/bluetooth
		mountpoint -q /var/lib/bluetooth || { mkdir -p /var/lib/bluetooth; mount --bind /persist/bluetooth /var/lib/bluetooth; }
	else mkdir -p /var/lib/bluetooth; fi
	for r in /sys/class/rfkill/*; do [ "$(cat $r/type 2>/dev/null)" = bluetooth ] && echo 0 > $r/soft 2>/dev/null; done
	pgrep -x bluetoothd >/dev/null || (setsid sh -c "while [ ! -e /run/rudolf/bluetooth-stop ]; do $BD -n -f /etc/bluetooth/main.conf >>/run/rudolf/bluetooth.log 2>&1; sleep 2; done" </dev/null >/dev/null 2>&1 &)
	B=$(command -v bluealsa || command -v bluealsad)
	# headphones: bluealsa's ALSA device for PulseAudio
	for c in /usr/share/alsa/alsa.conf.d/*bluealsa*.conf; do [ -f "$c" ] && mkdir -p /etc/alsa/conf.d && ln -sf "$c" /etc/alsa/conf.d/ 2>/dev/null; done
	[ -n "$B" ] && ! pgrep -x "${B##*/}" >/dev/null && (setsid sh -c "while [ ! -e /run/rudolf/bluetooth-stop ]; do $B -p a2dp-source >>/run/rudolf/bluealsa.log 2>&1; sleep 2; done" </dev/null >/dev/null 2>&1 &)
	rm -f /run/rudolf/bluetooth-stop
	for i in $(seq 50); do T=3 bc show | grep -q 'Controller' && break; sleep 0.2; done
	[ -f $OFF ] && T=5 bc power off >/dev/null || T=5 bc power on >/dev/null
	return 0
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037')"; }
status() {
	A=$(adapter)
	if [ -z "$A" ]; then echo '{"ok":true,"adapter":null,"running":false,"devices":[]}'; return; fi
	if ! pgrep -x bluetoothd >/dev/null; then printf '{"ok":true,"adapter":"%s","running":false,"powered":false,"devices":[]}\n' "$A"; return; fi
	S=$(T=4 bc show)
	PW=$(echo "$S" | grep -q 'Powered: yes' && echo true || echo false); DI=$(echo "$S" | grep -q 'Discovering: yes' && echo true || echo false)
	printf '{"ok":true,"adapter":"%s","running":true,"powered":%s,"discovering":%s,"name":%s,"devices":[' "$A" $PW $DI "$(json_str "$(echo "$S" | sed -n 's/^\s*Alias: //p' | head -1)")"
	n=0
	for M in $(T=4 bc devices | sed -n 's/^Device \([0-9A-F:]\{17\}\) .*/\1/p'); do
		I=$(T=4 bc info $M)
		nm=$(echo "$I" | sed -n 's/^\s*Alias: //p' | head -1); ic=$(echo "$I" | sed -n 's/^\s*Icon: //p' | head -1)
		pa=$(echo "$I" | grep -q 'Paired: yes' && echo true || echo false); co=$(echo "$I" | grep -q 'Connected: yes' && echo true || echo false)
		tr_=$(echo "$I" | grep -q 'Trusted: yes' && echo true || echo false)
		bat=$(echo "$I" | sed -n 's/.*Battery Percentage: 0x[0-9a-f]* (\([0-9]*\)).*/\1/p' | head -1)
		au=$(echo "$I" | grep -qi 'Audio Sink' && echo true || echo false)
		rs=$(echo "$I" | sed -n 's/^\s*RSSI: .*(\(-\?[0-9]*\))/\1/p;s/^\s*RSSI: \(-\?[0-9]*\)$/\1/p' | head -1)
		[ $n -gt 0 ] && printf ','; n=$((n+1))
		printf '{"mac":"%s","name":%s,"icon":%s,"paired":%s,"trusted":%s,"connected":%s,"audio":%s,"battery":%s,"rssi":%s}' "$M" "$(json_str "$nm")" "$(json_str "$ic")" $pa $tr_ $co $au "${bat:-null}" "${rs:-null}"
	done
	printf ']}\n'
}

# headphones: a PulseAudio output for each connected audio device (bluealsa's ALSA plug-in), removed when it goes
audio() {
	SOCK=/run/user/1000/pulse/native; [ -S $SOCK ] || return 0
	asuser() { su -s /bin/sh rudolf -c "XDG_RUNTIME_DIR=/run/user/1000 PULSE_SERVER=unix:$SOCK DBUS_SYSTEM_BUS_ADDRESS=$DBUS_SYSTEM_BUS_ADDRESS $1"; }
	CON=""
	for M in $(T=4 bc devices Connected 2>/dev/null | sed -n 's/^Device \([0-9A-F:]\{17\}\) .*/\1/p'); do
		T=4 bc info $M | grep -qi 'Audio Sink' && CON="$CON $M"
	done
	MODS=$(asuser "pactl list short modules" 2>/dev/null)
	# remove the outputs of devices no longer connected
	echo "$MODS" | awk '/module-alsa-sink/ && /sink_name=bt_/ {print $1, $0}' | while read id rest; do
		m=$(echo "$rest" | sed -n 's/.*sink_name=bt_\([0-9A-F_]*\).*/\1/p' | tr _ :)
		echo "$CON" | grep -q "$m" || asuser "pactl unload-module $id" >/dev/null 2>&1
	done
	for M in $CON; do
		n=$(echo $M | tr : _)
		echo "$MODS" | grep -q "sink_name=bt_$n" && continue
		NAME=$(T=4 bc info $M | sed -n 's/^\s*Alias: //p' | head -1 | tr -cd 'A-Za-z0-9 ._-')
		asuser "pactl load-module module-alsa-sink device=bluealsa:DEV=$M,PROFILE=a2dp sink_name=bt_$n tsched=0 sink_properties=device.description=\"${NAME:-Bluetooth}\"" >/dev/null 2>&1 \
			&& asuser "pactl set-default-sink bt_$n" >/dev/null 2>&1 && echo "headphones: $NAME"
	done
}

case "$1" in
boot)
	for i in $(seq 40); do [ -n "$(adapter)" ] && break; sleep 0.5; done
	[ -n "$(adapter)" ] || exit 0
	start;;
start) start;;
stop) : > /run/rudolf/bluetooth-stop; T=5 bc power off >/dev/null; pkill -x bluetoothd; pkill -x bluealsa; pkill -x bluealsad; exit 0;;
on) rm -f $OFF; pgrep -x bluetoothd >/dev/null || start; T=5 bc power on;;
off) mkdir -p /persist/etc 2>/dev/null; : > $OFF; T=5 bc power off;;
status) status;;
scan)
	S=${2:-15}; case "$S" in ''|*[!0-9]*) S=15;; esac; [ $S -gt 60 ] && S=60
	T=$((S + 3)) bc --timeout $S scan on >/dev/null; echo scanned;;
pair)
	mac_ok "$2" || { echo "bad device"; exit 2; }
	T=40 bc --agent NoInputNoOutput pair $2 | tail -3; R=$?
	T=8 bc trust $2 >/dev/null
	T=20 bc connect $2 | tail -1
	audio;;
connect) mac_ok "$2" || exit 2; T=20 bc connect $2 | tail -1; audio;;
disconnect) mac_ok "$2" || exit 2; T=10 bc disconnect $2 | tail -1; audio;;
remove) mac_ok "$2" || exit 2; T=10 bc remove $2 | tail -1; audio;;
audio) audio;;
*) echo "usage: bluetooth boot|start|stop|on|off|status|scan [S]|pair MAC|connect MAC|disconnect MAC|remove MAC|audio" >&2; exit 2;;
esac
