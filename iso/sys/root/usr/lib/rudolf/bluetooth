#!/bin/sh
# Rudolf OS 1.5.1: Bluetooth (BlueZ). Controllers, keyboards, mice and headphones.
#   bluetooth boot              at start-up: wait up to 20 s for an adapter, then start unless it was turned off
#   bluetooth start | stop      the system D-Bus (BlueZ needs it), bluetoothd and bluealsa (headphones)
#   bluetooth on | off          the adapter's power, remembered (/persist/etc/bluetooth-off)
#   bluetooth status            JSON: adapter, powered, discovering, devices (paired, connected, kind, battery)
#   bluetooth scan SECONDS      look for devices nearby (and let them find this computer: see visible)
#   bluetooth visible           let phones and other computers find this one for 3 minutes (main.conf's DiscoverableTimeout)
#   bluetooth pair MAC | connect MAC | disconnect MAC | remove MAC
#   bluetooth audio             (after a connect or a disconnect) headphones as a PulseAudio output, or not; a
#                               headset's microphone too (1.5.9)
#   bluetooth answer yes|no     the answer to the pairing question in /run/rudolf/bt-ask (Settings asks it)
#   bluetooth agent-run         (started by start) the pairing agent: one bluetoothctl that stays
# Pairing: an agent that stays registered as BlueZ's default (KeyboardDisplay), so a pairing finishes and is kept
# whichever side starts it. (1.5.1 first paired with a one-off "bluetoothctl --agent NoInputNoOutput pair": the
# pairing went through but BlueZ was told not to keep its key, so it was gone after a restart, and a phone that asked
# to compare codes never got an answer.) Controllers, mice and headphones still pair with a press of their pairing
# button. A phone shows a 6-digit code: the agent puts it in /run/rudolf/bt-ask and Settings asks whether the
# phone shows the same; an unanswered question is answered no after 30 s. A keyboard that needs a code typed on it
# gets one shown the same way. Pairings are kept in /persist/bluetooth. GPL-2.0-or-later.
export PATH=${RUDOLF_TEST_PATH:+$RUDOLF_TEST_PATH:}/usr/sbin:/usr/bin:/sbin:/bin:/usr/libexec/bluetooth
OFF=/persist/etc/bluetooth-off
BD=$(command -v bluetoothd || echo /usr/libexec/bluetooth/bluetoothd)
BC="${RUDOLF_BLUETOOTHCTL:-bluetoothctl}"   # (the host test points these at stand-ins)
BUS=${RUDOLF_BT_BUS:-/run/dbus/system_bus_socket}
export DBUS_SYSTEM_BUS_ADDRESS=unix:path=$BUS
# (busybox's pgrep matches the name a program was started with: bluetoothd is started by its full path, so it never
# matched, Bluetooth always looked stopped, and every check started another restart loop. pidof matches the program.)
up() { pidof "$1" >/dev/null 2>&1; }
mac_ok() { echo "$1" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; }
adapter() { ls ${RUDOLF_BT_SYSFS:-/sys/class/bluetooth} 2>/dev/null | grep -E '^hci[0-9]+$' | head -1; }
bc() { timeout "${T:-10}" $BC "$@" 2>&1; }
SELF=$(readlink -f "$0")
R=${RUDOLF_RUN:-/run/rudolf}
AGIN=$R/bt-agent.in AGOUT=$R/bt-agent.out ASK=$R/bt-ask RES=$R/bt-result PW=$R/bt-pairing
agent_up() { [ -e $R/btagent.pid ] && kill -0 "$(cat $R/btagent.pid)" 2>/dev/null && [ -p $AGIN ]; }
# a line to the agent (never blocks: the agent keeps its own end of the pipe open)
to_agent() { agent_up && timeout 2 sh -c "printf '%s\\n' \"\$1\" > $AGIN" sh "$1"; }
# within two minutes of a pairing someone asked for (Pair in Settings, or a Yes to a phone)
pairwin() { [ -f $PW ] && [ $(( $(date +%s) - $(stat -c %Y $PW) )) -lt 120 ]; }
bonded() { I=$(T=4 bc info $1); echo "$I" | grep -q 'Bonded:' && { echo "$I" | grep -q 'Bonded: yes'; return; }; echo "$I" | grep -q 'Paired: yes'; }
# the device a pairing question is about: connected and not yet bonded
asking_dev() { for M in $(T=4 bc devices Connected | sed -n 's/^Device \([0-9A-F:]\{17\}\) .*/\1/p'); do bonded $M || { echo $M; return; }; done; }
ask() {   # KIND CODE: the question for Settings, answered no after 30 s
	t=$(date +%s); M=$(asking_dev); N=; [ -n "$M" ] && N=$(T=4 bc info $M | sed -n 's/^\s*Alias: //p' | head -1)
	printf '{"kind":"%s","code":"%s","mac":"%s","name":%s,"t":%s}\n' "$1" "$2" "$M" "$(json_str "$N")" $t > $ASK.tmp && mv $ASK.tmp $ASK
	[ "$1" = keyboard ] && return
	(sleep 30; [ -f $ASK ] && grep -q "\"t\":$t}" $ASK && "$SELF" answer no) </dev/null >/dev/null 2>&1 &
}
answer() {
	[ -f $ASK ] || { echo "nothing to answer"; return 1; }
	rm -f $ASK; to_agent "$1" || return 1
	[ "$1" = yes ] || return 0
	touch $PW
	# a pairing the other side started: trust the device once it is bonded, so it can connect again by itself
	(sleep 12; for M in $(T=4 bc devices Bonded | sed -n 's/^Device \([0-9A-F:]\{17\}\) .*/\1/p'); do T=4 bc info $M | grep -q 'Trusted: yes' || T=5 bc trust $M >/dev/null; done) </dev/null >/dev/null 2>&1 &
}
# what the agent's bluetoothctl prints (prompts end without a newline, so ':' ends a line too)
agent_read() {
	pk=0
	tr ':\r' '\n\n' | while IFS= read -r l; do
		case "$l" in
		*"Confirm passkey"*) ask confirm "$(echo "$l" | grep -o '[0-9]\{6\}' | head -1)";;
		*"Accept pairing"*|*"Authorize pairing"*) ask accept "";;
		*"Authorize service"*) if pairwin; then to_agent yes; else to_agent no; fi;;
		*"Enter PIN code"*) to_agent 0000;;
		*"Enter passkey"*) to_agent no;;
		*"Passkey"*|*"PIN code"*) pk=1; c=$(echo "$l" | grep -o '[0-9]\{4,6\}' | head -1); [ -n "$c" ] && { ask keyboard "$c"; pk=0; };;
		*"Pairing successful"*|*"Failed to pair"*) [ $pk = 1 ] && pk=0; echo "$l" | sed 's/\x1b\[[0-9;]*m//g; s/^.*\(Pairing successful\|Failed to pair\)/\1/' > $RES; rm -f $ASK;;
		*"Request canceled"*|*"canceled"*) rm -f $ASK;;
		*) if [ $pk = 1 ]; then c=$(echo "$l" | grep -o '[0-9]\{4,6\}' | head -1); [ -n "$c" ] && ask keyboard "$c"; pk=0; fi;;
		esac
	done
}
# the agent: a bluetoothctl that stays, registered as BlueZ's default agent; ends when bluetoothd restarts or stops
agent_run() {
	for i in $(seq 50); do up bluetoothd && [ -S $BUS ] && break; sleep 0.2; done
	up bluetoothd || return 1
	BDP=$(pidof bluetoothd)
	rm -f $AGIN $AGOUT $ASK; mkfifo -m 600 $AGIN $AGOUT || return 1
	exec 3<>$AGIN
	agent_read < $AGOUT &
	RP=$!
	$BC <&3 >$AGOUT 2>&1 &
	CP=$!; echo $CP > $R/btagent.pid
	sleep 1; printf 'agent KeyboardDisplay\n' >&3; sleep 1; printf 'default-agent\n' >&3
	while kill -0 $CP 2>/dev/null && [ ! -e $R/bluetooth-stop ] && [ "$(pidof bluetoothd)" = "$BDP" ]; do sleep 2; done
	kill $CP $RP 2>/dev/null; exec 3>&-; rm -f $ASK $R/btagent.pid $AGIN $AGOUT
}

start() {
	[ -x "$BD" ] || { echo "BlueZ is missing"; return 1; }
	mkdir -p /run/dbus
	if [ ! -S $BUS ] || ! pgrep -f '[d]bus-daemon --config-file=/etc/rudolf/dbus-system.conf' >/dev/null; then
		rm -f $BUS; dbus-daemon --config-file=/etc/rudolf/dbus-system.conf --fork --nopidfile
		for i in $(seq 30); do [ -S $BUS ] && break; sleep 0.1; done
	fi
	if [ -d /persist ] && [ -w /persist ]; then mkdir -p /persist/bluetooth; chmod 700 /persist/bluetooth
		mountpoint -q /var/lib/bluetooth || { mkdir -p /var/lib/bluetooth; mount --bind /persist/bluetooth /var/lib/bluetooth; }
	else mkdir -p /var/lib/bluetooth; fi
	for r in /sys/class/rfkill/*; do [ "$(cat $r/type 2>/dev/null)" = bluetooth ] && echo 0 > $r/soft 2>/dev/null; done
	[ -e /run/rudolf/bluetoothd.loop ] && kill -0 "$(cat /run/rudolf/bluetoothd.loop)" 2>/dev/null || (setsid sh -c "echo \$\$ > /run/rudolf/bluetoothd.loop; while [ ! -e /run/rudolf/bluetooth-stop ]; do $BD -n -f /etc/bluetooth/main.conf >>/run/rudolf/bluetooth.log 2>&1; sleep 2; done" </dev/null >/dev/null 2>&1 &)
	B=$(command -v bluealsa || command -v bluealsad)
	# 1.5.9: headsets' microphones too (Hands-Free and Headset, bluealsa's own), when this bluealsa has them
	BP="-p a2dp-source"; [ -n "$B" ] && $B --help 2>&1 | grep -q 'hfp-ag' && BP="$BP -p hfp-ag -p hsp-ag"
	# headphones: bluealsa's ALSA device for PulseAudio
	for c in /usr/share/alsa/alsa.conf.d/*bluealsa*.conf; do [ -f "$c" ] && mkdir -p /etc/alsa/conf.d && ln -sf "$c" /etc/alsa/conf.d/ 2>/dev/null; done
	[ -n "$B" ] && ! { [ -e /run/rudolf/bluealsa.loop ] && kill -0 "$(cat /run/rudolf/bluealsa.loop)" 2>/dev/null; } && (setsid sh -c "echo \$\$ > /run/rudolf/bluealsa.loop; while [ ! -e /run/rudolf/bluetooth-stop ]; do $B $BP >>/run/rudolf/bluealsa.log 2>&1; sleep 2; done" </dev/null >/dev/null 2>&1 &)
	rm -f /run/rudolf/bluetooth-stop
	[ -e $R/btagent.loop ] && kill -0 "$(cat $R/btagent.loop)" 2>/dev/null || (setsid sh -c "echo \$\$ > $R/btagent.loop; while [ ! -e $R/bluetooth-stop ]; do '$SELF' agent-run >>$R/btagent.log 2>&1; sleep 2; done" </dev/null >/dev/null 2>&1 &)
	for i in $(seq 50); do T=3 bc show | grep -q 'Controller' && break; sleep 0.2; done
	[ -f $OFF ] && T=5 bc power off >/dev/null || T=5 bc power on >/dev/null
	return 0
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037')"; }
status() {
	A=$(adapter)
	if [ -z "$A" ]; then echo '{"ok":true,"adapter":null,"running":false,"devices":[]}'; return; fi
	if ! up bluetoothd; then printf '{"ok":true,"adapter":"%s","running":false,"powered":false,"devices":[]}\n' "$A"; return; fi
	S=$(T=4 bc show)
	VI=$(echo "$S" | grep -q 'Discoverable: yes' && echo true || echo false)
	PW=$(echo "$S" | grep -q 'Powered: yes' && echo true || echo false); DI=$(echo "$S" | grep -q 'Discovering: yes' && echo true || echo false)
	printf '{"ok":true,"adapter":"%s","running":true,"powered":%s,"discovering":%s,"visible":%s,"name":%s,"devices":[' "$A" $PW $DI $VI "$(json_str "$(echo "$S" | sed -n 's/^\s*Alias: //p' | head -1)")"
	n=0
	for M in $(T=4 bc devices | sed -n 's/^Device \([0-9A-F:]\{17\}\) .*/\1/p'); do
		I=$(T=4 bc info $M)
		nm=$(echo "$I" | sed -n 's/^\s*Alias: //p' | head -1); ic=$(echo "$I" | sed -n 's/^\s*Icon: //p' | head -1)
		# paired = the key is kept (BlueZ's Bonded); "Paired: yes" alone is gone after a restart
		if echo "$I" | grep -q 'Bonded:'; then pa=$(echo "$I" | grep -q 'Bonded: yes' && echo true || echo false); else pa=$(echo "$I" | grep -q 'Paired: yes' && echo true || echo false); fi
		co=$(echo "$I" | grep -q 'Connected: yes' && echo true || echo false)
		tr_=$(echo "$I" | grep -q 'Trusted: yes' && echo true || echo false)
		bat=$(echo "$I" | sed -n 's/.*Battery Percentage: 0x[0-9a-f]* (\([0-9]*\)).*/\1/p' | head -1)
		au=$(echo "$I" | grep -qi 'Audio Sink' && echo true || echo false)
		rs=$(echo "$I" | sed -n 's/^\s*RSSI: .*(\(-\?[0-9]*\))/\1/p;s/^\s*RSSI: \(-\?[0-9]*\)$/\1/p' | head -1)
		[ $n -gt 0 ] && printf ','; n=$((n+1))
		printf '{"mac":"%s","name":%s,"icon":%s,"paired":%s,"trusted":%s,"connected":%s,"audio":%s,"battery":%s,"rssi":%s}' "$M" "$(json_str "$nm")" "$(json_str "$ic")" $pa $tr_ $co $au "${bat:-null}" "${rs:-null}"
	done
	printf '],"ask":%s}\n' "$(cat $ASK 2>/dev/null || echo null)"
}

# headphones: a PulseAudio output for each connected audio device (bluealsa's ALSA plug-in), removed when it goes.
# 1.5.9 (plan 7.2): a headset (Hands-Free or Headset profile) also gets its microphone, bt_in_MAC (bluealsa's SCO
# device). A headset's microphone only works in its call mode (SCO), which also carries the call's sound at phone
# quality; music stays on the better A2DP output. So callmode watches: while an app records from the headset's
# microphone (a call), what plays goes to its call output (bt_call_MAC, made then), and back to A2DP after.
# (PulseAudio closes an idle microphone after 5 s, module-suspend-on-idle, so the headset leaves call mode.)
# The names given to PulseAudio are quoted for its module arguments: before, a name with a space ("Galaxy Buds")
# made the output fail to load.
ASOCK=${RUDOLF_PULSE_SOCK:-/run/user/1000/pulse/native}
asuser() { su -s /bin/sh rudolf -c "XDG_RUNTIME_DIR=/run/user/1000 PULSE_SERVER=unix:$ASOCK DBUS_SYSTEM_BUS_ADDRESS=$DBUS_SYSTEM_BUS_ADDRESS $1"; }
CALLPID=$R/bt-callmode.pid
audio() {
	[ -S $ASOCK ] || return 0
	CON=""; HF=""
	for M in $(T=4 bc devices Connected 2>/dev/null | sed -n 's/^Device \([0-9A-F:]\{17\}\) .*/\1/p'); do
		I=$(T=4 bc info $M)
		echo "$I" | grep -qi 'Audio Sink' && CON="$CON $M"
		# (a headset: "Handsfree" or "Headset", not a phone's "Handsfree Audio Gateway" or "Headset AG")
		echo "$I" | grep -qE 'UUID: (Handsfree|Headset)[[:space:]]+\(' && HF="$HF $M"
	done
	MODS=$(asuser "pactl list short modules" 2>/dev/null)
	# remove the outputs and microphones of devices no longer connected
	echo "$MODS" | awk '/module-alsa-(sink|source)/ && /_name=bt_/ {print $1, $0}' | while read id rest; do
		m=$(echo "$rest" | sed -n 's/.*_name=bt_[a-z_]*\([0-9A-F]\{2\}\(_[0-9A-F]\{2\}\)\{5\}\).*/\1/p' | tr _ :)
		echo "$CON $HF" | grep -q "${m:-none}" || asuser "pactl unload-module $id" >/dev/null 2>&1
	done
	for M in $CON; do
		n=$(echo $M | tr : _)
		echo "$MODS" | grep -q "sink_name=bt_$n " && continue
		NAME=$(T=4 bc info $M | sed -n 's/^\s*Alias: //p' | head -1 | tr -cd 'A-Za-z0-9 ._-')
		asuser "pactl load-module module-alsa-sink device=bluealsa:DEV=$M,PROFILE=a2dp sink_name=bt_$n tsched=0 \"sink_properties='device.description=\\\"${NAME:-Bluetooth}\\\"'\"" >/dev/null 2>&1 \
			&& asuser "pactl set-default-sink bt_$n" >/dev/null 2>&1 && echo "headphones: $NAME"
	done
	for M in $HF; do
		n=$(echo $M | tr : _)
		echo "$MODS" | grep -q "source_name=bt_in_$n " && continue
		NAME=$(T=4 bc info $M | sed -n 's/^\s*Alias: //p' | head -1 | tr -cd 'A-Za-z0-9 ._-')
		asuser "pactl load-module module-alsa-source device=bluealsa:DEV=$M,PROFILE=sco source_name=bt_in_$n tsched=0 \"source_properties='device.description=\\\"${NAME:-Bluetooth} microphone\\\"'\"" >/dev/null 2>&1 \
			&& asuser "pactl set-default-source bt_in_$n" >/dev/null 2>&1 && echo "headset microphone: $NAME"
	done
	if [ -n "$HF" ] && ! { [ -s $CALLPID ] && kill -0 "$(cat $CALLPID)" 2>/dev/null; }; then
		(setsid "$SELF" callmode </dev/null >/dev/null 2>&1 &)
	fi
	return 0
}
# one look: for each headset microphone, is an app recording from it (not counting PulseAudio's own monitoring)
callmode_once() {
	MODS=$(asuser "pactl list short modules" 2>/dev/null)
	INS=$(echo "$MODS" | sed -n 's/.*source_name=bt_in_\([0-9A-F_]*\).*/\1/p')
	[ -n "$INS" ] || return 1
	SRCS=$(asuser "pactl list short sources" 2>/dev/null); OUTS=$(asuser "pactl list short source-outputs" 2>/dev/null)
	for n in $INS; do
		i=$(echo "$SRCS" | awk -F'\t' -v s=bt_in_$n '$2==s {print $1}')
		busy=$(echo "$OUTS" | awk -F'\t' -v i="$i" '$2==i && $4 !~ /module-/' | head -1)
		if [ -n "$busy" ] && ! echo "$MODS" | grep -q "sink_name=bt_call_$n "; then
			M=$(echo $n | tr _ :)
			asuser "pactl load-module module-alsa-sink device=bluealsa:DEV=$M,PROFILE=sco sink_name=bt_call_$n tsched=0 \"sink_properties='device.description=\\\"Headset (call)\\\"'\"" >/dev/null 2>&1 || continue
			asuser "pactl set-default-sink bt_call_$n" >/dev/null 2>&1
			for s in $(asuser "pactl list short sink-inputs" 2>/dev/null | awk -F'\t' '$4 !~ /module-/ {print $1}'); do asuser "pactl move-sink-input $s bt_call_$n" >/dev/null 2>&1; done
			echo "$(date) call mode: $M" >> $R/bluetooth.log
		elif [ -z "$busy" ]; then
			id=$(echo "$MODS" | awk -v a="sink_name=bt_call_$n " 'index($0 " ", a) {print $1}')
			[ -n "$id" ] || continue
			asuser "pactl set-default-sink bt_$n" >/dev/null 2>&1
			for s in $(asuser "pactl list short sink-inputs" 2>/dev/null | awk -F'\t' '$4 !~ /module-/ {print $1}'); do asuser "pactl move-sink-input $s bt_$n" >/dev/null 2>&1; done
			asuser "pactl unload-module $id" >/dev/null 2>&1
			echo "$(date) call mode ended: $(echo $n | tr _ :)" >> $R/bluetooth.log
		fi
	done
	return 0
}
callmode() {
	echo $$ > $CALLPID
	while callmode_once; do sleep ${RUDOLF_BT_CALLPOLL:-2}; done
	rm -f $CALLPID
}

case "$1" in
boot)
	for i in $(seq 40); do [ -n "$(adapter)" ] && break; sleep 0.5; done
	[ -n "$(adapter)" ] || exit 0
	start;;
start) start;;
stop) : > /run/rudolf/bluetooth-stop; T=5 bc power off >/dev/null; for p in bluetoothd bluealsa bluealsad; do kill $(pidof $p) 2>/dev/null; done; kill $(cat $R/btagent.loop 2>/dev/null) $(cat $R/btagent.pid 2>/dev/null) 2>/dev/null; rm -f /run/rudolf/bluetoothd.loop /run/rudolf/bluealsa.loop $R/btagent.loop $R/btagent.pid $ASK; exit 0;;
on) rm -f $OFF; up bluetoothd || start; T=5 bc power on;;
off) mkdir -p /persist/etc 2>/dev/null; : > $OFF; T=5 bc power off;;
status) status;;
scan)
	S=${2:-15}; case "$S" in ''|*[!0-9]*) S=15;; esac; [ $S -gt 60 ] && S=60
	# (until 1.5.1's fix this computer was never visible: a phone could not find it to pair from its side)
	T=5 bc pairable on >/dev/null; T=5 bc discoverable on >/dev/null
	T=$((S + 3)) bc --timeout $S scan on >/dev/null; echo scanned;;
visible) T=5 bc pairable on >/dev/null; T=5 bc discoverable on | tail -1;;
pair)
	mac_ok "$2" || { echo "bad device"; exit 2; }
	agent_up || { start >/dev/null; for i in $(seq 20); do agent_up && break; sleep 0.5; done; }
	agent_up || { echo "The pairing helper did not start. Turn Bluetooth off and on, then try again."; exit 1; }
	touch $PW; rm -f $RES
	to_agent "pair $2"
	# up to 45 s: long enough to compare a code on a phone
	ok=0; for i in $(seq 90); do sleep 0.5; bonded $2 && { ok=1; break; }; grep -q 'Failed' $RES 2>/dev/null && break; done
	rm -f $ASK
	if [ $ok = 0 ]; then sed -n 's/^Failed to pair: *//p' $RES 2>/dev/null | head -1 | grep . || echo "The pairing did not finish"; exit 1; fi
	echo "Pairing successful"
	T=8 bc trust $2 >/dev/null
	T=20 bc connect $2 | tail -1
	audio;;
connect) mac_ok "$2" || exit 2; T=20 bc connect $2 | tail -1; audio;;
disconnect) mac_ok "$2" || exit 2; T=10 bc disconnect $2 | tail -1; audio;;
remove) mac_ok "$2" || exit 2; T=10 bc remove $2 | tail -1; audio;;
audio) audio;;
callmode) callmode;;
callmode-once) callmode_once;;
answer) case "$2" in yes|no) answer $2;; *) exit 2;; esac;;
agent-run) agent_run;;
*) echo "usage: bluetooth boot|start|stop|on|off|status|scan [S]|pair MAC|connect MAC|disconnect MAC|remove MAC|audio|answer yes|no" >&2; exit 2;;
esac
