#!/bin/sh
# Rudolf OS 1.5.9 (docs/plan-1.5.9.md Part 1): the modem service. ModemManager (with libqmi, libmbim and libqrtr) runs
# only while a cellular modem is plugged in or built in: udev (or mdev, the fallback) starts it when a modem's device
# appears (wwan*, cdc-wdm*, a USB modem's serial ports) and it stops when the last one goes. It is on the system bus
# (the one Bluetooth uses, /etc/rudolf/dbus-system.conf).
# With mdev (no udev), ModemManager runs as on OpenWrt: without udev (--test-no-udev, or --no-auto-scan on an older
# one), applying its own udev rules (/usr/lib/udev/rules.d/*-mm-*.rules) itself, and told of each port with mmcli
# --report-kernel-event. With udev (1.6.0 Part 9) it finds its ports itself.
# 1.6.0 (docs/plan-1.6.0.md Part 1): what Rudolf OS reads of each modem (ModemManager's D-Bus API, through mmcli's
# key-value output) for rudolfd's mobile/*, the FCC unlock of laptop modules (ModemManager's scripts ship off; turned on
# for one module by an administrator: /persist/etc/modem-fcc), and the modules Linux supports only partly, named.
#   modem hotplug     (udev or mdev, with ACTION and MDEV) a modem's device came or went
#   modem start|stop
#   modem status      JSON: {"running":bool,"modems":[{id,maker,model,firmware,driver,plugin,state,failed,locked,
#                     retries:{pin,puk},sim,simOp,simName,operator,opcode,reg,signal,tech,imei,power,port,usb,fcc,fccId}],
#                     "notes":[{id,name,text}]}
#   modem fcc on|off ID   ID: the module's USB or PCI id (vvvv:pppp, or vvvv: ModemManager's script names)
# 1.6.0 (Part 2): the SIM and the network
#   modem pin MODEM FILE        the SIM's PIN (FILE: "pin=NNNN", root's only); modem puk MODEM FILE ("puk=", "pin=": new)
#   modem settings MODEM        JSON: the SIM's operator, the automatic APN, the one typed in, roaming, the network type
#   modem set MODEM KEY VALUE   apn (empty: automatic), apnuser, apnpass, roaming (0, the default, or 1), mode
#                               (auto, 5g, 4g, 3g: applied at once)
#   modem apn MCCMNC [SIM-NAME [NETWORK-NAME]]   the operator's settings: "name|apn|user|password|source"
#   modem airplane on|off|status   Wi-Fi, Bluetooth and the modems off together, and back as they were
# 1.6.0 (Part 3): the connection
#   modem connect MODEM | disconnect MODEM   (by the person: Disconnect keeps it off until Connect)
#   modem watch                 (started with ModemManager) turns modems on, connects automatically, notes failover
# The places can be moved for the host tests: RUDOLF_MODEM_SYS, RUDOLF_MODEM_DEV, RUDOLF_RUN, RUDOLF_MODEM_LOG,
# RUDOLF_MODEM_PERSIST, RUDOLF_MM_FCC_AVAIL, RUDOLF_MM_FCC_DIR, RUDOLF_MBPI, RUDOLF_APN_FIXES, RUDOLF_RFKILL,
# RUDOLF_RESOLV, RUDOLF_PROCNET, RUDOLF_NAT64, RUDOLF_CELL_METRIC, RUDOLF_FIREWALL.
# GPL-2.0-or-later.
export PATH=${RUDOLF_TEST_PATH:+$RUDOLF_TEST_PATH:}/usr/sbin:/usr/bin:/sbin:/bin
BUS=/run/dbus/system_bus_socket; LOG=${RUDOLF_MODEM_LOG:-/run/rudolf/modem.log}; DEVS=${RUDOLF_MODEM_DEV:-/dev}
SYS=${RUDOLF_MODEM_SYS:-/sys}; R=${RUDOLF_RUN:-/run/rudolf}; P=${RUDOLF_MODEM_PERSIST:-/persist/etc}
FA=${RUDOLF_MM_FCC_AVAIL:-/usr/share/ModemManager/fcc-unlock.available.d}; FD=${RUDOLF_MM_FCC_DIR:-/etc/ModemManager/fcc-unlock.d}
MM=$(command -v ModemManager)
# (1.6.0: by its name as a pattern: BusyBox's pgrep -x never matched it, so 1.5.9 started ModemManager again for each
# port and never stopped it, found in QEMU, qt/sb/cell60_q.py)
running() { pgrep '^ModemManager$' >/dev/null 2>&1; }
# a port's subsystem as ModemManager names it (empty: not a port it is told of)
subsys() { case "$1" in cdc-wdm*) echo usbmisc;; ttyUSB*|ttyACM*) echo tty;; wwan*) [ -e $SYS/class/net/$1 ] && echo net || echo wwan;;
	*) case "$(readlink -f $SYS/class/net/$1/device/driver 2>/dev/null)" in */qmi_wwan|*/cdc_mbim|*/mhi_net|*/mhi_wwan_mbim) echo net;; esac;; esac; }
report() { S=$(subsys "$2"); [ -n "$S" ] || return 0
	mmcli --report-kernel-event="action=$1,subsystem=$S,name=$2" >/dev/null 2>&1 || echo "$(date) could not report $1 $S/$2" >> $LOG; }
# every port there now (also the network interfaces, which mdev does not report)
ports() { for d in $SYS/class/usbmisc/cdc-wdm* $SYS/class/wwan/* $SYS/class/tty/ttyUSB* $SYS/class/tty/ttyACM* $SYS/class/net/*; do
	[ -e "$d" ] && [ -n "$(subsys "${d##*/}")" ] && echo "${d##*/}"; done; }
any_modem() { ls $DEVS/cdc-wdm* $DEVS/wwan* 2>/dev/null | grep -q . && return 0
	for t in $DEVS/ttyUSB*; do [ -e "$t" ] || continue; case "$(readlink -f $SYS/class/tty/${t##*/}/device/driver 2>/dev/null)" in */option*|*/qcserial*|*/sierra*) return 0;; esac; done; return 1; }
# 1.6.0: devices through udev (rudolf-init: /run/rudolf/devices says which)
with_udev() { [ "$(cat ${RUDOLF_DEVICES:-/run/rudolf/devices} 2>/dev/null)" = udev ]; }
# 1.6.0 (Part 1): the FCC unlock. ModemManager runs a module's script (from its own list, by USB or PCI id) only when
# it is linked in its fcc-unlock.d; Rudolf OS links the ones an administrator turned on, kept in /persist/etc/modem-fcc
fcc_ok() { echo "$1" | grep -qE '^[0-9a-f]{4}(:[0-9a-f]{4})?$' && [ -e "$FA/$1" ]; }
fcc_apply() { [ -s $P/modem-fcc ] || return 0; mkdir -p $FD 2>/dev/null
	while read -r id; do fcc_ok "$id" && ln -sfn "$FA/$id" "$FD/$id"; done < $P/modem-fcc; }
start() {
	[ -n "$MM" ] || { echo "ModemManager is not part of this build"; return 1; }
	running && return 0
	fcc_apply
	mkdir -p /run/dbus
	if [ ! -S $BUS ] || ! pgrep -f '[d]bus-daemon --config-file=/etc/rudolf/dbus-system.conf' >/dev/null; then
		rm -f $BUS; dbus-daemon --config-file=/etc/rudolf/dbus-system.conf --fork --nopidfile
		for i in $(seq 30); do [ -S $BUS ] && break; sleep 0.1; done
	fi
	# (no polkit on Rudolf OS: only root talks to it, through rudolfd)
	# 1.6.0 (plan Part 9): with udev running, ModemManager finds its ports itself (udev's database, its own rules'
	# ID_MM_CANDIDATE); with mdev (the fallback), as in 1.5.9: without udev, told of each port
	# (its test options are in --help: 1.5.9 asked --help-all, which it does not know, and always took --no-auto-scan)
	if with_udev; then NOU=; else NOU=--test-no-udev; $MM --help 2>/dev/null | grep -q test-no-udev || NOU=--no-auto-scan; fi
	setsid $MM --log-level=WARN $NOU >>$LOG 2>&1 </dev/null &
	echo "$(date) ModemManager started (${NOU:-with udev})" >> $LOG
	# on the bus, then (without udev) told of the ports already there
	for i in $(seq 50); do mmcli -L >/dev/null 2>&1 && break; sleep 0.2; done
	watch_start
	with_udev && return 0
	for p in $(ports); do report add $p; done
}
stop() { for f in $R/cellular/*; do [ -f "$f" ] && ifdown_cell "$(cat $f)"; done; rm -f $R/modem-watch.pid
	running || return 0; pkill '^ModemManager$'; echo "$(date) ModemManager stopped (no modem left)" >> $LOG; }
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
# a modem's USB or PCI id (vvvv:pppp) from its sysfs path (ModemManager's Device), the device itself or a parent
devid() { d=$SYS${1#/sys}; for i in 1 2 3 4; do
	if [ -r "$d/idVendor" ]; then echo "$(cat $d/idVendor):$(cat $d/idProduct)"; return; fi
	if [ -r "$d/vendor" ] && [ -r "$d/device" ]; then v=$(cat $d/vendor); p=$(cat $d/device); echo "${v#0x}:${p#0x}"; return; fi
	d=${d%/*}; done; }
# the FCC unlock for a module: "none" (it needs none, or ModemManager has no script for it), "off" or "on"; and the
# script's name
fcc_of() { [ -n "$1" ] || { echo "none -"; return; }; for n in "$1" "${1%%:*}"; do [ -e "$FA/$n" ] || continue
	[ -e "$FD/$n" ] && echo "on $n" || echo "off $n"; return; done; echo "none -"; }
# 1.6.0 (Part 1): cellular modules that Linux supports only partly, named with what is known (shown in Settings even
# when ModemManager sees nothing: they would otherwise fail silently). "id|name|what is known"
PARTLY='8086:7360|Intel XMM7360 (Fibocom L850-GL)|Built into some ThinkPads and other laptops. Linux has no driver for it as it is set up there (PCIe): ModemManager cannot see it. Some can be switched to USB mode, where they work as an MBIM modem; Rudolf OS cannot do the switch.
8086:7560|Intel XMM7560 (Fibocom L860-GL)|Linux drives it (the iosm driver) and ModemManager can connect with it, but texts, the signal details and some firmware versions may not work.
14c3:4d75|MediaTek T700 (Fibocom FM350-GL)|Linux drives it (the t7xx driver). Its radio starts off: turn on the module (the FCC unlock) below. Some firmware versions do not connect.'
notes() { first=1; printf '['
	for d in $SYS/bus/pci/devices/* $SYS/bus/usb/devices/*; do [ -e "$d" ] || continue
		if [ -r "$d/idVendor" ]; then id="$(cat $d/idVendor 2>/dev/null):$(cat $d/idProduct 2>/dev/null)"; else v=$(cat $d/vendor 2>/dev/null); p=$(cat $d/device 2>/dev/null); id="${v#0x}:${p#0x}"; fi
		line=$(printf '%s\n' "$PARTLY" | grep "^$id|") || continue
		n=${line#*|}; t=${n#*|}; n=${n%%|*}
		[ $first = 1 ] || printf ','; first=0; printf '{"id":"%s","name":"%s","text":"%s"}' "$id" "$(esc "$n")" "$(esc "$t")"
	done; printf ']'; }
# one modem's (and its SIM's) mmcli -K lines -> a JSON object
J_AWK='function e(s){gsub(/\\/,"\\\\",s);gsub(/"/,"\\\"",s);gsub(/\t/," ",s);return s}
function v(k){x=V[k];return x=="--"?"":x}
function list(k,  n,i,s){n=V[k".length"]+0;s="";for(i=1;i<=n;i++)s=s ((i>1)?",":"") v(k ".value[" i "]")
	if(!n&&V[k]!="")s=v(k);gsub(/, /,",",s);return s}
{i=index($0,":");if(!i)next;k=$0;sub(/ *:.*$/,"",k);val=substr($0,i+1);sub(/^ /,"",val);sub(/ +$/,"",val);V[k]=val}
END{pin=puk="";n=V["modem.generic.unlock-retries.length"]+0
	for(i=1;i<=n;i++){r=V["modem.generic.unlock-retries.value["i"]"];c=r;sub(/^.*\(/,"",c);sub(/\).*$/,"",c);if(r~/^sim-pin /)pin=c;if(r~/^sim-puk /)puk=c}
	sim=V["sim.dbus-path"]!=""?"true":"false"
	imei=v("modem.3gpp.imei");if(imei=="")imei=v("modem.generic.equipment-identifier");if(length(imei)>6)imei=substr(imei,1,6)"…"
	printf "{\"id\":%s,\"maker\":\"%s\",\"model\":\"%s\",\"firmware\":\"%s\",\"driver\":\"%s\",\"plugin\":\"%s\",\"state\":\"%s\",\"failed\":\"%s\",\"locked\":\"%s\",\"retries\":{\"pin\":%s,\"puk\":%s},", id,e(v("modem.generic.manufacturer")),e(v("modem.generic.model")),e(v("modem.generic.revision")),e(list("modem.generic.drivers")),e(v("modem.generic.plugin")),v("modem.generic.state"),v("modem.generic.state-failed-reason"),v("modem.generic.unlock-required"),pin==""?"null":pin,puk==""?"null":puk
	printf "\"sim\":%s,\"simOp\":\"%s\",\"simName\":\"%s\",\"operator\":\"%s\",\"opcode\":\"%s\",\"reg\":\"%s\",\"signal\":\"%s\",\"tech\":\"%s\",\"imei\":\"%s\",\"power\":\"%s\",\"port\":\"%s\",\"usb\":\"%s\",\"fcc\":\"%s\",\"fccId\":\"%s\",\"iface\":\"%s\"}", sim,e(v("sim.properties.operator-code")),e(v("sim.properties.operator-name")),e(v("modem.3gpp.operator-name")),e(v("modem.3gpp.operator-code")),v("modem.3gpp.registration-state"),v("modem.generic.signal-quality.value"),e(list("modem.generic.access-technologies")),e(imei),v("modem.generic.power-state"),e(v("modem.generic.primary-port")),usb,fcc,fccid,cif}'
status() {
	L=$(mmcli -K -L 2>/dev/null); rc=$?; RN=false; [ $rc = 0 ] && running && RN=true
	printf '{"running":%s,"modems":[' "$RN"; first=1
	if [ $RN = true ]; then
		for p in $(printf '%s\n' "$L" | grep -o '/org/freedesktop/ModemManager1/Modem/[0-9]*'); do
			n=${p##*/}; K=$(mmcli -m $n -K 2>/dev/null) || continue
			S=$(printf '%s\n' "$K" | sed -n 's/^modem\.generic\.sim  *: //p'); SK=""
			case "$S" in /org/*) SK=$(mmcli -i "${S##*/}" -K 2>/dev/null);; esac
			U=$(devid "$(printf '%s\n' "$K" | sed -n 's/^modem\.generic\.device  *: //p')"); set -- $(fcc_of "$U")
			[ $first = 1 ] || printf ','; first=0
			printf '%s\n%s\n' "$K" "$SK" | awk -v id="$n" -v usb="$U" -v fcc="$1" -v fccid="${2#-}" -v cif="$(cellif_of $n)" "$J_AWK"
		done
	fi
	b=$(best); c=false; { [ -n "$b" ] && { [ -e $R/cellular/$b ] || [ "$b" = clat ]; }; } && c=true
	printf '],"notes":%s,"route":"%s","cellular":%s}\n' "$(notes)" "$b" "$c"
}
# 1.6.0 (Part 1): the FCC unlock turned on or off for one module (rudolfd: an administrator's name and password first)
fcc() {
	fcc_ok "$2" || { echo "no FCC unlock is known for $2"; return 1; }
	mkdir -p $P $FD 2>/dev/null; touch $P/modem-fcc
	grep -vx "$2" $P/modem-fcc > $P/modem-fcc.new; mv $P/modem-fcc.new $P/modem-fcc
	if [ "$1" = on ]; then echo "$2" >> $P/modem-fcc; ln -sfn "$FA/$2" "$FD/$2" || { echo "could not turn it on"; return 1; }
		echo "$(date) FCC unlock turned on for $2" >> $LOG
		# ModemManager unlocks it the next time it turns the modem on: now, for the modems with that id
		if running; then for p in $(mmcli -K -L 2>/dev/null | grep -o '/org/freedesktop/ModemManager1/Modem/[0-9]*'); do n=${p##*/}
			U=$(devid "$(mmcli -m $n -K 2>/dev/null | sed -n 's/^modem\.generic\.device  *: //p')")
			case "$U" in "$2"|"$2":*) timeout 30 mmcli -m $n --enable >/dev/null 2>&1 || echo "$(date) modem $n: could not turn it on after the FCC unlock" >> $LOG;; esac; done; fi
		echo "The cellular module's radio is turned on (FCC unlock for $2)"
	else rm -f "$FD/$2"; echo "$(date) FCC unlock turned off for $2" >> $LOG; echo "The FCC unlock is off for $2: the radio stays off from the next start"; fi
}
# ---- 1.6.0 (Part 2): the SIM and the network (Settings › Mobile network) ----
MBPI=${RUDOLF_MBPI:-/usr/share/mobile-broadband-provider-info/serviceproviders.xml}; FIX=${RUDOLF_APN_FIXES:-/usr/share/rudolf/apn-fixes}
RF=${RUDOLF_RFKILL:-/sys/class/rfkill}
mkv() { printf '%s\n' "$1" | sed -n "s/^$2  *: //p" | head -1; }   # one value from mmcli's key-value lines
sim_of() { mkv "$1" 'modem\.generic\.sim' | sed -n 's#^/org/freedesktop/ModemManager1/SIM/##p'; }
modem_ok() { echo "$1" | grep -qE '^[0-9]{1,4}$' && MK=$(mmcli -m "$1" -K 2>/dev/null) && [ -n "$MK" ]; }
# each SIM's own settings (the APN, roaming, the network type; later the data used): in a file named by a hash of its
# ICCID, never the number itself; root's only (an APN's password may be in it)
simconf() { S=$(sim_of "$MK"); IC=; [ -n "$S" ] && IC=$(mmcli -i "$S" -K 2>/dev/null | sed -n 's/^sim\.properties\.iccid  *: //p')
	{ [ -n "$IC" ] && [ "$IC" != "--" ]; } || IC="modem-$(mkv "$MK" 'modem\.generic\.device-identifier')"
	echo "$P/mobile/$(printf '%s' "$IC" | sha256sum | cut -c1-16).conf"; }
cget() { sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -1; }
cset() { mkdir -p "${1%/*}"; chmod 700 "${1%/*}"; { grep -v "^$2=" "$1" 2>/dev/null; echo "$2=$3"; } > "$1.new"; chmod 600 "$1.new"; mv "$1.new" "$1"; }
# the operator's settings (APN) for a SIM: Rudolf's corrections first (apn-fixes), then the operators' database, by the
# SIM's operator code (MCCMNC), choosing among the operators that share it by the SIM's own name, then the network's,
# then the one with the most networks (the network's owner rather than a reseller). "name|apn|user|password|source";
# the APN exactly as written there, letters' case kept (docs/plan-1.6.1.md Part 7)
APN_AWK='function attr(a,  r){r=$0;if(!match(r,a "=\"[^\"]*\""))return "";return substr(r,RSTART+length(a)+2,RLENGTH-length(a)-3)}
function txt(  r){r=$0;sub(/^[^>]*>/,"",r);sub(/<.*$/,"",r);return r}
function ent(s){gsub(/&lt;/,"<",s);gsub(/&gt;/,">",s);gsub(/&quot;/,"\"",s);gsub(/&apos;/,"\047",s);gsub(/&amp;/,"\\&",s);return s}
function endapn(){if(inapn&&(use==""||use~/internet/)&&apns=="")apns=ent(av) "|" ent(au) "|" ent(ap);inapn=0}
/<provider[ >]/{inp=1;nm="";ids=" ";nid=0;apns="";inapn=0}
inp&&/<name[ >]/&&!inapn&&nm==""{nm=ent(txt())}
/<network-id /{ids=ids attr("mcc") attr("mnc") " ";nid++}
/<apn /{endapn();inapn=1;av=attr("value");au="";ap="";use="";if($0~/\/>/)endapn()}
inapn&&/<usage /{use=use attr("type") ","}
inapn&&/<username>/{au=txt()}
inapn&&/<password>/{ap=txt()}
/<\/apn>/{endapn()}
/<\/provider>/{if(inp&&index(ids," " want " ")&&apns!=""){n++;N[n]=nm;A[n]=apns;C[n]=nid}inp=0}
END{if(!n)exit 1;b=0;s=tolower(spn);o=tolower(op)
	if(s!="")for(i=1;i<=n;i++)if(index(s,tolower(N[i]))||index(tolower(N[i]),s)){b=i;break}
	if(!b&&o!="")for(i=1;i<=n;i++)if(index(o,tolower(N[i]))||index(tolower(N[i]),o)){b=i;break}
	if(!b){b=1;for(i=2;i<=n;i++)if(C[i]>C[b])b=i}
	print N[b] "|" A[b] "|database"}'
apn_find() {
	echo "$1" | grep -qE '^[0-9]{5,6}$' || return 1
	if [ -n "$2" ] && [ -r "$FIX" ]; then lo=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
		l=$(grep -v '^#' "$FIX" | while IFS='|' read -r mm nm a u pw why; do [ "$mm" = "$1" ] && [ -n "$nm" ] || continue
			case "$lo" in *"$(printf '%s' "$nm" | tr 'A-Z' 'a-z')"*) echo "$nm|$a|$u|$pw|rudolf"; break;; esac; done)
		[ -n "$l" ] && { echo "$l"; return 0; }; fi
	[ -r "$MBPI" ] && awk -v want="$1" -v spn="$2" -v op="$3" "$APN_AWK" "$MBPI"; }
# the network types a modem offers, as Settings names them: auto (all it has), 5g (5G preferred), 4g, 3g (only those)
modes_list() { printf '%s\n' "$MK" | sed -n 's/^modem\.generic\.supported-modes\.value\[[0-9]*\]  *: //p'; }
mode_now() { c=$(mkv "$MK" 'modem\.generic\.current-modes'); case "$c" in *"preferred: 5g"*) echo 5g;; "allowed: 4g; preferred: none") echo 4g;; "allowed: 3g; preferred: none") echo 3g;; *) echo auto;; esac; }
mode_choices() { L=$(modes_list); printf 'auto'; printf '%s\n' "$L" | grep -qE 'allowed: .*5g.*; preferred: 5g|^allowed: 5g; preferred: none' && printf ' 5g'
	printf '%s\n' "$L" | grep -qx 'allowed: 4g; preferred: none' && printf ' 4g'; printf '%s\n' "$L" | grep -qx 'allowed: 3g; preferred: none' && printf ' 3g'; echo; }
mode_apply() {   # MODEM MODE
	L=$(modes_list); case "$2" in
	auto) c=$(printf '%s\n' "$L" | grep '; preferred: none$' | awk -F'[:;]' '{n=split($2,a,",");if(n>m){m=n;b=$0}}END{print b}');;
	5g) c=$(printf '%s\n' "$L" | grep '; preferred: 5g$' | head -1); [ -n "$c" ] || c=$(printf '%s\n' "$L" | grep -x 'allowed: 5g; preferred: none');;
	4g|3g) c=$(printf '%s\n' "$L" | grep -x "allowed: $2; preferred: none");;
	*) c=;; esac
	[ -n "$c" ] || { echo "this modem cannot use only $2"; return 1; }
	al=$(printf '%s' "$c" | sed 's/^allowed: \([^;]*\);.*/\1/; s/, /|/g'); pr=${c##*preferred: }
	mmcli -m "$1" --set-allowed-modes="$al" --set-preferred-mode="$pr" >/dev/null 2>&1 || { echo "the modem refused the network type"; return 1; }; }
retries() { mmcli -m "$1" -K 2>/dev/null | sed -n "s/^modem\.generic\.unlock-retries\.value\[[0-9]*\]  *: $2 (\([0-9]*\))$/\1/p" | head -1; }
# the SIM's PIN, and its PUK with a new PIN (rudolfd: an administrator's name and password first; the codes come in a
# root-only file, never on rudolfd's command line)
pin() {   # MODEM CODES-FILE ("pin=1234")
	modem_ok "$1" || { echo "There is no such modem."; return 1; }; S=$(sim_of "$MK"); [ -n "$S" ] || { echo "There is no SIM card in this modem."; return 1; }
	PIN=$(sed -n 's/^pin=//p' "$2" 2>/dev/null | head -1); echo "$PIN" | grep -qE '^[0-9]{4,8}$' || { echo "A PIN is 4 to 8 digits."; return 1; }
	o=$(mmcli -i "$S" --pin="$PIN" 2>&1)
	case "$o" in *successfully*) timeout 30 mmcli -m "$1" --enable >/dev/null 2>&1; echo "PIN accepted: the SIM is unlocked."; return 0;;
	*IncorrectPassword*) n=$(retries "$1" sim-pin); if [ "$n" = 0 ] || [ "$(mmcli -m "$1" -K 2>/dev/null | sed -n 's/^modem\.generic\.unlock-required  *: //p')" = sim-puk ]; then echo "Wrong PIN. The SIM is now blocked: its PUK is needed."; else echo "Wrong PIN. ${n:-?} tries left."; fi;;
	*SimPuk*) echo "The SIM is blocked: its PUK is needed.";;
	*) echo "The PIN could not be given to the SIM (${o##*: })";; esac; return 1; }
puk() {   # MODEM CODES-FILE ("puk=12345678", "pin=1234": the new PIN)
	modem_ok "$1" || { echo "There is no such modem."; return 1; }; S=$(sim_of "$MK"); [ -n "$S" ] || { echo "There is no SIM card in this modem."; return 1; }
	PUK=$(sed -n 's/^puk=//p' "$2" 2>/dev/null | head -1); PIN=$(sed -n 's/^pin=//p' "$2" 2>/dev/null | head -1)
	echo "$PUK" | grep -qE '^[0-9]{8}$' || { echo "A PUK is 8 digits."; return 1; }; echo "$PIN" | grep -qE '^[0-9]{4,8}$' || { echo "The new PIN must be 4 to 8 digits."; return 1; }
	o=$(mmcli -i "$S" --puk="$PUK" --pin="$PIN" 2>&1)
	case "$o" in *successfully*) timeout 30 mmcli -m "$1" --enable >/dev/null 2>&1; echo "PUK accepted: the SIM is unlocked, with the new PIN."; return 0;;
	*SimFailure*|*SimWrong*) echo "Wrong PUK. The SIM is now blocked for good: only your operator can replace it.";;
	*IncorrectPassword*) n=$(retries "$1" sim-puk); echo "Wrong PUK. ${n:-?} tries left before the SIM is blocked for good.";;
	*) echo "The PUK could not be given to the SIM (${o##*: })";; esac; return 1; }
js_s() { printf '"%s"' "$(esc "$1")"; }
settings() {   # MODEM: the SIM's settings and what is automatic
	modem_ok "$1" || { echo '{"error":"no such modem"}'; return 1; }; F=$(simconf); S=$(sim_of "$MK"); SK=; [ -n "$S" ] && SK=$(mmcli -i "$S" -K 2>/dev/null)
	OPC=$(mkv "$SK" 'sim\.properties\.operator-code'); SPN=$(mkv "$SK" 'sim\.properties\.operator-name'); NOP=$(mkv "$MK" 'modem\.3gpp\.operator-name')
	[ "$OPC" = "--" ] && OPC=; [ "$SPN" = "--" ] && SPN=; [ "$NOP" = "--" ] && NOP=
	A=$(apn_find "$OPC" "$SPN" "$NOP")
	printf '{"sim":%s,"simOp":%s,"simName":%s,' "$([ -n "$S" ] && echo true || echo false)" "$(js_s "$OPC")" "$(js_s "$SPN")"
	if [ -n "$A" ]; then IFS='|' read -r an aa au ap asrc <<EOF
$A
EOF
		printf '"auto":{"name":%s,"apn":%s,"user":%s,"source":%s},' "$(js_s "$an")" "$(js_s "$aa")" "$(js_s "$au")" "$(js_s "$asrc")"; else printf '"auto":null,'; fi
	printf '"autoconnect":%s,"off":%s,' "$([ "$(cget "$F" autoconnect)" = 0 ] && echo false || echo true)" "$([ -e "$(offkey)" ] && echo true || echo false)"
	printf '"apn":%s,"apnuser":%s,"apnpass":%s,"roaming":%s,"mode":%s,"modes":[%s]}\n' "$(js_s "$(cget "$F" apn)")" "$(js_s "$(cget "$F" apnuser)")" "$([ -n "$(cget "$F" apnpass)" ] && echo true || echo false)" \
		"$([ "$(cget "$F" roaming)" = 1 ] && echo true || echo false)" "$(js_s "$(mode_now)")" "$(mode_choices | sed 's/\([a-z0-9]*\)/"\1"/g; s/ /,/g')"; }
# the APN in use for this SIM: the one typed in, else the automatic one ("apn|user|password")
apn_use() { F=$(simconf); a=$(cget "$F" apn); if [ -n "$a" ]; then echo "$a|$(cget "$F" apnuser)|$(cget "$F" apnpass)"; return; fi
	S=$(sim_of "$MK"); SK=; [ -n "$S" ] && SK=$(mmcli -i "$S" -K 2>/dev/null)
	A=$(apn_find "$(mkv "$SK" 'sim\.properties\.operator-code')" "$(mkv "$SK" 'sim\.properties\.operator-name' | sed 's/^--$//')" "$(mkv "$MK" 'modem\.3gpp\.operator-name' | sed 's/^--$//')") && echo "$A" | cut -d'|' -f2-4; }
setting() {   # MODEM KEY VALUE (rudolfd has checked the value's characters)
	modem_ok "$1" || { echo "There is no such modem."; return 1; }; F=$(simconf)
	case "$2" in
	apn) echo "$3" | grep -qE '^([A-Za-z0-9][A-Za-z0-9._-]{0,99})?$' || { echo "An APN has letters, digits, dots and hyphens only."; return 1; }; cset "$F" apn "$3"
		[ -z "$3" ] && { cset "$F" apnuser ""; cset "$F" apnpass ""; };;
	apnuser|apnpass) printf '%s' "$3" | grep -qE "^[^,'\"\\\\]{0,64}$" || { echo "That name or password has a character the modem cannot take (a comma or a quote)."; return 1; }; cset "$F" "$2" "$3";;
	roaming) case "$3" in 0|1) cset "$F" roaming "$3";; *) echo "roaming: 0 or 1"; return 1;; esac;;
	autoconnect) case "$3" in 0|1) cset "$F" autoconnect "$3";; *) echo "autoconnect: 0 or 1"; return 1;; esac;;
	mode) case "$3" in auto|5g|4g|3g) ;; *) echo "mode: auto, 5g, 4g or 3g"; return 1;; esac; mode_apply "$1" "$3" || return 1; cset "$F" mode "$3";;
	*) echo "no such setting: $2"; return 1;; esac
	echo "saved"; }
# airplane mode: Wi-Fi, Bluetooth and the modems off together (rfkill, ModemManager), and back as they were
airplane() {
	AS=$R/airplane
	case "$1" in
	on) [ -e $AS ] && { echo "Airplane mode is on"; return 0; }; mkdir -p $R; : > $AS.new
		for r in $RF/rfkill*; do [ -e "$r/type" ] || continue; t=$(cat $r/type); case "$t" in wlan|bluetooth|wwan) echo "rf ${r##*/} $t $(cat $r/soft 2>/dev/null)" >> $AS.new; echo 1 > $r/soft 2>/dev/null;; esac; done
		if running; then for p in $(mmcli -K -L 2>/dev/null | grep -o '/org/freedesktop/ModemManager1/Modem/[0-9]*'); do n=${p##*/}
			st=$(mmcli -m $n -K 2>/dev/null | sed -n 's/^modem\.generic\.state  *: //p'); case "$st" in enabled|searching|registered|connecting|connected|disconnecting) echo "mm $n on" >> $AS.new; timeout 20 mmcli -m $n --disable >/dev/null 2>&1;; *) echo "mm $n off" >> $AS.new;; esac; done; fi
		mv $AS.new $AS; echo "$(date) airplane mode on" >> $LOG; echo "Airplane mode is on";;
	off) [ -e $AS ] || { echo "Airplane mode is off"; return 0; }
		while read -r k a b c; do case "$k" in rf) [ "$c" = 0 ] && [ -e "$RF/$a/soft" ] && echo 0 > "$RF/$a/soft" 2>/dev/null;; mm) [ "$b" = on ] && timeout 30 mmcli -m "$a" --enable >/dev/null 2>&1;; esac; done < $AS
		rm -f $AS; echo "$(date) airplane mode off" >> $LOG; echo "Airplane mode is off";;
	*) printf '{"on":%s}\n' "$([ -e $AS ] && echo true || echo false)";; esac; }
# ---- 1.6.0 (Part 3): the connection ----
# Cable, then Wi-Fi, then cellular: their default routes' metrics (100, 600, 700; udhcpc.sh gives the first two), and
# routes on an interface whose link went down ignored at once (ignore_routes_with_linkdown), so cellular stays connected
# but unused while Wi-Fi works and carries the traffic as soon as Wi-Fi drops. ModemManager connects (its bearer);
# Rudolf OS sets the interface up as the bearer says (static addresses, or DHCP where the modem hands them out that way),
# its DNS (RUN/dns/IF, as udhcpc.sh keeps them), the firewall's cellular set (firewall cellular add IF), and, on an
# IPv6-only network, a CLAT (tayga, 464XLAT: IPv4 programs reach IPv4 sites through the operator's NAT64).
# A watch (modem watch, while ModemManager runs) turns modems on, connects automatically (the SIM's "auto", on by
# default; not while roaming unless roaming is allowed; not after Disconnect until Connect; not in airplane mode), and
# notes when the connection in use moves to cellular or back (RUN/cell-notes: rudolfd's mobile/notes, both desktops).
CM=${RUDOLF_CELL_METRIC:-700}; RESOLV=${RUDOLF_RESOLV:-/etc/resolv.conf}; PROCNET=${RUDOLF_PROCNET:-/proc/sys/net}
NAT64=${RUDOLF_NAT64:-}; FW=${RUDOLF_FIREWALL:-/usr/lib/rudolf/firewall}
best() { ip route 2>/dev/null | awk '/^default/{d="";m=0;for(i=1;i<NF;i++){if($i=="dev")d=$(i+1);if($i=="metric")m=$(i+1)}if(d!=""&&$0!~/linkdown/)print m+0, d}' | sort -n | head -1 | cut -d' ' -f2; }
resolv() { b=$(best); [ -n "$b" ] && [ -f "$R/dns/$b" ] && cat "$R/dns/$b" > "$RESOLV" 2>/dev/null; true; }
note() { mkdir -p $R; n=$(( $(sed -n '$s/|.*//p' $R/cell-notes 2>/dev/null || echo 0) + 1 )); printf '%s|%s|%s\n' "$n" "$1" "$2" >> $R/cell-notes
	[ "$(wc -l < $R/cell-notes)" -gt 40 ] && { tail -20 $R/cell-notes > $R/cell-notes.new; mv $R/cell-notes.new $R/cell-notes; }; echo "$(date) $1: $2" >> $LOG; }
bkv() { printf '%s\n' "$BK" | sed -n "s/^bearer\.$1  *: //p" | head -1 | sed 's/^--$//'; }
bkl() { printf '%s\n' "$BK" | sed -n "s/^bearer\.$1\.value\[[0-9]*\]  *: //p"; [ -n "$(bkv "$1")" ] && bkv "$1"; }
bearer_of() { printf '%s\n' "$MK" | sed -n 's#^modem\.generic\.bearers\.value\[[0-9]*\]  *: /org/freedesktop/ModemManager1/Bearer/##p' | head -1; }
cellif_of() { for f in $R/cellular/*; do [ -f "$f" ] && [ "$(cat $f)" = "$1" ] && { echo "${f##*/}"; return; }; done; }
linkdown_ignored() { for v in ipv4 ipv6; do for c in all default; do f=$PROCNET/$v/conf/$c/ignore_routes_with_linkdown; [ -w "$f" ] && echo 1 > "$f"; done; done; }
# the operator's NAT64 prefix (RFC 7050: ipv4only.arpa's IPv6 addresses through its DNS), else the well-known one
nat64() { [ -n "$NAT64" ] && { echo "$NAT64"; return; }
	for d in $(sed -n 's/^nameserver //p' "$R/dns/$1" 2>/dev/null); do a=$(nslookup -type=AAAA ipv4only.arpa "$d" 2>/dev/null | sed -n 's/^Address: *\([0-9a-fA-F:]*:c000:aa\)$/\1/p' | head -1)
		[ -n "$a" ] && { echo "${a%c000:aa}/96"; return; }; done; echo 64:ff9b::/96; }
# the CLAT's own IPv6 address: in the cellular interface's /64 (the operator routes all of it to the modem), ::c1a7
v6c1a7() { printf '%s\n' "$1" | awk -F'::' '{n=split($1,h,":");if(NF>1){m=split($2,t,":")}else m=0;if($1=="")n=0;k=0
	for(i=1;i<=n;i++)g[++k]=h[i];for(i=n+m;i<8;i++)g[++k]="0";for(i=1;i<=m;i++)g[++k]=t[i];printf "%s:%s:%s:%s::c1a7\n",g[1],g[2],g[3],g[4]}'; }
clat_stop() { [ -s $R/clat/tayga.pid ] && kill "$(cat $R/clat/tayga.pid)" 2>/dev/null; ip link del clat 2>/dev/null; ip route del default dev clat 2>/dev/null; rm -rf $R/clat $R/dns/clat; }
clat_start() {   # IF V6ADDR: IPv4 through the operator's NAT64 (tayga as a CLAT, 192.0.0.1 here)
	command -v tayga >/dev/null || { note "Mobile data: IPv6 only" "This network has no IPv4 and this build has no CLAT: IPv4-only sites cannot be reached."; return 1; }
	clat_stop; mkdir -p $R/clat; P=$(nat64 "$1"); C=$(v6c1a7 "$2")
	printf 'tun-device clat\nipv4-addr 192.0.0.2\nprefix %s\nmap 192.0.0.1 %s\ndata-dir %s/clat\n' "$P" "$C" "$R" > $R/clat/tayga.conf
	tayga -c $R/clat/tayga.conf --mktun >/dev/null 2>&1 || { note "Mobile data: IPv6 only" "The CLAT could not start (no TUN device?): IPv4-only sites cannot be reached."; return 1; }
	ip link set clat up; ip link set clat mtu 1260; ip addr add 192.0.0.1/32 dev clat; ip route replace default dev clat metric $CM
	ip -6 route replace "$C/128" dev clat
	echo 1 > $PROCNET/ipv6/conf/all/forwarding 2>/dev/null; for f in $PROCNET/ipv6/conf/*/accept_ra; do [ "$(cat $f 2>/dev/null)" = 1 ] && echo 2 > $f; done
	tayga -c $R/clat/tayga.conf -p $R/clat/tayga.pid >/dev/null 2>&1
	cp "$R/dns/$1" "$R/dns/clat" 2>/dev/null; echo "$1 $P $C" > $R/clat/info; }
ifup_cell() {   # MODEM: its bearer's interface set up as ModemManager says
	MK=$(mmcli -m "$1" -K 2>/dev/null); B=$(bearer_of); [ -n "$B" ] || return 1; BK=$(mmcli -b "$B" -K 2>/dev/null)
	[ "$(bkv status.connected)" = yes ] || return 1; IF=$(bkv status.interface); [ -n "$IF" ] || return 1
	mkdir -p $R/cellular $R/dns; echo "$1" > $R/cellular/$IF; linkdown_ignored
	ip link set "$IF" up; mtu=$(bkv ipv4-config.mtu); [ -n "$mtu" ] && ip link set "$IF" mtu "$mtu" 2>/dev/null
	m4=$(bkv ipv4-config.method); a4=$(bkv ipv4-config.address); p4=$(bkv ipv4-config.prefix); g4=$(bkv ipv4-config.gateway)
	m6=$(bkv ipv6-config.method); a6=$(bkv ipv6-config.address); p6=$(bkv ipv6-config.prefix); g6=$(bkv ipv6-config.gateway)
	{ for d in $(bkl ipv4-config.dns) $(bkl ipv6-config.dns); do echo "nameserver $d"; done; } > $R/dns/$IF
	if [ "$m4" = static ] && [ -n "$a4" ]; then ip -4 addr flush dev "$IF"; ip addr add "$a4/${p4:-32}" dev "$IF"
		if [ -n "$g4" ]; then ip route replace default via "$g4" dev "$IF" metric $CM; else ip route replace default dev "$IF" metric $CM; fi
	elif [ "$m4" = dhcp ]; then mkdir -p $R/udhcpc; [ -e $R/udhcpc/$IF.pid ] || udhcpc -b -i "$IF" -p $R/udhcpc/$IF.pid -s /usr/lib/rudolf/udhcpc.sh >/dev/null 2>&1; fi
	if [ "$m6" = static ] && [ -n "$a6" ]; then ip -6 addr add "$a6/${p6:-64}" dev "$IF" 2>/dev/null
		if [ -n "$g6" ]; then ip -6 route replace default via "$g6" dev "$IF" metric $CM; else ip -6 route replace default dev "$IF" metric $CM; fi
	elif [ -n "$m6" ]; then echo 2 > $PROCNET/ipv6/conf/$IF/accept_ra 2>/dev/null; fi
	$FW cellular add "$IF" >/dev/null 2>&1
	if [ -z "$a4" ] && [ "$m4" != dhcp ] && [ -n "$a6" ]; then clat_start "$IF" "$a6"; fi
	resolv; echo "$(date) modem $1 connected on $IF (${a4:-no IPv4}${a6:+, $a6})" >> $LOG; }
ifdown_cell() {   # MODEM
	IF=$(cellif_of "$1"); [ -n "$IF" ] || return 0
	[ -n "$(cat $R/clat/info 2>/dev/null | cut -d' ' -f1 | grep -x "$IF")" ] && clat_stop
	p=$(cat $R/udhcpc/$IF.pid 2>/dev/null); [ -n "$p" ] && kill "$p" 2>/dev/null; rm -f $R/udhcpc/$IF.pid
	ip route del default dev "$IF" 2>/dev/null; ip -6 route del default dev "$IF" 2>/dev/null; ip addr flush dev "$IF" 2>/dev/null
	$FW cellular del "$IF" >/dev/null 2>&1
	rm -f $R/cellular/$IF $R/dns/$IF; resolv; }
offkey() { echo "$R/cell-off/$(basename "$(simconf)" .conf)"; }
connect() {   # MODEM [user]: ModemManager connects with the SIM's APN and roaming setting, then the interface is set up
	modem_ok "$1" || { echo "There is no such modem."; return 1; }
	[ -e $R/airplane ] && { echo "Airplane mode is on: turn it off to use mobile data."; return 1; }
	[ "$2" = user ] && rm -f "$(offkey)"
	[ -e "$R/data-off/$(basename "$(simconf)" .conf)" ] && [ "$2" != user ] && return 1
	F=$(simconf); A=$(apn_use); apn=$(echo "$A" | cut -d'|' -f1); u=$(echo "$A" | cut -d'|' -f2); pw=$(echo "$A" | cut -d'|' -f3)
	roam=no; [ "$(cget "$F" roaming)" = 1 ] && roam=yes
	reg=$(mkv "$MK" 'modem\.3gpp\.registration-state'); [ "$reg" = roaming ] && [ $roam = no ] && { echo "Roaming: mobile data is off while roaming (Settings › Mobile network)."; return 1; }
	st=$(mkv "$MK" 'modem\.generic\.state'); case "$st" in connected) ifup_cell "$1"; echo "Connected"; return 0;; disabled) timeout 30 mmcli -m "$1" --enable >/dev/null 2>&1;; esac
	props="ip-type=ipv4v6,allow-roaming=$roam"; [ -n "$apn" ] && props="apn=$apn,$props"; [ -n "$u" ] && props="$props,user=$u"; [ -n "$pw" ] && props="$props,password=$pw"
	o=$(timeout 90 mmcli -m "$1" --simple-connect="$props" 2>&1) || { w=${o##*: }; w=${w%\'}
		case "$o" in *MissingOrUnknownApn*|*UnknownApn*) echo "The network refused the APN ($apn): check it in Settings › Mobile network (capitals matter on some networks).";;
		*Unauthorized*oaming*) echo "Roaming: the network refused mobile data while roaming.";; *) echo "Could not connect: $w";; esac
		echo "$(date) modem $1: could not connect: $o" >> $LOG; return 1; }
	ifup_cell "$1" || { echo "Connected, but the modem gave no network interface."; return 1; }; echo "Connected"; }
disconnect() {   # MODEM [user]: by the person (Disconnect): not connected again automatically until Connect
	modem_ok "$1" || { echo "There is no such modem."; return 1; }
	[ "$2" = user ] && { mkdir -p $R/cell-off; : > "$(offkey)"; }
	ifdown_cell "$1"; timeout 30 mmcli -m "$1" --simple-disconnect >/dev/null 2>&1; echo "Disconnected"; }
watch() {
	echo $$ > $R/modem-watch.pid; last=$(best); k=0
	while running && [ "$(cat $R/modem-watch.pid 2>/dev/null)" = $$ ]; do
		if [ $k = 0 ] && [ ! -e $R/airplane ]; then
			for p in $(mmcli -K -L 2>/dev/null | grep -o '/org/freedesktop/ModemManager1/Modem/[0-9]*'); do n=${p##*/}; MK=$(mmcli -m $n -K 2>/dev/null) || continue
				st=$(mkv "$MK" 'modem\.generic\.state'); F=$(simconf)
				case "$st" in
				disabled) timeout 30 mmcli -m $n --enable >/dev/null 2>&1;;
				registered) [ "$(cget "$F" autoconnect)" = 0 ] || [ -e "$(offkey)" ] || connect $n >/dev/null 2>&1;;
				connected) [ -n "$(cellif_of $n)" ] || ifup_cell $n;;
				esac
			done
			# a modem that is gone, or no longer connected: its interface undone
			for f in $R/cellular/*; do [ -f "$f" ] || continue; n=$(cat $f); s=$(mmcli -m $n -K 2>/dev/null | sed -n 's/^modem\.generic\.state  *: //p'); [ "$s" = connected ] || ifdown_cell $n; done
		fi
		k=$(( (k + 1) % 3 ))
		now=$(best)
		if [ "$now" != "$last" ]; then
			if [ -n "$now" ] && { [ -e $R/cellular/$now ] || [ "$now" = clat ]; }; then
				case "$last" in "") note "📶 Mobile data connected" "The computer is online through the cellular modem (metered: updates and other large downloads wait).";;
				*) note "📶 Using mobile data" "The $(kindname "$last") connection is gone: mobile data carries the traffic now (metered: updates and other large downloads wait).";; esac
			elif [ -n "$last" ] && { [ -e $R/cellular/$last ] || [ "$last" = clat ] || [ -n "$(cat $R/cell-last 2>/dev/null)" ]; } && [ -n "$now" ]; then
				[ -n "$(cat $R/cell-last 2>/dev/null)" ] && note "📶 Back on $(kindname "$now")" "Mobile data stays connected, unused, in case $(kindname "$now") drops again."
			fi
			{ [ -e $R/cellular/$now ] || [ "$now" = clat ]; } && echo "$now" > $R/cell-last || rm -f $R/cell-last
			last=$now; resolv
		fi
		sleep 2
	done; }
kindname() { if [ -e "$SYS/class/net/$1/wireless" ] || [ -e "$SYS/class/net/$1/phy80211" ] || [ "$(cat $R/wifi-if 2>/dev/null)" = "$1" ]; then echo Wi-Fi; else case "$1" in wl*) echo Wi-Fi;; *) echo cable;; esac; fi; }
watch_start() { [ -s $R/modem-watch.pid ] && kill -0 "$(cat $R/modem-watch.pid)" 2>/dev/null && return 0; (setsid "$0" watch </dev/null >/dev/null 2>&1 &); }
case "$1" in
hotplug)
	# (one at a time: a modem's ports come together, and the first one starts ModemManager and reports them all)
	mkdir -p $R; for i in $(seq 150); do mkdir $R/modem.lock 2>/dev/null && break; sleep 0.2; done; trap 'rmdir $R/modem.lock 2>/dev/null' EXIT
	if [ "$ACTION" = remove ]; then running && ! with_udev && report remove "$MDEV"; sleep 1; any_modem || stop
	elif any_modem; then if running; then with_udev || report add "$MDEV"; else start; fi; fi ;;
start) start ;;
stop) stop ;;
status) status ;;
fcc) case "$2" in on|off) fcc "$2" "$3";; *) echo "usage: modem fcc on|off ID"; exit 2;; esac ;;
pin) pin "$2" "$3" ;;
puk) puk "$2" "$3" ;;
settings) settings "$2" ;;
set) setting "$2" "$3" "$4" ;;
apn) apn_find "$2" "$3" "$4" ;;
airplane) airplane "$2" ;;
connect) connect "$2" user ;;
disconnect) disconnect "$2" user ;;
watch) watch ;;
*) echo "usage: modem hotplug|start|stop|status|fcc|pin|puk|settings|set|apn|airplane|connect|disconnect|watch"; exit 2 ;;
esac
