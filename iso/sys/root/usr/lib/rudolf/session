#!/bin/sh
# Rudolf OS display session: Xorg on the graphics card or Xvfb + framebuffer bridge, then Chromium kiosk.
# Restarts the browser if it crashes or stops responding. GPL-2.0-or-later.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
RCMD=/etc/rudolf/cmdline; [ -s $RCMD ] || RCMD=/proc/cmdline   # the start-up options (1.2.8: not /proc/cmdline, see initramfs/init)
export DISPLAY=:0
LOG=/run/rudolf/session.log
exec >>$LOG 2>&1
if [ ! -e /dev/fb0 ]; then
	echo "no framebuffer" > /dev/console
	echo "Rudolf OS needs a graphics screen (VESA or UEFI GOP). Try 'Screen resolution' in the boot menu." > /dev/console
	exec sh < /dev/console > /dev/console 2>&1
fi
# ---- display path ------------------------------------------------------------------------
# "gpu":  Xorg on the graphics card (fast; Linux apps such as Sober render on the GPU).
# "soft": Xvfb in memory, copied to the framebuffer by rudolf-display (works everywhere).
# The graphics-card path is used when a graphics driver loaded and Settings allow it; if Xorg
# does not start, or stops later, Rudolf OS falls back to the software display.
# Settings > Display > Resolution and Frame rate (/etc/rudolf-screen: "auto|WxH FPS"); recovery and safe
# graphics mode always use the screen's own resolution at 60 frames a second
read_screen() {
	RES=auto; FPS=60
	[ -s /etc/rudolf-screen ] && read RES FPS < /etc/rudolf-screen
	grep -qE 'rudolf.recovery=1|rudolf.nogpu=1|nomodeset|rudolf.softdisplay=1' $RCMD && { RES=auto; FPS=60; }
	case "$RES" in auto|[0-9]*x[0-9]*) ;; *) RES=auto;; esac
	case "$FPS" in 30|60|90|120) ;; *) FPS=60;; esac
}
# 1.4.5: rudolf-display passes the kernel's key codes (+8) to X, which are evdev key codes; Xvfb's own keymap is not
# (with it, the arrow keys, Page Up and Down, Home, End and Delete arrived as other keys: Page Down as the menu key)
keys_evdev() { DISPLAY=:0 setxkbmap -rules evdev -model pc105 -layout us >/dev/null 2>&1 || echo "$(date) setxkbmap failed"; }
start_soft() {
	set -- $(rudolf-display --size)
	FBW=${1:-1024}; FBH=${2:-768}; W=$FBW; H=$FBH
	# another resolution: Xvfb renders at that size and rudolf-display scales it to the screen, keeping its shape
	case "$RES" in [0-9]*x[0-9]*) W=${RES%x*}; H=${RES#*x};; esac
	# the firmware's screen refreshes about 60 times a second: faster updates cannot be seen
	SFPS=$FPS; [ "$SFPS" -gt 60 ] && SFPS=60; export RUDOLF_FPS=$SFPS
	S=native; [ "$W" = "$FBW" ] && [ "$H" = "$FBH" ] || S=scaled
	echo "$W $H $SFPS $S ${FBW}x${FBH}" > /run/rudolf/screen-actual
	Xvfb :0 -screen 0 ${W}x${H}x24 -fbdir /run/xvfb -nolisten tcp -ac -dpi 96 -nocursor +extension XFIXES +extension XTEST &
	XPID=$!
	for i in $(seq 50); do [ -e /tmp/.X11-unix/X0 ] && break; sleep 0.1; done
	DISPARGS=/run/xvfb/Xvfb_screen0; MODE=soft
	keys_evdev
}
start_gpu() {
	rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock
	Xorg :0 vt1 -config /usr/lib/rudolf/xorg.conf -nolisten tcp -ac -noreset -novtswitch -dpi 96 \
		-logfile /run/rudolf/Xorg.log -verbose 3 &
	XPID=$!
	for i in $(seq 150); do [ -e /tmp/.X11-unix/X0 ] && break; kill -0 $XPID 2>/dev/null || break; sleep 0.1; done
	if [ -e /tmp/.X11-unix/X0 ] && kill -0 $XPID 2>/dev/null && rudolf-display --xsize >/dev/null 2>&1; then
		# the chosen resolution and refresh rate: the monitor's mode of that size; a size the monitor does not
		# have is scaled by the software display instead (Xorg's own scaling does not work on every card)
		rudolf-display --mode "$RES" "$FPS"; RC=$?
		if [ $RC = 3 ]; then
			REASON="the monitor has no $RES mode, so the software display scales the desktop"
			kill $XPID 2>/dev/null; for i in $(seq 20); do kill -0 $XPID 2>/dev/null || break; sleep 0.5; done; kill -9 $XPID 2>/dev/null
			rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock
			return 1
		fi
		[ $RC = 0 ] || echo "$(date) could not set the screen mode $RES at $FPS Hz"
		S=$(rudolf-display --xsize 2>/dev/null); set -- $S; W=$1; H=$2; DISPARGS=--input; MODE=gpu; keys_evdev
		unset RUDOLF_FPS
		grep -q 'glamor X acceleration enabled\|glamor initialized' /run/rudolf/Xorg.log || REASON="Xorg is running but without glamor acceleration (see Xorg.log)"
		return 0
	fi
	REASON="Xorg did not start (see /run/rudolf/Xorg.log)"
	kill $XPID 2>/dev/null; sleep 0.5; kill -9 $XPID 2>/dev/null
	rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock
	return 1
}
display_up() {
	SETTING=$(cat /etc/rudolf-display 2>/dev/null); SETTING=${SETTING:-games}
	MODE=soft; REASON=""; XPID=""
	read_screen; rm -f /run/rudolf/screen-actual
	if grep -qE 'rudolf.recovery=1|rudolf.nogpu=1|nomodeset|rudolf.softdisplay=1' $RCMD; then REASON="started in recovery or safe graphics mode"
	elif [ "$SETTING" = soft ]; then REASON="Settings: software display"
	elif [ ! -x /usr/bin/Xorg ]; then REASON="this Rudolf OS build has no Xorg"
	elif [ ! -s /run/rudolf/gpu ]; then REASON="no graphics card driver is loaded"
	else start_gpu; fi
	[ $MODE = gpu ] || start_soft
	echo $MODE > /run/rudolf/display-mode; echo "$REASON" > /run/rudolf/display-reason
	echo "$(date) display: $MODE ${W}x${H} $RES $FPS fps $REASON"
	echo "$W $H" > /run/rudolf/screen
	rudolf-display $DISPARGS &
	DISP=$!
	# the desktop renders in software unless Settings say "full" and Xorg is on the graphics card;
	# if the GPU process fails, Chromium falls back to SwiftShader by itself
	GLFLAGS="--use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader --ignore-gpu-blocklist --disable-gpu-compositing"
	[ $MODE = gpu ] && [ "$SETTING" = full ] && GLFLAGS="--use-gl=angle --use-angle=gl-egl --enable-unsafe-swiftshader --ignore-gpu-blocklist"
	echo "$GLFLAGS" > /run/rudolf/glflags   # the browser window for sign-in sites (rudolfd web/open) uses the same
}
# a new resolution or frame rate from Settings: the display starts again (the desktop page reloads)
display_restart() {
	echo "$(date) display: restarting for a new resolution or frame rate"
	pkill -f 'chrom[e].*--class=RudolfWeb'; pkill -f '[-]-rudolf-kiosk'
	for i in 1 2 3 4 5 6; do pgrep -f '[-]-rudolf-kiosk' >/dev/null || break; sleep 1; done
	pkill -9 -f '[-]-rudolf-kiosk'; pkill -9 -f 'chrom[e].*--class=RudolfWeb'
	kill $DISP 2>/dev/null; kill $XPID 2>/dev/null
	# Xorg takes a few seconds to give the screen back; a new one cannot start before the old one has gone
	for i in $(seq 20); do kill -0 $XPID 2>/dev/null || pgrep -x Xorg >/dev/null || pgrep -x Xvfb >/dev/null || break; sleep 0.5; done
	kill -9 $XPID 2>/dev/null; pkill -9 -x Xorg; pkill -9 -x Xvfb; sleep 0.5
	rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock
	display_up
}
rm -f /run/rudolf/screen-restart
display_up
# per-user runtime directory and D-Bus session bus (used by Flatpak apps such as Sober)
export XDG_RUNTIME_DIR=/run/user/1000
mkdir -p $XDG_RUNTIME_DIR && chown 1000:1000 $XDG_RUNTIME_DIR && chmod 700 $XDG_RUNTIME_DIR
if [ -x /usr/bin/dbus-daemon ]; then
	su -s /bin/sh rudolf -c "dbus-daemon --session --fork --nopidfile --address=unix:path=$XDG_RUNTIME_DIR/bus" && export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
fi
# sound server (PulseAudio) for the desktop and Linux apps; Chromium falls back to ALSA without it
/usr/lib/rudolf/sound start && export PULSE_SERVER=unix:$XDG_RUNTIME_DIR/pulse/native
# an update being tried must bring the desktop up within 4 minutes; if not, restart, and after two
# failed starts the start-up script goes back to the previous system
if grep -q 'rudolf.trying=1' $RCMD; then
	( sleep 240; [ -e /run/rudolf/bootok ] || { echo "update did not start: restarting" >> /run/rudolf/update.log; sync; reboot -f; } ) &
fi
# installed rpk packages are read-only images; mount them before the desktop starts
[ -x /usr/bin/rpk ] && /usr/bin/rpk mount-all >>/run/rudolf/rpk.log 2>&1
echo "DISPLAY=$DISPLAY XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP=Rudolf" > /run/rudolf/session.env
# Linux apps: the folders they share with drive C:, and the desktop portal (file dialogs, links,
# notifications) on the session bus; its questions reach the desktop through /run/rudolf/portal
for d in Documents Pictures Downloads; do [ -d /home/rudolf/$d ] || [ -L /home/rudolf/$d ] || { mkdir -p /home/rudolf/$d; chown rudolf:rudolf /home/rudolf/$d; }; done
# website downloads arrive in Downloads/.incoming (Chromium's download folder, set by policy) and the desktop files
# them after its checks (rudolfd: /api/dl/*); a download left unfinished by a restart is removed
# (1.5.1: while Downloads is in the locked encrypted folder, rudolfd makes these when it is unlocked)
# (1.5.6: through /run/rudolf/dl, the downloads store's own bind made by rudolfd at its start, since while an account
# is signed in /home/rudolf/Downloads is that account's own; Chromium's policy points there)
for i in 1 2 3 4 5; do [ -e /run/rudolf/dl ] && break; sleep 1; done
DLS=/run/rudolf/dl; [ -e $DLS ] || DLS=/home/rudolf/Downloads
if [ -d $DLS/ ]; then
mkdir -p $DLS/.incoming $DLS/.quarantine
chown rudolf:rudolf $DLS/.incoming $DLS/.quarantine; chmod 700 $DLS/.quarantine
fi
rm -f $DLS/.incoming/*.crdownload /run/rudolf/dlf/* 2>/dev/null
mkdir -p /run/rudolf/portal/req /run/rudolf/portal/resp /run/rudolf/apps && chown -R rudolf:rudolf /run/rudolf/portal /run/rudolf/apps
[ -x /usr/bin/rudolf-portal ] && [ -n "$DBUS_SESSION_BUS_ADDRESS" ] && su -s /bin/sh rudolf -c "set -a; . /run/rudolf/session.env; set +a; exec setsid /usr/bin/rudolf-portal" </dev/null >>/run/rudolf/portal.log 2>&1 &
PROFILE=/home/rudolf/.rudolf-browser
# Chromium writes an index next to an unpacked extension, so it needs a copy the user owns
EXT=/run/rudolf/frames
rm -rf $EXT; cp -a /usr/lib/rudolf/frames $EXT; chown -R rudolf:rudolf $EXT
# Ruffle for Oracle: plays Flash content on websites in Oracle's tabs
RUF=/run/rudolf/ruffle-ext
rm -rf $RUF; cp -a /usr/lib/rudolf/ruffle-ext $RUF; chown -R rudolf:rudolf $RUF
# ---- the shell (Rudolf OS 1.2): an Isolated Web App around the desktop that gives Oracle real browser tabs.
# Chromium installs it from its file (/usr/share/rudolf/www/iwa, in the desktop layer; see SHELLINST). The session
# starts it instead of the desktop page once it is installed and the desktop has handed its data over
# (/home/rudolf/.rudolf-shell-ready), unless recovery mode, Settings (/etc/rudolf-shell "off") or a failed start
# (/run/rudolf/shell-failed) say no.
SHELLID=$(cat /usr/share/rudolf/www/iwa/id 2>/dev/null)
SHELLPOL=/etc/chromium/policies/managed/rudolf-shell.json
case "$SHELLID" in
[a-z2-7]*) mkdir -p ${SHELLPOL%/*}
	printf '{"IsolatedWebAppInstallForceList":[{"update_manifest_url":"http://127.0.0.1:8080/iwa/update.json","web_bundle_id":"%s"}]}\n' "$SHELLID" > $SHELLPOL;;
*) rm -f $SHELLPOL;;
esac
# The releases take Chromium from Ubuntu, whose Chromium reads its policies from /etc/chromium-browser
mkdir -p /etc/chromium-browser
[ -L /etc/chromium-browser/policies ] || { rm -rf /etc/chromium-browser/policies; ln -s /etc/chromium/policies /etc/chromium-browser/policies; }
# Newer Chromium (155 and later) installs an Isolated Web App by policy only when Google lists it (its "managed
# allowlist"), so the shell is installed from its file, in Isolated Web App developer mode; the policy above stays
# for the Chromium versions without that list. Not in recovery mode, and not when Settings turned the shell off.
SHELLINST=""; SHELLFEAT=""
if [ ${#SHELLID} = 56 ] && [ "$(cat /etc/rudolf-shell 2>/dev/null)" != off ] && ! grep -q 'rudolf.recovery=1' $RCMD && [ -r /usr/share/rudolf/www/iwa/shell.swbn ]; then
	SHELLINST="--install-isolated-web-app-from-file=/usr/share/rudolf/www/iwa/shell.swbn"; SHELLFEAT=",IsolatedWebAppDevMode"
fi
# 1.5.7: the desktop in WebKit (System Settings › Desktop engine › Lite, kept in /persist/etc/rudolf-desktop-engine and
# taken at start-up by rudolf-init into /run/rudolf/engine-choice: a change applies at the next restart of the computer).
# rudolf-webkit (WebKitGTK) is in the system layer; not in recovery mode, and not after it failed this start
# (/run/rudolf/webkit-failed)
webkit_usable() {
	[ "$(cat /run/rudolf/engine-choice 2>/dev/null)" = webkit ] || return 1
	grep -q 'rudolf.recovery=1' $RCMD && return 1
	[ -e /run/rudolf/webkit-failed ] && return 1
	[ -x /usr/bin/rudolf-webkit ]
}
shell_usable() {
	[ ${#SHELLID} = 56 ] || return 1
	grep -q 'rudolf.recovery=1' $RCMD && return 1
	[ "$(cat /etc/rudolf-shell 2>/dev/null)" = off ] && return 1
	[ -e /run/rudolf/shell-failed ] && return 1
	[ -e /home/rudolf/.rudolf-shell-ready ] || return 1
	grep -lqs "$SHELLID" $PROFILE/Default/iwa/*/main.swbn || return 1
}
LOGPOLL=0
DBG=""
grep -q 'rudolf.debug=1' $RCMD && DBG="--enable-logging=stderr --v=0 --remote-debugging-port=9222"
export FONTCONFIG_FILE=/etc/fonts/fonts.conf
# 1.5.6: the major page faults (pages read back from the swap or the disk) of the desktop page and the browser
# 1.5.7: the Lite (WebKit) desktop given up for good: Standard from now on (the choice is removed; Settings says why,
# and the user can choose Lite again). On the Vivobook, Lite closed as it started, every 8 s, and was started again
# without end: the computer never reached the sign-in screen.
webkit_give_up() {
	echo "$(date) the WebKit desktop did not start ($1) - using Chromium"; touch /run/rudolf/webkit-failed
	if [ -e /run/rudolf/persistent ]; then rm -f /persist/etc/rudolf-desktop-engine /persist/etc/rudolf-desktop-engine.trying
		echo "$(date -u +%FT%TZ) $1" > /persist/etc/rudolf-desktop-engine.failed; sync; fi
	rudolfd --health browser "the Lite desktop did not start ($1), so the standard engine is used from now on (Settings › System health › Desktop engine)"
}
# 1.5.7: Lite is on trial until its desktop answers once: a start that never got there (the computer was switched off
# at a grey screen, say) gives it up at the next start. Checked once per start, before the engine is chosen.
webkit_trial_check() {
	[ "$FIRST" = 1 ] && [ -e /persist/etc/rudolf-desktop-engine.trying ] && webkit_usable && webkit_give_up "it did not reach the sign-in screen at the last start"
	FIRST=0
}
webkit_trial_mark() { [ $ENGINE = webkit ] && [ -e /run/rudolf/persistent ] && [ ! -e /persist/etc/rudolf-desktop-engine.trying ] && date -u +%FT%TZ > /persist/etc/rudolf-desktop-engine.trying; return 0; }
# 1.5.8: this start's desktop answered: when (seconds after the computer started) and with which engine, beside the
# start's logs (rudolf-init: var/log/starts/0), for System health's "Last starts"
desk_up_mark() { [ -e /run/rudolf/heartbeat ] || return 0; D=$(cat /run/rudolf/start-logs 2>/dev/null); [ -n "$D" ] && [ -d "$D" ] && [ ! -e "$D/desktop-up" ] && echo "$(cut -d. -f1 /proc/uptime) $ENGINE" > "$D/desktop-up"; return 0; }
webkit_trial_ok() { [ $ENGINE = webkit ] && [ -e /run/rudolf/heartbeat ] && [ -e /persist/etc/rudolf-desktop-engine.trying ] && rm -f /persist/etc/rudolf-desktop-engine.trying; return 0; }
# 1.5.7: a desktop asking for the shell again and again (a USB stick's older desktop on this computer's newer files
# did, every few seconds): after 3 times in 5 minutes the request is ignored and the shell given up until the next start
shell_switch_limit() {
	[ -e /run/rudolf/shell-switch ] || return 0
	W2=$(date +%s); [ $((W2 - SW_T)) -gt 300 ] && { SW_T=$W2; SW_N=0; }; SW_N=$((SW_N + 1))
	[ $SW_N -gt 3 ] || return 0
	rm -f /run/rudolf/shell-switch
	[ -e /run/rudolf/shell-failed ] || { touch /run/rudolf/shell-failed; echo "$(date) the desktop restarted the browser $SW_N times in 5 minutes - no shell until the next start"
		rudolfd --health browser "the desktop kept restarting the browser, so Oracle's real tabs are off until the next start"; }
}
# 1.5.7: the browser ended after RAN seconds. Closed within a minute without the desktop answering, 3 times in a row,
# is a desktop that cannot start: Lite gives way to Standard and the shell to the desktop page. Chromium by itself has
# nothing to fall back to and is reported once (the loop then pauses longer each time, so a broken browser does not spin).
desk_exited() {
	if [ ! -e /run/rudolf/heartbeat ] && [ "$1" -lt 60 ]; then FAST=$((FAST + 1)); else FAST=0; fi
	[ $FAST -ge 3 ] || return 0
	if [ $ENGINE = webkit ]; then webkit_give_up "it closed $FAST times in a row as it started"; FAST=0
	elif [ $SHELLON = 1 ]; then echo "$(date) the shell closed $FAST times as it started - using the desktop page directly"; touch /run/rudolf/shell-failed; FAST=0
	elif [ $FAST = 3 ]; then rudolfd --health browser "the desktop browser closed 3 times in a row as it started"; fi
	return 0
}
desk_faults() { t=0; for p in $(cat /run/rudolf/desktop-renderer 2>/dev/null) $(pgrep -o -f '[-]-rudolf-kiosk'); do
	f=$(sed 's/.*) //' /proc/$p/stat 2>/dev/null | cut -d' ' -f10); t=$((t + ${f:-0})); done; echo $t; }
# 1.5.7: starts that ended within a minute without the desktop answering, in a row; quick shell restarts
FAST=0; FIRST=1; SW_T=0; SW_N=0
while :; do
	[ -e /run/rudolf/power ] && sleep 30
	PROXY=""
	EXTRA=""; [ -s /run/rudolf/browser-flags ] && EXTRA=$(cat /run/rudolf/browser-flags)
	[ -s /run/rudolf/proxy ] && PROXY="--proxy-server=$(cat /run/rudolf/proxy)"
	rm -f /run/rudolf/heartbeat
	START=http://127.0.0.1:8080/; SHELLON=0; LAUNCH=""
	# Chromium opens the shell only when the browser itself asks: rudolf-launch does that over a private pipe
	if shell_usable && [ -x /usr/bin/rudolf-launch ]; then START=""; SHELLON=1; LAUNCH="/usr/bin/rudolf-launch $SHELLID"; fi
	echo "${START:-isolated-app://$SHELLID/}" > /run/rudolf/desktop-url
	# 1.5.7 (plan Part 4, step 2): Settings › System health › Desktop engine: WebKit (WebKitGTK, in Debian), with Chromium
	# kept for browsing. Only when Debian has it and it has not failed this start (then Chromium, as before)
	# 1.5.7: Lite is on trial until its desktop answers once: a start that never got there (the computer was switched
	# off at a grey screen, say) gives it up at the next start
	webkit_trial_check
	ENGINE=chromium; webkit_usable && { ENGINE=webkit; START=http://127.0.0.1:8080/; SHELLON=0; LAUNCH=""; echo "$START" > /run/rudolf/desktop-url; }
	webkit_trial_mark
	echo $ENGINE > /run/rudolf/desktop-engine
	# the web frames extension lets websites load inside the desktop page's frames (it removes their frame protections)
	# and spots sign-in pages; with the shell, Oracle's tabs are real pages and it is left out
	EXTS=$EXT,$RUF; [ $SHELLON = 1 ] && EXTS=$RUF
	# 1.5.8 (plan 9.6): FedCM ("Sign in with Google" buttons) off unless chosen in Oracle's menu (/persist/etc/rudolf-browser.conf)
	FEDCM_OFF=,FedCm; grep -qx 'fedcm=1' /persist/etc/rudolf-browser.conf 2>/dev/null && FEDCM_OFF=
	# 1.5.6: the browser starts in the desktop's memory group (see memory); this loop goes back out right after
	DCG=/sys/fs/cgroup/desktop/cgroup.procs; [ -e $DCG ] && echo $$ > $DCG 2>/dev/null
	if [ $ENGINE = webkit ]; then
		# 1.5.8: like the Chromium desktop (GLFLAGS), WebKit draws with the graphics card only when Settings say "full"
		WKSOFT=--software; [ $MODE = gpu ] && [ "$SETTING" = full ] && WKSOFT=
		su -s /bin/sh rudolf -c "exec /usr/bin/rudolf-webkit --rudolf-kiosk --size=${W}x$H $WKSOFT $START" >>/run/rudolf/webkit-desktop.log 2>&1 &
	else
	# 1.5.8: Chromium 157 never replaces the installed shell from its file ("App is already installed"), so a release's
	# changes to Oracle's tabs never arrived. Once per start, when the profile's copy is not the system's, rudolf-shellfix
	# puts the system's in (Chromium's DevTools over a pipe: removed and installed again; the shell's storage goes with
	# it: the desktop's data comes back from rudolfd's mirror, websites ask to sign in again).
	if [ -n "$SHELLINST" ] && [ ! -e /run/rudolf/shellfix-done ]; then
		touch /run/rudolf/shellfix-done; SAME=0; HAVE=0
		for f in $PROFILE/Default/iwa/*/main.swbn; do [ -f "$f" ] || continue; HAVE=1; cmp -s "$f" /usr/share/rudolf/www/iwa/shell.swbn && SAME=1; done
		if [ $HAVE = 1 ] && [ $SAME = 0 ]; then
			echo "$(date) the shell in the profile is not the system's: replacing it"
			if su -s /bin/sh rudolf -c "exec /usr/bin/rudolf-shellfix /opt/chromium/chrome $PROFILE /usr/share/rudolf/www/iwa/shell.swbn $SHELLID" >>/run/rudolf/shellfix.log 2>&1; then
				echo "$(date) shell replaced"; echo "shell 1" >> /run/rudolf/events
			else echo "$(date) the shell was not replaced (see /run/rudolf/shellfix.log)"; fi
		fi
	fi
	su -s /bin/sh rudolf -c "exec $LAUNCH /opt/chromium/chrome --rudolf-kiosk --class=RudolfDesktop --kiosk --start-fullscreen \
		--window-position=0,0 --window-size=$W,$H --user-data-dir=$PROFILE \
		--no-first-run --no-default-browser-check --noerrdialogs --disable-infobars \
		--disable-session-crashed-bubble --disable-translate --password-store=basic \
		--disable-features=Translate,MediaRouter,DialMediaRouteProvider,OptimizationHints,PrivacySandboxSettings4,Vulkan,WebGPUService,SkiaGraphite,OptimizationGuideOnDeviceModel$FEDCM_OFF --disable-vulkan-surface \
		$GLFLAGS \
		--autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream \
		--auto-select-desktop-capture-source=Entire --enable-features=SharedArrayBuffer,IsolatedWebApps$SHELLFEAT $SHELLINST \
		--load-extension=$EXTS --disable-gpu-watchdog --disk-cache-size=67108864 $PROXY $DBG $EXTRA \
		$START" &
	fi
	B=$!
	[ -e $DCG ] && echo $$ > /sys/fs/cgroup/cgroup.procs 2>/dev/null
	START_T=$(cut -d. -f1 /proc/uptime)
	# watchdog: the desktop sends a heartbeat every few seconds
	# 1.5.6: after sleep the heartbeat is as old as the sleep (on the Vivobook 5722 s), and the browser was restarted
	# on waking, closing every window: a gap in this loop's own clock means the computer slept, and the desktop gets
	# 90 s to send its heartbeat again
	LASTW=$(date +%s); GRACE=0; MF0=0; BUSY_T=0; FRONT_T=0; WM0=desktop
	while kill -0 $B 2>/dev/null; do
		for i in 1 2 3 4 5; do sleep 2; [ -e /run/rudolf/screen-restart ] || [ -e /run/rudolf/shell-switch ] && break; done
		W=$(date +%s); if [ $((W - LASTW)) -gt 40 ]; then echo "$(date) woke after $((W - LASTW)) s - the desktop has 90 s to answer"; GRACE=$((W + 90)); fi; LASTW=$W
		if [ -e /run/rudolf/screen-restart ]; then rm -f /run/rudolf/screen-restart; display_restart; break; fi
		webkit_trial_ok; desk_up_mark; shell_switch_limit
		# the desktop has handed its data over (or Settings changed): start the browser again, with the shell if it can
		if [ -e /run/rudolf/shell-switch ]; then rm -f /run/rudolf/shell-switch; echo "$(date) starting the browser again (shell)"
			pkill -f '[-]-rudolf-kiosk'; for i in 1 2 3 4 5 6; do kill -0 $B 2>/dev/null || break; sleep 1; done; pkill -9 -f '[-]-rudolf-kiosk'; break; fi
		NOW=$(cut -d. -f1 /proc/uptime)
		# 1.5.6: is the desktop working its way back? Its pages being read back from the compressed swap (major faults
		# of the desktop page and the browser) or the whole computer waiting for memory (PSI) count as busy
		MF=$(desk_faults); [ $MF -gt $MF0 ] && [ $MF0 -gt 0 ] && BUSY_T=$W; MF0=$MF
		# 1.5.6: the moment the desktop came back in front (an app or a game closed or put aside): see FRONT_T below
		WMN=$(cut -d' ' -f1 /run/rudolf/wm 2>/dev/null); [ "$WMN" = desktop ] && [ "$WM0" != desktop ] && FRONT_T=$W; WM0=${WMN:-desktop}
		[ "$(sed -n 's/^full avg10=\([0-9]*\).*/\1/p' /proc/pressure/memory 2>/dev/null)" -ge 10 ] 2>/dev/null && BUSY_T=$W
		# 1.5.7: the WebKit desktop did not come up (no heartbeat in 90 s): Chromium from now on (until restart)
		if [ $ENGINE = webkit ] && [ $((NOW - START_T)) -gt 90 ] && [ ! -e /run/rudolf/heartbeat ]; then
			webkit_give_up "no answer from it in 90 s"
			kill $B 2>/dev/null; pkill -f '[-]-rudolf-kiosk'; sleep 3; pkill -9 -f '[-]-rudolf-kiosk'; break
		fi
		# the shell did not bring the desktop up: use the desktop page by itself from now on (until restart)
		if [ $SHELLON = 1 ] && [ $((NOW - START_T)) -gt 90 ] && [ ! -e /run/rudolf/heartbeat ]; then
			echo "$(date) the shell did not start the desktop - using the desktop page directly"
			touch /run/rudolf/shell-failed; pkill -f '[-]-rudolf-kiosk'; sleep 3; pkill -9 -f '[-]-rudolf-kiosk'
		fi
		if [ $((NOW - START_T)) -gt 120 ]; then
			if [ -e /run/rudolf/heartbeat ]; then
				MT=$(stat -c %Y /run/rudolf/heartbeat); AGE=$(( $(date +%s) - MT ))
				# 1.4.7: while memory is critical the memory guard is ending the largest page: give it 2 minutes
				# before restarting the browser (that closes every window and tab)
				LIM=60; MC=99999; [ -e /run/rudolf/memguard.critical ] && MC=$(( $(date +%s) - $(stat -c %Y /run/rudolf/memguard.critical) ))
				[ $MC -lt 30 ] && LIM=120
				# 1.5.6: and 5 minutes while an app or a game is in front and memory ran short in the last 5 minutes:
				# the desktop is behind it. On the Vivobook the browser was restarted 126 s into a memory shortage with
				# Among Us in front, and memory came back 15 s later
				case "$(cat /run/rudolf/wm 2>/dev/null)" in "win "*|game|web) [ $MC -lt 300 ] && LIM=300;; esac
				# 1.5.6: and 5 minutes while it is busy getting its memory back (see above): on the Vivobook closing Steam
				# left the desktop white while it did, and it was restarted after 62 s (memory never reached critical)
				[ $((W - BUSY_T)) -lt 30 ] && [ $LIM -lt 300 ] && LIM=300
				[ $W -lt $GRACE ] && [ $((W - MT)) -gt $LIM ] && AGE=0   # just woke: not yet
				# 1.5.6: behind a game, the desktop's page is hidden, and Chromium slows or freezes a hidden page's timers
				# (more so when memory is short), so its heartbeat stops. On the Vivobook, memory ran short with a Steam
				# game in front; the last heartbeat was 213 s old when the game and Steam were closed, the limit fell from
				# 5 minutes to 60 s at that moment, and the browser was restarted at once (back to the sign-in screen).
				# Back in front, the desktop is judged from that moment: LIM seconds to answer. Behind an app or a game it
				# is not judged at all (restarting it would close every window, the game's included)
				[ $FRONT_T -gt $MT ] && AGE=$((W - FRONT_T))
				case "$WMN" in win|game|web) AGE=0;; esac
				if [ $AGE -gt $LIM ]; then echo "$(date) desktop not responding for ${AGE}s - restarting browser"; rudolfd --health browser "the desktop stopped responding for ${AGE} s, so the browser was restarted"; pkill -f '[-]-rudolf-kiosk'; sleep 3; pkill -9 -f '[-]-rudolf-kiosk'; fi
			fi
		fi
		if [ $MODE = gpu ] && ! kill -0 $XPID 2>/dev/null; then
			echo "$(date) Xorg stopped - switching to the software display"
			rudolfd --health crash "the graphics server (Xorg) stopped; the software display took over"
			REASON="Xorg stopped unexpectedly (see /run/rudolf/Xorg.log)"; kill $DISP 2>/dev/null
			pkill -f '[-]-rudolf-kiosk'; start_soft
			echo soft > /run/rudolf/display-mode; echo "$REASON" > /run/rudolf/display-reason
			GLFLAGS="--use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader --ignore-gpu-blocklist --disable-gpu-compositing"
			rudolf-display $DISPARGS & DISP=$!
		fi
		kill -0 $DISP 2>/dev/null || { rudolf-display $DISPARGS & DISP=$!; }
	done
	echo "$(date) browser exited"
	# 1.5.7: closed within a minute without the desktop answering: 3 times in a row is a desktop that cannot start.
	# Lite gives way to Standard and the shell to the desktop page; Chromium by itself has nothing to fall back to and
	# is only reported (with the pause below growing, so a broken browser does not spin)
	desk_exited $(( $(cut -d. -f1 /proc/uptime) - START_T ))
	[ $FAST -ge 3 ] && sleep $(( FAST > 12 ? 30 : FAST * 2 ))
	sleep 1
done
