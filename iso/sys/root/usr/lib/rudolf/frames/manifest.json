{
 "manifest_version": 3,
 "name": "Rudolf OS web frames",
 "version": "1.1",
 "description": "Lets the Oracle browser inside Rudolf OS show websites in its tabs, and notices sign-in pages so Oracle can move them to a real browser window.",
 "permissions": ["declarativeNetRequest"],
 "host_permissions": ["<all_urls>"],
 "background": {"service_worker": "sw.js"},
 "declarative_net_request": {"rule_resources": [{"id": "frames", "enabled": true, "path": "rules.json"}]},
 "content_scripts": [
  {"matches": ["http://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": false},
  {"matches": ["<all_urls>"], "exclude_matches": ["http://127.0.0.1/*"], "js": ["signin.js"], "run_at": "document_start", "all_frames": true},
  {"matches": ["<all_urls>"], "exclude_matches": ["http://127.0.0.1/*"], "js": ["signin-page.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN"}
 ]
}
