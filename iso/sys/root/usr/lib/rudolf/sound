#!/bin/sh
# Rudolf OS sound server. PulseAudio runs as the desktop user and opens every sound card; the
# desktop (Chromium) and Linux apps such as Sober play through it. If it cannot start, Chromium
# falls back to ALSA directly, as before.
#   sound start       start PulseAudio (called by the session)
#   sound default N   make card N the default output (Settings > Sound)
#   sound restart     stop it and start it again (Task Manager)
#   sound status      print the server state, cards and outputs
#   sound hotplug     a sound card came or went (mdev, with ACTION and MDEV=snd/controlCN; 1.5.4)
#   sound codec-check a chip that did not answer at start-up is reset, once (1.5.8; rudolf-init)
# GPL-2.0-or-later.
export PATH=${RUDOLF_TEST_PATH:+$RUDOLF_TEST_PATH:}/usr/sbin:/usr/bin:/sbin:/bin
# test hooks (iso/qt/host/soundplug_t.sh): RUDOLF_TEST_PATH, RUDOLF_TEST_ASOUND, RUDOLF_SOUND_WAIT, RUDOLF_SOUND_SETTLE
ASND=${RUDOLF_TEST_ASOUND:-/proc/asound}
RCMD=/etc/rudolf/cmdline; [ -s $RCMD ] || RCMD=/proc/cmdline   # the start-up options (1.2.8: not /proc/cmdline, see initramfs/init)
export XDG_RUNTIME_DIR=/run/user/1000
SOCK=$XDG_RUNTIME_DIR/pulse/native
PA=/run/rudolf/pulse.pa
LOG=/run/rudolf/pulse.log
asuser() { su -s /bin/sh rudolf -c "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR PULSE_SERVER=unix:$SOCK $1"; }
cards() { sed -n 's/^ *\([0-9][0-9]*\) \[.*/\1/p' $ASND/cards 2>/dev/null; }
# 1.5.4: ALSA's use case files (alsa-ucm-conf) set up sound processors (Intel SOF, AMD ACP) and USB sound cards;
# plain HD Audio cards keep PulseAudio's own profiles, as before, since they work that way
cardargs() {
	a="device_id=$1 name=card$1 tsched=1 deferred_volume=0"
	case "$(sed -n "s/^ *$1 \[[^]]*\]: \([^ ]*\) .*/\1/p" $ASND/cards 2>/dev/null)" in HDA-Intel) a="$a use_ucm=0";; esac
	echo "$a"
}
# the module-alsa-card loaded for card $1, if any
cardmod() { asuser "pactl list short modules" 2>/dev/null | awk -v a="device_id=$1 " '$2=="module-alsa-card" && index($0 " ", a) {print $1}'; }
# ALSA starts every card muted at its lowest volume and nothing else restores the mixer, so open each output fully
# (volume is set in the desktop and in each app) and the inputs at 80%; $1: only card N's
open_outputs() {
	asuser "pactl list short sinks" 2>/dev/null | awk -v p="alsa_output.card$1" '$1 != "" && (p == "alsa_output.card" || index($2, p ".") == 1) {print $2}' | while read -r k; do
		asuser "pactl set-sink-mute $k 0"; asuser "pactl set-sink-volume $k 100%"
	done
	asuser "pactl list short sources" 2>/dev/null | awk -v p="alsa_input.card$1" '$2 !~ /\.monitor$/ && (p == "alsa_input.card" || index($2, p ".") == 1) {print $2}' | while read -r k; do
		asuser "pactl set-source-mute $k 0"; asuser "pactl set-source-volume $k 80%"
	done
}
# a card PulseAudio does not have yet (one that came while it was starting, or later)
add_card() {
	[ -n "$(cardmod "$1")" ] && return 0
	a=$(cardargs "$1")
	# 1.5.5: a card whose use case file does not work with it (the Vivobook's AMD microphones, acp6x: "Module
	# initialization failed") is opened again with PulseAudio's own profiles, as before 1.5.4
	if ! asuser "pactl load-module module-alsa-card $a" >/dev/null 2>&1; then
		case "$a" in *use_ucm=0*) echo "sound: card $1 could not be opened" >> $LOG; return 1;; esac
		asuser "pactl load-module module-alsa-card $a use_ucm=0" >/dev/null 2>&1 || { echo "sound: card $1 could not be opened" >> $LOG; return 1; }
		echo "sound: card $1 opened without its use case file" >> $LOG
	fi
	open_outputs "$1"
}
set_default() {
	S=$(asuser "pactl list short sinks" 2>/dev/null | awk -v p="alsa_output.card$1." 'index($2,p)==1{print $2; exit}')
	[ -n "$S" ] && asuser "pactl set-default-sink $S" && echo "default output: $S"
	# 1.5.9 (plan 7.2): what plays now moves too (a call does not drop when the output changes), and the same card's
	# microphone becomes the default one, with what records from it (the call's microphone)
	[ -n "$S" ] && for i in $(asuser "pactl list short sink-inputs" 2>/dev/null | cut -f1); do asuser "pactl move-sink-input $i $S" >/dev/null 2>&1; done
	M=$(asuser "pactl list short sources" 2>/dev/null | awk -v p="alsa_input.card$1." 'index($2,p)==1{print $2; exit}')
	if [ -n "$M" ]; then asuser "pactl set-default-source $M" >/dev/null 2>&1 && echo "default microphone: $M"
		for i in $(asuser "pactl list short source-outputs" 2>/dev/null | cut -f1); do asuser "pactl move-source-output $i $M" >/dev/null 2>&1; done; fi
	return 0
}
case "$1" in
start)
	command -v pulseaudio >/dev/null || exit 0
	grep -q 'rudolf.nosound=1' $RCMD && exit 0
	{
		echo ".fail"
		echo "load-module module-device-restore"
		echo "load-module module-stream-restore"
		echo "load-module module-card-restore"
		echo "load-module module-augment-properties"
		echo ".nofail"
		for n in $(cards); do echo "load-module module-alsa-card $(cardargs $n)"; done
		echo ".fail"
		echo "load-module module-native-protocol-unix auth-anonymous=1"
		echo "load-module module-default-device-restore"
		echo "load-module module-always-sink"
		echo "load-module module-intended-roles"
		echo "load-module module-suspend-on-idle"
		echo "load-module module-position-event-sounds"
		echo "load-module module-switch-on-port-available"
		# 1.5.9 (plan 7.2): a headset plugged in (USB, Bluetooth) takes over what plays and records, during a call too
		echo "load-module module-switch-on-connect"
	} > $PA
	: > $LOG; chown rudolf $LOG
	asuser "pulseaudio --daemonize=yes -n -F $PA --exit-idle-time=-1 --log-target=file:$LOG" || echo "pulseaudio failed to start" >> $LOG
	for i in $(seq 50); do [ -S $SOCK ] && break; sleep 0.1; done
	[ -S $SOCK ] || exit 1
	open_outputs
	for n in $(cards); do add_card "$n"; done
	N=$(sed -n 's/^defaults.pcm.card \([0-9]*\)/\1/p' /etc/asound.conf 2>/dev/null)
	[ -n "$N" ] && set_default "$N"
	exit 0;;
hotplug)
	# 1.5.4: Intel's sound processor shows its card only once its firmware runs, often after the session started,
	# and a USB headset can come and go; nothing else told PulseAudio (it runs without udev)
	[ -S $SOCK ] || exit 0
	n=${MDEV##*controlC}; case "$n" in ''|*[!0-9]*) exit 0;; esac
	if [ "$ACTION" = remove ]; then
		for m in $(cardmod "$n"); do asuser "pactl unload-module $m"; done
		exit 0
	fi
	# the control device comes first; wait (in the background, mdev waits for this) for the card's sound devices
	(
		for i in $(seq ${RUDOLF_SOUND_WAIT:-30}); do [ -n "$(ls $ASND/card$n 2>/dev/null | grep '^pcm')" ] && break; sleep 0.2; done
		sleep ${RUDOLF_SOUND_SETTLE:-1}
		add_card "$n"
	) </dev/null >/dev/null 2>&1 &
	exit 0;;
default)
	[ -S $SOCK ] || exit 1
	set_default "$2";;
status)
	[ -S $SOCK ] || { echo "sound server not running"; exit 1; }
	asuser "pactl info" | grep -E 'Server Name|Server Version|Default Sink|Default Source'
	echo; asuser "pactl list short cards"; echo; asuser "pactl list short sinks";;
restart)
	# Task Manager: the sound server stopped answering; Chromium reconnects by itself
	pkill -u rudolf -x pulseaudio; for i in 1 2 3 4 5; do pgrep -u rudolf -x pulseaudio >/dev/null || break; sleep 1; done
	pkill -9 -u rudolf -x pulseaudio; rm -f $SOCK
	exec "$0" start;;
codec-check)
	# 1.5.8: an HD Audio controller whose chip did not answer at start-up ("no codecs initialized": on the Vivobook,
	# after forced power-offs, the speakers' chip had no card at all): its driver is let go of it and takes it again,
	# once per start; the new card reaches the sound server like a plugged-in one (hotplug). Run by rudolf-init after
	# start-up. RUDOLF_TEST_DMESG (a file), RUDOLF_TEST_PCI, RUDOLF_TEST_DRV, RUDOLF_TEST_RUN, RUDOLF_SOUND_RESET_WAIT: for the host test.
	PCI=${RUDOLF_TEST_PCI:-/sys/bus/pci/devices}; DRV=${RUDOLF_TEST_DRV:-/sys/bus/pci/drivers/snd_hda_intel}
	{ [ -n "$RUDOLF_TEST_DMESG" ] && cat "$RUDOLF_TEST_DMESG" || dmesg; } 2>/dev/null | sed -n 's/.*snd_hda_intel \([0-9a-f:.]*\): no codecs initialized.*/\1/p' | sort -u | while read a; do
		[ -e ${RUDOLF_TEST_RUN:-/run/rudolf}/codec-reset-$a ] && continue; : > ${RUDOLF_TEST_RUN:-/run/rudolf}/codec-reset-$a
		ls -d $PCI/$a/sound/card* >/dev/null 2>&1 && continue   # (it has a card by now)
		echo "$a" > $DRV/unbind 2>/dev/null; sleep 1; echo "$a" > $DRV/bind 2>/dev/null
		for i in $(seq ${RUDOLF_SOUND_RESET_WAIT:-10}); do ls -d $PCI/$a/sound/card* >/dev/null 2>&1 && break; sleep 1; done
		if ls -d $PCI/$a/sound/card* >/dev/null 2>&1; then echo "sound: the chip at $a did not answer at start-up; reset, it works now"
			rudolfd --health hardware "the sound chip did not answer at start-up; it was reset and works now" >/dev/null 2>&1
		else echo "sound: the chip at $a still does not answer"
			rudolfd --health hardware "the sound chip did not answer at start-up: shut the computer down fully (not Restart), wait 10 seconds and turn it on" >/dev/null 2>&1; fi
	done;;
*) echo "usage: sound start|restart|default N|status|hotplug|codec-check"; exit 2;;
esac
