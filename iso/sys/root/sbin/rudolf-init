#!/bin/sh
# Rudolf OS system start (PID 1 after the initramfs). GPL-2.0-or-later.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
RCMD=/etc/rudolf/cmdline; [ -s $RCMD ] || RCMD=/proc/cmdline   # the start-up options (1.2.8: not /proc/cmdline, see initramfs/init)
export HOME=/root
mount -t tmpfs -o mode=0755,nosuid tmpfs /run
mount -t tmpfs -o mode=1777,nosuid tmpfs /tmp
mkdir -p /run/rudolf /run/xvfb /tmp/.X11-unix /dev/shm /media
# 1.6.1 (docs/plan-1.6.1.md Part 12): where the start-up's time goes, step by step: the uptime when each step ended, in
# /run/rudolf/startup-times (kept with the start's logs, and in Settings › System health › Last starts). After an update's
# handover (kexec) this kernel's uptime starts again at 0: what the boot files' kernel and start-up image took before it
# comes in as rudolf.t0= (initramfs/init)
st() { echo "$(cut -d' ' -f1 /proc/uptime) $*" >> /run/rudolf/startup-times; }
T0=$(tr ' ' '\n' < $RCMD | sed -n 's/^rudolf\.t0=\([0-9.]*\)$/\1/p' | head -1); [ -n "$T0" ] && echo "t0 $T0 before the handover (the boot files' kernel and start-up image)" > /run/rudolf/startup-times
st "kernel and start-up image"
# 1.6.0 (plan Part 11): apps' requests to keep the screen on or the computer awake (rudolf-portal writes them; anyone may
# add one, only its owner removes it, only root lists them)
mkdir -p /run/rudolf/inhibit && chmod 1733 /run/rudolf/inhibit
# 1.6.1 (plan-1.6.1 Part 19): games' GameMode requests (rudolf-portal), as the inhibit requests: anyone may add, only root lists
mkdir -p /run/rudolf/game-req && chmod 1733 /run/rudolf/game-req
chmod 1777 /tmp/.X11-unix
mkdir -p /var/tmp; chmod 1777 /tmp /var/tmp
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
# 1.5.6: the standard links into /proc (devtmpfs and mdev do not make them): bash's process substitution, "cat
# /dev/stdin" and Steam's runtime (its logger failed on /dev/fd/63, and Steam's interface did not come up) need them
[ -e /dev/fd ] || ln -s /proc/self/fd /dev/fd; for n in 0:stdin 1:stdout 2:stderr; do [ -e /dev/${n#*:} ] || ln -s /proc/self/fd/${n%%:*} /dev/${n#*:}; done
hostname rudolf
ip link set lo up
hwclock -s -u 2>/dev/null
/usr/lib/rudolf/clockfloor 2>/dev/null   # 1.4.4: never earlier than this release (a hardware clock that lost its time)
# 1.6.0 (docs/plan-1.6.0.md Part 13): the signed system extensions installed on this computer, laid over the unchanged
# base read-only (/usr/lib/rudolf/sysext), before the devices are set up, so their udev rules, firmware and kernel
# modules are there for them; none in Recovery mode, with rudolf.noext=1, or once when asked in Settings
# (the data partition is marked as in use first, so what the assembly says (an extension left out, a start script
#  stopped) goes to the health log there, which System health shows, and not to one in /run that nothing reads: found
#  in QEMU, qt/sb/t160x_t.py)
mountpoint -q /persist && touch /run/rudolf/persistent
[ -x /usr/lib/rudolf/sysext ] && mountpoint -q /persist && RPK_ROOT=/persist/pkg /usr/lib/rudolf/sysext assemble >>/run/rudolf/sysext.log 2>&1
st "system extensions"
# 1.6.0 (docs/plan-1.6.0.md Part 9): devices through udev (systemd-udevd on its own): its rules (/usr/lib/udev/rules.d,
# Rudolf OS's own in 90-rudolf.rules, which run the scripts mdev ran), its hardware database, and the device database
# Linux software reads (libudev: ModemManager, SDL and Steam's controllers, PipeWire, Flatpak apps). The devices already
# there are announced again (coldplug) and waited for, at most 15 s. If udevd cannot start (or rudolf.udev=0 is given),
# mdev does as before, and System health says so (/run/rudolf/devices: "udev" or "mdev REASON").
UDEVD=/usr/lib/systemd/systemd-udevd
dev_mdev() { echo "mdev $1" > /run/rudolf/devices; mdev -s; mdev -d 2>/dev/null; }
if grep -q rudolf.udev=0 $RCMD; then dev_mdev "(rudolf.udev=0 was given at start-up)"
elif [ ! -x $UDEVD ] || ! command -v udevadm >/dev/null; then dev_mdev "(udev is not part of this build)"
elif $UDEVD --daemon --resolve-names=early 2>>/run/rudolf/udev.log && udevadm control --ping --timeout=5 2>>/run/rudolf/udev.log; then
	echo udev > /run/rudolf/devices
	udevadm trigger --type=subsystems --action=add 2>>/run/rudolf/udev.log
	udevadm trigger --type=devices --action=add 2>>/run/rudolf/udev.log
	udevadm settle --timeout=15 2>>/run/rudolf/udev.log || echo "$(date) udev: devices still being set up after 15 s, starting anyway" >> /run/rudolf/udev.log
else
	pkill -x systemd-udevd 2>/dev/null; dev_mdev "(udevd did not start: see /run/rudolf/udev.log)"
fi
st "devices ($(cut -d' ' -f1 /run/rudolf/devices))"
# (1.5.9: on ARM64 the serial port is ttyAMA0, QEMU's virt machine and most ARM boards; x86 has none)
DBGTTY=/dev/ttyS0; [ -c /dev/ttyAMA0 ] && DBGTTY=/dev/ttyAMA0
grep -q rudolf.debug=1 $RCMD && ( while :; do setsid sh -c "exec sh -l <$DBGTTY >$DBGTTY 2>&1"; sleep 1; done ) &
# (1.5.9: with rudolf.debug=1, each step of the start-up is written to /run/rudolf/init-trace.log, to find where a
#  start-up stops: the ARM64 check's never reached the session)
grep -q rudolf.debug=1 $RCMD && { exec 2>>/run/rudolf/init-trace.log; set -x; }
[ -s /etc/rudolf/check.txt ] && cp /etc/rudolf/check.txt /run/rudolf/check.txt

# saved data
if mountpoint -q /persist; then
	touch /run/rudolf/persistent
	# 1.4.5: when this start began (the time since the last shutdown's last step is the firmware's and the kernel's)
	mkdir -p /persist/var/log && echo "$(date -u '+%F %T') start uptime=$(cut -d' ' -f1 /proc/uptime)" >> /persist/var/log/shutdown.log
	mkdir -p /persist/home/rudolf /persist/etc /persist/os
	chown 1000:1000 /persist/home/rudolf
	mount --bind /persist/home/rudolf /home/rudolf
	[ -f /persist/etc/asound.conf ] && cp /persist/etc/asound.conf /etc/asound.conf
	[ -f /persist/etc/rudolf-display ] && cp /persist/etc/rudolf-display /etc/rudolf-display
	[ -f /persist/etc/rudolf-screen ] && cp /persist/etc/rudolf-screen /etc/rudolf-screen
	[ -f /persist/etc/rudolf-monitors ] && cp /persist/etc/rudolf-monitors /etc/rudolf-monitors   # (1.6.1 Part 1: the monitors' arrangements)
	[ -f /persist/etc/rudolf-shell ] && cp /persist/etc/rudolf-shell /etc/rudolf-shell
	# 1.5.7: the desktop engine (System Settings): taken now, so a change applies at the next restart of the computer
	[ -f /persist/etc/rudolf-desktop-engine ] && cp /persist/etc/rudolf-desktop-engine /run/rudolf/engine-choice
	# 1.2.8: the camera switched off in Settings > Privacy: its driver is not loaded
	[ -f /persist/etc/camera-off ] && /usr/lib/rudolf/camera start
	rm -f /persist/etc/decktest   # 1.4.5: the Cyberdeck test mode is gone (it only ever lasted until a restart)
	[ -f /persist/proxy ] && cp /persist/proxy /run/rudolf/proxy
	# native apps (Flatpak: Sober for Roblox) live on the data partition
	# 1.5.0: Flatpak apps moved into the encrypted folder are mounted by rudolfd when it is unlocked at sign-in
	[ -L /persist/flatpak ] || { mkdir -p /persist/flatpak && mount --bind /persist/flatpak /var/lib/flatpak; }
	# 1.2.7: Flatpak's repository has its own tmp folder (OSTree makes its temporary files there), which an
	# installation updated from an older disc may lack; nothing is erased here (Settings > Apps > Linux > Check)
	[ -d /persist/flatpak/repo ] && [ ! -d /persist/flatpak/repo/tmp ] && mkdir -p /persist/flatpak/repo/tmp && echo "repaired: /persist/flatpak/repo/tmp" >> /run/rudolf/repairs
	[ -s /persist/etc/machine-id ] || dbus-uuidgen > /persist/etc/machine-id 2>/dev/null
	cp /persist/etc/machine-id /etc/machine-id 2>/dev/null
else
	mount -t tmpfs -o mode=0700,uid=1000,gid=1000 tmpfs /home/rudolf
fi
st "data partition"
# 1.5.9 (plan Part 3): a system without Chromium (the first ARM64 builds) has one desktop engine: Lite
{ [ -x /opt/chromium/chrome ] && ! grep -q 'rudolf.lite=1' $RCMD; } || { mkdir -p /run/rudolf; echo webkit > /run/rudolf/engine-choice; }   # (rudolf.lite=1: Lite for this start, as the ARM64 boot check uses)
/usr/lib/rudolf/memory 2>/dev/null   # 1.4.7: compressed swap in memory, no thrashing (1.5.7: after /persist, for its setting)
st "memory"
# (1.5.1: not while Downloads is a link into the encrypted folder, which is locked until someone signs in: mkdir
# failed there with "No such file or directory" on the start-up screen; rudolfd makes its folders at the unlock)
[ -L /home/rudolf/Downloads ] || { mkdir -p /home/rudolf/Downloads && chown 1000:1000 /home/rudolf/Downloads; }

[ -s /etc/machine-id ] || dbus-uuidgen > /etc/machine-id 2>/dev/null

# graphics card driver first, so the screen the desktop starts on is the final one
# (it replaces the firmware framebuffer, usually at the screen's native resolution).
# Recovery mode, "nomodeset" and rudolf.nogpu=1 keep the basic firmware framebuffer.
NOGPU=; grep -qE 'rudolf.recovery=1|rudolf.nogpu=1|nomodeset' $RCMD && NOGPU=1
# 1.6.1 (docs/plan-1.6.1.md Part 19): NVIDIA's own driver when chosen in Settings › Display › Graphics driver (its signed
# system extension, its modules checked by the kernel), otherwise its files kept from loading; back to the open driver by
# itself when it cannot be used. Nothing in Recovery mode or safe graphics (gpudriver checks the start-up options too)
[ -z "$NOGPU" ] && [ -x /usr/lib/rudolf/gpudriver ] && /usr/lib/rudolf/gpudriver boot >> /run/rudolf/gpudriver.log 2>&1
if [ -z "$NOGPU" ]; then
	FB0=$(cat /sys/class/graphics/fb0/name 2>/dev/null)
	for d in /sys/bus/pci/devices/*; do
		case "$(cat $d/class 2>/dev/null)" in 0x03*) modprobe -q -b "$(cat $d/modalias)" 2>/dev/null;; esac
	done
	if grep -qE '^(i915|xe|amdgpu|radeon|nouveau|bochs|qxl|vmwgfx|gma500_gfx|ast|mgag200|virtio_gpu|nvidia_drm) ' /proc/modules; then
		# the driver replaces the firmware framebuffer; wait (up to 6 s) for its own fb0. NVIDIA cards from the
		# GeForce 20 series on first start their GSP processor from a 30-60 MB firmware file: up to 15 s (1.2.3)
		T=60; grep -qE '^(nouveau|nvidia_drm) ' /proc/modules && T=150
		for i in $(seq $T); do N=$(cat /sys/class/graphics/fb0/name 2>/dev/null); [ -n "$N" ] && [ "$N" != "$FB0" ] && break; sleep 0.1; done
		sleep 0.3
		cat /sys/class/graphics/fb0/name > /run/rudolf/gpu 2>/dev/null
	fi
fi
st "graphics driver ($(cat /run/rudolf/gpu 2>/dev/null || echo none))"

# load drivers for hardware that was found (Wi-Fi and others built as modules)
for m in $(cat /sys/bus/*/devices/*/modalias 2>/dev/null | sort -u); do
	case "$m" in pci:*bc03sc*) [ -n "$NOGPU" ] && continue;; esac   # graphics: handled above
	modprobe -q -b "$m" 2>/dev/null
done &

# 1.5.4: games (Steam's Proton): more memory maps than the kernel's default (some games stop without them), and
# room for more open files (Proton's esync raises its own limit up to this one; other programs keep the usual 1024)
echo 1048576 > /proc/sys/vm/max_map_count 2>/dev/null
ulimit -H -n 524288 2>/dev/null
# 1.5.0: the firewall for incoming connections, before any network is up (Settings › Security)
/usr/lib/rudolf/firewall start 2>/run/rudolf/firewall.err || echo "firewall: $(cat /run/rudolf/firewall.err)" >> /run/rudolf/repairs
# wired network: DHCP on every cable that is plugged in (1.5.8: and on adapters plugged in later, from mdev; and the
# data used on metered connections: /usr/lib/rudolf/netplug)
/usr/lib/rudolf/netplug boot >/dev/null 2>&1 &
# Wi-Fi: start when the adapter's driver is up, and join saved networks
/usr/lib/rudolf/wifi.sh boot >/dev/null 2>&1 &
# 1.5.1: Bluetooth, when the computer has an adapter (its driver is a module: it comes with the others above)
/usr/lib/rudolf/bluetooth boot >/dev/null 2>&1 &
# 1.5.4: Thunderbolt and USB4 devices already plugged in at start-up (later ones: mdev)
[ -d /sys/bus/thunderbolt ] && ( sleep 3; /usr/lib/rudolf/thunderbolt boot >/dev/null 2>&1 ) &
# 1.5.8: a sound chip that did not answer at start-up is reset once (the driver lets go of it and takes it again)
( sleep 12; /usr/lib/rudolf/sound codec-check >> /run/rudolf/sound-reset.log 2>&1 ) &
# 1.5.3: the first start on a computer: a health-log line with the devices that have no driver (after a minute,
# when USB devices and driver modules have settled)
( sleep 60; /usr/lib/rudolf/devplug hwlog >/dev/null 2>&1 ) &

# 1.5.8: each start's logs are kept on the disk for this start and the 3 before it (var/log/starts/0 is this one, 3
# the oldest), written as they happen: the session, the Lite desktop, Xorg, the development link, the kernel's
# messages, and what the start-up decided. A start whose desktop never came up can be read at the next one (on the
# Vivobook, the Lite desktop's grey screen left nothing: its logs were in /run, lost at each restart).
# STARTS_PERSIST, STARTS_RUN, STARTS_ETC: other places, for the host test (qt/host/startlogs58_t.sh).
starts_keep() {
	SK_P=${STARTS_PERSIST:-/persist}; SK_S=$SK_P/var/log/starts; SK_R=${STARTS_RUN:-/run/rudolf}; SK_E=${STARTS_ETC:-/etc/rudolf}
	mkdir -p $SK_S && chmod 700 $SK_S; rm -rf $SK_S/3; for i in 2 1 0; do [ -d $SK_S/$i ] && mv $SK_S/$i $SK_S/$((i + 1)); done; mkdir -p $SK_S/0
	SK_SL=$(cat $SK_E/slot 2>/dev/null)
	{ echo "time=$(date -u +%FT%TZ)"; echo "slot=$SK_SL"; echo "release=$(sed -n 's/^serial //p' $SK_P/os/system/$SK_SL/RELEASE 2>/dev/null)"
	  echo "entry=$(cat $SK_E/boot-entry 2>/dev/null)"; echo "options=$(cat $SK_E/cmdline 2>/dev/null)"; } > $SK_S/0/start.txt
	cp $SK_E/initramfs.log $SK_S/0/initramfs.log 2>/dev/null
	tail -n 40 $SK_P/var/log/boot-decisions.log > $SK_S/0/boot-decisions.log 2>/dev/null
	mkdir -p $SK_R/devlink; for f in session.log webkit-desktop.log native-desktop.log page.log Xorg.log devlink/daemon.log; do : >> $SK_S/0/${f##*/}; ln -sf $SK_S/0/${f##*/} $SK_R/$f; done
	echo $SK_S/0 > $SK_R/start-logs
}
if mountpoint -q /persist; then starts_keep
	( for t in 30 60 120 300; do sleep $t; dmesg > $SK_S/0/kernel.log 2>/dev/null; done; while :; do sleep 600; dmesg > $SK_S/0/kernel.log 2>/dev/null; done ) &
fi
st "services started"
# 1.5.7: rudolfd's log is kept on the disk for this start and the 3 before it (/run/rudolf/rudolfd.log points to it)
RDLOG=/run/rudolf/rudolfd.log
if mountpoint -q /persist; then
	L=/persist/var/log; mkdir -p $L
	for i in 2 1; do [ -f $L/rudolfd.log.$i ] && mv -f $L/rudolfd.log.$i $L/rudolfd.log.$((i+1)); done
	[ -f $L/rudolfd.log ] && mv -f $L/rudolfd.log $L/rudolfd.log.1
	: > $L/rudolfd.log && chmod 600 $L/rudolfd.log && ln -sf $L/rudolfd.log $RDLOG && RDLOG=$L/rudolfd.log
fi
# 1.6.1 (docs/plan-1.6.1.md Part 9): the print queue (/run/cups/cups.sock: the desktop through rudolfd, and Linux apps
# through CUPS's clients); it becomes the "print" user once its socket is made; started again should it end
[ -e /var/run ] || ln -s ../run /var/run 2>/dev/null   # (where Flatpak looks for the cups socket it gives apps)
[ -x /usr/bin/rudolf-printq ] && ( while :; do rudolf-printq serve >> /run/rudolf/printq.log 2>&1; sleep 5; done ) &
# 1.6.1 (docs/plan-1.6.1.md Part 11): through rudolf-rootd, which starts rudolfd and runs its root helpers for it (and
# for nothing else: rudolfd's descriptor to it is the only way in)
if [ -x /usr/bin/rudolf-rootd ]; then rudolf-rootd /usr/bin/rudolfd > $RDLOG 2>&1 &
else rudolfd > $RDLOG 2>&1 &
fi
# 1.4.7: when memory runs out, the largest web page is ended instead of the whole desktop freezing
( while :; do rudolf-memguard >/dev/null 2>&1; sleep 2; done ) &
exec /usr/lib/rudolf/session
