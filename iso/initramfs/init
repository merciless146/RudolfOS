#!/bin/busybox sh
# Rudolf OS early start-up (initramfs). GPL-2.0-or-later.
# Finds the Rudolf OS disc or USB drive, optionally checks it, attaches the
# RUDOLFDATA partition, mounts the system layers read-only with a RAM overlay on
# top and hands over to /sbin/rudolf-init.
# System updates live in two slots on RUDOLFDATA (os/system/a and b). The disc's
# kernel starts first; if a slot is good, or an update is waiting with tries left,
# it hands over to that slot's kernel with kexec (rudolf.slot=a|b). An update that
# fails to start twice is dropped and the last good system starts instead.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts /run /mnt/media /mnt/ro /mnt/rw /mnt/persist /newroot
mount -t devpts devpts /dev/pts
echo 1 > /proc/sys/kernel/printk 2>/dev/null
CMD=$(cat /proc/cmdline)
# each option once (1.2.3): a kernel started by kexec puts its built-in options before the ones it is given,
# which already hold them
CMD=$(echo "$CMD" | awk '{o=""; for(i=1;i<=NF;i++) if(!s[$i]++) o=o (o==""?"":" ") $i; print o}')
has() { case " $CMD " in *" $1 "*) return 0;; esac; return 1; }
say() { echo "$*" > /dev/console; }
# Secure Boot (1.2.2): the firmware says whether it is on (the kernel then also locks itself down). With it on,
# nothing unchecked may start: a problem ends in a restart, never in a shell.
mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null
efv() { [ -r "/sys/firmware/efi/efivars/$1" ] && tail -c +5 "/sys/firmware/efi/efivars/$1"; }
SB=0; [ "$(efv SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c | od -An -tu1 | tr -d ' \n')" = 1 ] && SB=1
has rudolf.sb=1 && SB=1   # a kernel started by kexec from a Secure Boot start
# with Secure Boot on, the kernel is locked down before anything else runs: no unsigned modules or kernels, no
# writing to kernel memory (mainline Linux leaves this to the start-up)
if [ $SB = 1 ]; then mount -t securityfs securityfs /sys/kernel/security 2>/dev/null; echo integrity > /sys/kernel/security/lockdown 2>/dev/null; fi
fail() { if [ $SB = 1 ]; then say "Press Enter to restart."; read x < /dev/console; sync; reboot -f; fi; exec sh; }
# the UEFI boot menu (systemd-boot) says which entry was started; its options are not taken from the menu, so
# that nobody can add their own (Secure Boot)
ENTRY=$(efv LoaderEntrySelected-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f | tr -d '\000')
case "$ENTRY" in
	rudolf-recovery*) CMD="$CMD rudolf.recovery=1";;
	rudolf-check*) CMD="$CMD rudolf.check=1";;
	rudolf-ram*) CMD="$CMD rudolf.toram=1";;
	rudolf-debug*) [ $SB = 1 ] && say "Rudolf OS: debug start is not available with Secure Boot on; starting normally." || CMD="$CMD rudolf.debug=1";;
esac
if [ -e /dev/fb0 ]; then
	set -- $(tr , ' ' < /sys/class/graphics/fb0/virtual_size)
	printf 'IMG_LEFT=%d\nIMG_TOP=%d\n' $(( (${1:-640} - 640) / 2 )) $(( (${2:-360} - 360) / 2 )) > /tmp/splash.ini
	fbsplash -s /splash.ppm -i /tmp/splash.ini >/dev/null 2>&1
fi
ID=$(cat /etc/rudolf-id)

# 1.3.0: what kind of drive the firmware started from, from its boot entry (UEFI BootCurrent -> Boot####): a USB
# device path node (03 05) or an internal one (NVMe 03 17, SATA 03 12, SCSI 03 02). The start-up used to take the
# first Rudolf OS drive it found, so a laptop started from a stick could run from its internal drive (an NVMe drive is
# ready before a USB stick), and the other way round. Unknown (BIOS, or a short boot entry): as before.
BOOTVIA=""
BC=$(efv BootCurrent-8be4df61-93ca-11d2-aa0d-00e098032b8c | od -An -tx1 | tr -d ' \n')
if [ ${#BC} = 4 ]; then
	BE=$(efv Boot$(echo "${BC#??}${BC%??}" | tr a-f A-F)-8be4df61-93ca-11d2-aa0d-00e098032b8c | od -An -tx1 | tr -s ' \n' ' ')
	case "$BE" in *" 03 05 06 00 "*|*" 03 0f "*) BOOTVIA=usb;; *" 03 17 10 00 "*|*" 03 12 0a 00 "*|*" 03 02 08 00 "*) BOOTVIA=internal;; esac
fi
is_usb() { case "$(readlink -f /sys/class/block/${1##*/} 2>/dev/null)" in */usb*) return 0;; esac; return 1; }
# a drive of the other kind is passed over while the firmware's kind may still appear (USB sticks need a few seconds)
wrong_kind() { [ -n "$BOOTVIA" ] && [ "${i:-0}" -lt 16 ] || return 1; case "$1" in /dev/sr*) return 1;; esac; if is_usb "$1"; then [ "$BOOTVIA" = internal ]; else [ "$BOOTVIA" = usb ]; fi; }
# 1.4.1: an installed drive's partition table is valid for UEFI firmware: no partition over the Rudolf OS image (the
# disc image's partition 1 starts at sector 0 and holds the EFI system partition, which firmware takes for an invalid
# table, so the ASUS Vivobook Go could not start from its drive). The image is still at the start of the drive, so it
# is read from the whole disk, through a read-only loop device: mounting the whole disk itself would claim it and lock
# out its RUDOLFDATA partition. MEDIA stays the drive (/dev/nvme0n1); MLOOP is the loop device in use.
whole() { case "$1" in /dev/sr*) return 1;; esac; [ -b "$1" ] && [ ! -e "/sys/class/block/${1##*/}/partition" ]; }
MLOOP=""
mount_media() {
	if whole "$1"; then
		MLOOP=$(losetup -f) && losetup -r "$MLOOP" "$1" 2>/dev/null || { MLOOP=""; return 1; }
		mount -t iso9660 -o ro "$MLOOP" /mnt/media 2>/dev/null && return 0
		losetup -d "$MLOOP"; MLOOP=""; return 1
	fi
	mount -t iso9660 -o ro "$1" /mnt/media 2>/dev/null
}
umount_media() { umount /mnt/media 2>/dev/null; [ -n "$MLOOP" ] && losetup -d "$MLOOP" 2>/dev/null; MLOOP=""; }
find_media() {
	# partitions before whole disks
	for d in /dev/sr* /dev/sd?1 /dev/nvme?n?p1 /dev/vd?1 /dev/mmcblk?p1 /dev/sd? /dev/nvme?n? /dev/vd? /dev/mmcblk?; do
		[ -b "$d" ] || continue
		wrong_kind "$d" && continue
		mount_media "$d" || continue
		if [ "$(cat /mnt/media/rudolf/id 2>/dev/null)" = "$ID" ]; then MEDIA=$d; return 0; fi
		umount_media
	done
	return 1
}
SLOT=$(sed -n 's/.*rudolf\.slot=\([ab]\).*/\1/p' /proc/cmdline)
# a slot's kernel may be newer than the disc: any Rudolf OS disc will do, and none is needed
[ -n "$SLOT" ] && ID=any
# (1.4.1: and whole drives with the installed layout, partition 3 and no partition 1, after the partitions)
inst_layout() { whole "$1" && case "$1" in *[0-9]) [ ! -b "${1}p1" ] && [ -b "${1}p3" ];; *) [ ! -b "${1}1" ] && [ -b "${1}3" ];; esac; }
find_media_any() { [ "$ID" = any ] || return 1; for d in /dev/sr* /dev/sd?1 /dev/nvme?n?p1 /dev/vd?1 /dev/mmcblk?p1 /dev/sd? /dev/nvme?n? /dev/vd? /dev/mmcblk?; do [ -b "$d" ] || continue; whole "$d" && ! inst_layout "$d" && continue; [ -n "$MDEV" ] && [ "$d" != "$MDEV" ] && [ "${i:-0}" -lt 16 ] && continue; wrong_kind "$d" && continue; mount_media "$d" || continue; [ -e /mnt/media/rudolf/id ] && { MEDIA=$d; return 0; }; umount_media; done; return 1; }
# 1.3.0: a slot's kernel first tries the drive the disc's kernel started from (rudolf.mediadev=, passed on at the
# handover): with another Rudolf OS stick plugged in, "any Rudolf OS disc" could otherwise be that stick
# (1.4.1: a whole drive is passed on as rudolf.mediadisk=: a slot's kernel from before 1.4.1 would mount it directly
# and lock out RUDOLFDATA; it ignores that option, finds no media and takes RUDOLFDATA by rudolf.persist=)
MDEV=$(echo " $CMD " | sed -n 's/.* rudolf\.media\(dev\|disk\)=\([^ ]*\) .*/\2/p')
find_media_given() { [ -n "$SLOT" ] && [ -n "$MDEV" ] && [ -b "$MDEV" ] || return 1; mount_media "$MDEV" || return 1; [ -e /mnt/media/rudolf/id ] && { MEDIA=$MDEV; return 0; }; umount_media; return 1; }
i=0
until find_media_given || find_media || find_media_any; do
	# (1.3.0: a slot's kernel told which drive to use waits for it as the disc's kernel did: a USB stick takes a few seconds)
	[ -n "$SLOT" ] && [ $i -ge 6 ] && { [ -z "$MDEV" ] || [ $i -ge 16 ]; } && { MEDIA=""; break; }
	i=$((i + 1))
	[ $i -eq 6 ] && say "Rudolf OS: still looking for the Rudolf OS disc or USB drive..."
	if [ $i -ge 40 ]; then
		say ""
		say "Rudolf OS could not find its disc or USB drive."
		say "The drive may be unplugged, or its controller is not supported."
		[ $SB = 1 ] || say "Type 'reboot' to restart. A shell follows for diagnosis."
		fail
	fi
	sleep 0.5
done

# saved data (first: it holds the system slots)
# 1.3.0: which RUDOLFDATA. Before, always the first one found anywhere (findfs), so a Rudolf OS stick with its own
# files, started on a computer where Rudolf OS is installed, could take the internal drive's files instead.
#  - a slot's kernel: the one the disc's kernel chose (rudolf.persist=UUID, passed on at the handover). 1.3.1: when
#    the disc's kernel is older (boot files from before 1.3.0 pass nothing on), the one an older start-up takes (the
#    first found), and only one that holds this slot: 1.3.0 took the start drive's own instead, so a laptop with an
#    old Rudolf OS stick plugged in ran the stick's old system and files after updating;
#  - started from a drive: that drive's own (partition 3, as Install here, Make a stick and Keep files on this drive
#    make it), when it has one;
#  - otherwise as before: the first one found (a stick written by Rufus has none: running it live would take an
#    installed computer's files away whenever one is plugged in). Which drive is the start drive: see BOOTVIA above.
disk_of() { case "$1" in /dev/nvme*p[0-9]*|/dev/mmcblk*p[0-9]*) echo "${1%p[0-9]*}";; /dev/[sv]d[a-z][0-9]*) echo "${1%%[0-9]*}";; *) echo "$1";; esac; }
part3() { case "$1" in *[0-9]) echo "${1}p3";; *) echo "${1}3";; esac; }
is_data() { [ -b "$1" ] && [ "$(blkid "$1" 2>/dev/null | sed -n 's/.* LABEL="\([^"]*\)".*/\1/p')" = RUDOLFDATA ]; }
choose_persist() {
	U=$(echo " $CMD " | sed -n 's/.* rudolf\.persist=\([^ ]*\) .*/\1/p')
	if [ -n "$SLOT" ] && [ -n "$U" ]; then findfs "UUID=$U" 2>/dev/null && return; fi
	if [ -n "$SLOT" ]; then findfs LABEL=RUDOLFDATA 2>/dev/null; return; fi
	case "$MEDIA" in /dev/sr*|"") ;; *) D=$(disk_of "$MEDIA"); is_data "$(part3 "$D")" && { part3 "$D"; return; };; esac
	findfs LABEL=RUDOLFDATA 2>/dev/null
}
PERSIST=""
if ! has rudolf.nopersist=1; then
	P=$(choose_persist)
	if [ -n "$P" ] && mount -t ext4 -o rw,noatime "$P" /mnt/persist 2>/dev/null; then
		PERSIST=$P
	fi
	# 1.3.1: a slot's kernel needs the data partition that holds its slot (the disc's kernel found it there): if the
	# first one found does not, any other that does (internal drives first).
	# 1.4.2: and the slot there must be this kernel's own (its build string, in the kernel file's uncompressed header).
	# On the Vivobook, boot files from 1.1 on the stick passed nothing on; the 1.4.1 kernel took the stick's
	# RUDOLFDATA, whose slot a held 1.4.0, and started with 1.4.0's drivers, which it refused (each build signs its own):
	# no Wi-Fi, no graphics. A slot that is not this kernel's only counts when no data partition has the right one.
	KV=$(uname -v 2>/dev/null)
	slot_here() { [ -e /mnt/persist/os/system/$SLOT/complete ] && { [ -z "$KV" ] || head -c 65536 /mnt/persist/os/system/$SLOT/vmlinuz 2>/dev/null | grep -qF "$KV"; }; }
	# 1.4.4: with nothing passed on (older boot files), every data partition is looked at, not only the first one
	# found: two may hold this kernel's own build (1.4.3 kept 1.4.2's kernel, so the stick's 1.4.2 matched as well as
	# the drive's 1.4.3), and the newest release among them is taken (internal drives first when equal)
	HINT=$(echo " $CMD " | sed -n 's/.* rudolf\.persist=\([^ ]*\) .*/\1/p')
	if [ -n "$SLOT" ] && { [ -z "$HINT" ] || ! slot_here; }; then
		[ -n "$PERSIST" ] && umount /mnt/persist; PERSIST=""; BEST=""; BS=-1
		for P in /dev/nvme?n?p3 /dev/mmcblk?p3 /dev/vd?3 /dev/sd?3; do
			is_data "$P" || continue
			mount -t ext4 -o rw,noatime "$P" /mnt/persist 2>/dev/null || continue
			if slot_here; then
				SV=$(sed -n 's/^serial //p' /mnt/persist/os/system/$SLOT/RELEASE 2>/dev/null); case "$SV" in ''|*[!0-9]*) SV=0;; esac
				[ "$SV" -gt "$BS" ] && { BEST=$P; BS=$SV; }
			fi
			umount /mnt/persist
		done
		[ -n "$BEST" ] && mount -t ext4 -o rw,noatime "$BEST" /mnt/persist 2>/dev/null && PERSIST=$BEST
		[ -z "$PERSIST" ] && for P in /dev/nvme?n?p3 /dev/mmcblk?p3 /dev/vd?3 /dev/sd?3; do
			is_data "$P" || continue
			mount -t ext4 -o rw,noatime "$P" /mnt/persist 2>/dev/null || continue
			[ -e /mnt/persist/os/system/$SLOT/complete ] && { PERSIST=$P; break; }
			umount /mnt/persist
		done
		[ -z "$PERSIST" ] && { P=$(choose_persist); [ -n "$P" ] && mount -t ext4 -o rw,noatime "$P" /mnt/persist 2>/dev/null && PERSIST=$P; }
	fi
	# 1.3.1: and the Rudolf OS image on the same drive (a slot may take unchanged layers from it), not another
	# Rudolf OS drive that happens to be plugged in, when the disc's kernel did not say which (older boot files)
	if [ -n "$SLOT" ] && [ -z "$MDEV" ] && [ -n "$PERSIST" ]; then
		D=$(disk_of "$PERSIST"); case "$D" in *[0-9]) PM=${D}p1;; *) PM=${D}1;; esac
		[ -b "$PM" ] || { inst_layout "$D" && PM=$D; }
		if [ "$PM" != "$MEDIA" ] && [ -b "$PM" ]; then
			[ -n "$MEDIA" ] && umount_media
			if mount_media "$PM" && [ -e /mnt/media/rudolf/id ]; then MEDIA=$PM
			else umount_media; [ -n "$MEDIA" ] && mount_media "$MEDIA"; fi
		fi
	fi
	if [ -n "$PERSIST" ]; then
		if [ -e /mnt/persist/.factory-reset ]; then
			say "Rudolf OS: erasing saved data (factory reset)..."
			# 1.2.8: a drive with boot files only (no system on its image) keeps its installed system
			if [ -e /mnt/media/rudolf/bootonly ]; then find /mnt/persist -mindepth 1 -maxdepth 1 ! -name lost+found ! -name os -exec rm -rf {} +; rm -rf /mnt/persist/os/current /mnt/persist/os/bootimg
			else find /mnt/persist -mindepth 1 -maxdepth 1 ! -name lost+found -exec rm -rf {} +; fi
		fi
	fi
fi

# ---- new boot files (1.2.8, Settings > Security > Secure Boot > Get new boot files): an image staged on RUDOLFDATA
# (bootfiles.sh stage) is written over the area in front of it, on the same disk, before anything uses that area.
# The RUDOLFDATA entry of the partition table is kept; the copy is read back and compared; then a restart.
BI=/mnt/persist/os/bootimg
if [ -n "$PERSIST" ] && [ -s $BI/pending ] && [ -s $BI/boot.iso ] && ! has rudolf.recovery=1; then
	bgv() { sed -n "s/^$1=//p" $BI/pending; }
	case "$PERSIST" in /dev/nvme*p3|/dev/mmcblk*p3) BD=${PERSIST%p3};; /dev/[sv]d[a-z]3) BD=${PERSIST%3};; *) BD="";; esac
	BS=$(bgv start); BB=$(bgv blocks); BH=$(bgv sha); WHY=""
	[ -n "$BD" ] && [ -b "$BD" ] || WHY="the drive could not be found"
	if [ -z "$WHY" ]; then
		E=$(dd if=$BD bs=1 skip=478 count=16 2>/dev/null | od -An -tx1 | tr -d ' \n')
		CS=$(dd if=$BD bs=1 skip=486 count=4 2>/dev/null | od -An -tu4 | tr -d ' \n')
		[ "$CS" != "$BS" ] && WHY="the partition table changed"
	fi
	[ -z "$WHY" ] && [ $((BB * 4)) -gt "${BS:-0}" ] && WHY="it does not fit"
	[ -z "$WHY" ] && [ "$(sha256sum $BI/boot.iso | cut -c1-64)" != "$BH" ] && WHY="the kept copy is damaged"
	if [ -n "$WHY" ]; then
		say "Rudolf OS: the new boot files were not written ($WHY)."; echo "not written: $WHY" > $BI/result; rm -f $BI/pending $BI/boot.iso; sync; sleep 4
	else
		clear > /dev/console
		say "Rudolf OS: writing the new boot files (Rudolf OS $(bgv version))."
		say "Do not switch the computer off. This takes about a minute."
		umount_media
		h2b() { for h in $(echo "$1" | sed 's/../& /g'); do printf "\\$(printf %03o 0x$h)"; done; }
		WANT=$({ dd if=$BI/boot.iso bs=478 count=1 2>/dev/null; h2b "$E"; dd if=$BI/boot.iso bs=2048 count=$BB 2>/dev/null | tail -c +495; } | sha256sum | cut -c1-64)
		OKW=""
		for t in 1 2 3; do
			dd if=$BI/boot.iso of=$BD bs=2048 count=$BB conv=fsync 2>/dev/null
			h2b "$E" | dd of=$BD bs=1 seek=478 conv=notrunc,fsync 2>/dev/null
			sync; blockdev --flushbufs $BD 2>/dev/null; echo 3 > /proc/sys/vm/drop_caches
			[ "$(dd if=$BD bs=2048 count=$BB 2>/dev/null | sha256sum | cut -c1-64)" = "$WANT" ] && { OKW=1; break; }
			say "Rudolf OS: the copy does not match; writing it again ($t)."
		done
		if [ -n "$OKW" ]; then
			# 1.4.1: an internal drive gets the installed layout (no partition 1 over the image: the firmware can start it)
			# and a disk signature of its own (the image's is the same on every drive made from it); rudolfd adds the
			# boot entry for it at the next start. A USB stick keeps the image's table: firmware starts it as a CD.
			# (the same rule as /usr/lib/rudolf/layout.sh)
			case "$(readlink -f /sys/block/${BD##*/})" in */usb*|*/mmc*) RMV=1;; *) RMV=$(cat /sys/block/${BD##*/}/removable 2>/dev/null);; esac
			if [ "$RMV" != 1 ]; then
				dd if=/dev/zero of=$BD bs=1 seek=446 count=16 conv=notrunc,fsync 2>/dev/null
				SG=00000000; while [ "$SG" = 00000000 ]; do SG=$(dd if=/dev/urandom bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n'); done
				h2b "$SG" | dd of=$BD bs=1 seek=440 conv=notrunc,fsync 2>/dev/null; sync
			elif [ "$(dd if=$BD bs=1 skip=446 count=16 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 00000000000000000000000000000000 ]; then
				# a stick written from an installed drive's image: partition 1 back (start 0, the image's size)
				N1=$((BB * 4)); h2b "80feffff17feffff00000000$(printf %02x%02x%02x%02x $((N1 & 255)) $(((N1 >> 8) & 255)) $(((N1 >> 16) & 255)) $(((N1 >> 24) & 255)))" | dd of=$BD bs=1 seek=446 conv=notrunc,fsync 2>/dev/null; sync
			fi
			echo "written $(date -u +%Y-%m-%dT%H:%MZ): Rudolf OS $(bgv version) (serial $(bgv serial))" > $BI/result; rm -f $BI/pending $BI/boot.iso
			say "Rudolf OS: the new boot files are written. Restarting."
		else
			echo "failed $(date -u +%Y-%m-%dT%H:%MZ): the copy did not match three times" > $BI/result; rm -f $BI/pending
			say "Rudolf OS: the new boot files could not be written correctly; the drive may be failing."
			say "Your files are safe. If the computer does not start, start it from a Rudolf OS USB stick and use"
			say "Install here > Replace the boot files only. Press Enter to restart."; read x < /dev/console
		fi
		cd /; umount /mnt/persist; sync; sleep 2; reboot -f
	fi
fi

# ---- which system to start
SYSD=/mnt/persist/os/system
st_get() { sed -n "s/^$1=//p" $SYSD/state 2>/dev/null; }
st_write() { { echo "good=$GOOD"; echo "prev=$PREV"; echo "next=$NEXT"; echo "tries=$TRIES"; echo "failed=$FAILED"; } > $SYSD/state.new && sync && mv $SYSD/state.new $SYSD/state && sync; }
slot_ok() { [ -s $SYSD/$1/vmlinuz ] && [ -e $SYSD/$1/complete ]; }
# a slot whose system cannot start (a layer damaged or failing its check): never again, back to the previous one
slot_bad() {
	GOOD=$(st_get good); PREV=$(st_get prev); NEXT=$(st_get next); TRIES=$(st_get tries); FAILED=$SLOT
	[ "$NEXT" = "$SLOT" ] && { NEXT=""; TRIES=0; }
	[ "$GOOD" = "$SLOT" ] && GOOD=$PREV
	st_write; say "Rudolf OS: this update cannot start; restarting with the previous system."; sync; sleep 5; reboot -f
}
if [ -z "$SLOT" ] && [ -n "$PERSIST" ] && [ -f $SYSD/state ] && ! has rudolf.recovery=1; then
	GOOD=$(st_get good); PREV=$(st_get prev); NEXT=$(st_get next); TRIES=$(st_get tries); FAILED=$(st_get failed)
	T=""; TRY=""
	if [ -n "$NEXT" ] && slot_ok "$NEXT" && [ "${TRIES:-0}" -gt 0 ]; then
		TRIES=$((TRIES - 1)); T=$NEXT; TRY=1; st_write
	elif [ -n "$NEXT" ]; then
		FAILED=$NEXT; NEXT=""; TRIES=0; st_write; T=$GOOD
	else
		T=$GOOD
	fi
	case "$T" in a|b) ;; *) T="";; esac
	if [ -n "$T" ] && slot_ok "$T"; then
		cp $SYSD/$T/vmlinuz /tmp/vmlinuz
		NC="$CMD rudolf.slot=$T"; [ -n "$TRY" ] && NC="$NC rudolf.trying=1"; [ $SB = 1 ] && NC="$NC rudolf.sb=1 lockdown=integrity"
		# 1.3.0: the same drive and data partition for the slot's kernel
		if whole "$MEDIA"; then NC="$NC rudolf.mediadisk=$MEDIA"; elif [ -n "$MEDIA" ]; then NC="$NC rudolf.mediadev=$MEDIA"; fi; PU=$(blkid "$PERSIST" 2>/dev/null | sed -n 's/.* UUID="\([^"]*\)".*/\1/p'); [ -n "$PU" ] && NC="$NC rudolf.persist=$PU"
		cd /; umount /mnt/persist; umount_media; sync
		rudolf-kexec /tmp/vmlinuz "$NC"
		# kexec failed: count it as a failed start and carry on with the disc's own system
		mount -t ext4 -o rw,noatime "$PERSIST" /mnt/persist; [ -n "$MEDIA" ] && mount_media "$MEDIA"
		say "Rudolf OS: could not start the updated system; starting the one on the disc."
		[ -n "$TRY" ] && { FAILED=$T; NEXT=""; TRIES=0; st_write; }
	fi
fi

# the media check (start menu: Check this disc or USB drive for errors). It runs here, after the choice of system,
# so it runs once, in the kernel that starts the system: the disc's, or an installed update's after the handover
# (1.2.6: it ran in both, and the result of the first was lost)
if has rudolf.check=1 && [ -z "$MEDIA" ]; then
	echo "No Rudolf OS disc or USB drive was found to check." > /tmp/check-result
elif has rudolf.check=1; then
	clear > /dev/console
	say "Checking the Rudolf OS files on $MEDIA (this takes a few minutes)..."
	cd /mnt/media
	grep -v "  boot/rboot.bin$" rudolf/sha256 > /tmp/sums 2>/dev/null
	sha256sum -c /tmp/sums > /tmp/check.txt 2>&1
	# the boot loader is patched with the kernel's place on the disc (RBTB + 8 bytes) when the image is written: 1.2.6
	# discs list it patched, older ones as it was built (those 8 bytes zero), so both are accepted (1.2.6)
	W=$(sed -n 's#^\([0-9a-f]\{64\}\)  boot/rboot.bin$#\1#p' rudolf/sha256 2>/dev/null)
	if [ -n "$W" ]; then
		H=$(sha256sum boot/rboot.bin 2>/dev/null | cut -c1-64)
		if [ -n "$H" ] && [ "$H" != "$W" ]; then
			O=$(od -An -v -tx1 boot/rboot.bin | awk '{for (i = 1; i <= NF; i++) b[n++] = $i} END {for (i = 0; i + 3 < n; i++) if (b[i] == "52" && b[i+1] == "42" && b[i+2] == "54" && b[i+3] == "42") {print i; exit}}')
			cp boot/rboot.bin /tmp/rboot.bin
			[ -n "$O" ] && dd if=/dev/zero of=/tmp/rboot.bin bs=1 seek=$((O + 4)) count=8 conv=notrunc 2>/dev/null
			H=$(sha256sum /tmp/rboot.bin | cut -c1-64); rm -f /tmp/rboot.bin
		fi
		[ "$H" = "$W" ] && echo "boot/rboot.bin: OK" >> /tmp/check.txt || echo "boot/rboot.bin: FAILED" >> /tmp/check.txt
	fi
	N=$(grep -c . rudolf/sha256 2>/dev/null); B=$(grep -c ': FAILED$' /tmp/check.txt)
	if [ ! -s rudolf/sha256 ] || [ "$N" = 0 ]; then R="ERRORS FOUND - the list of files (rudolf/sha256) is missing. Make a new disc or USB drive."
	elif [ "$B" = 0 ]; then R="All $N files are intact."
	else F=$(grep ': FAILED$' /tmp/check.txt | sed 's/: FAILED$//' | head -3 | tr '\n' ' '); [ "$B" -gt 3 ] && F="$F..."
		R="ERRORS FOUND in $B of $N files (${F% }) - this disc or USB drive is damaged. Make a new one."; fi
	cd /
	say ""; say "$R"; grep -v -e ': OK$' -e '^sha256sum: WARNING' /tmp/check.txt > /dev/console
	say ""; say "Press Enter to continue."; read x < /dev/console
	echo "$R" > /tmp/check-result
fi

# ---- system layers: the slot's, or the disc's (a slot may point to an unchanged disc layer)
# Each is mapped through dm-verity with the root hash from the signed release list (1.2.2): the slot's list (or,
# for a slot made by an older Rudolf OS, the saved list of the same release), else the disc's. With Secure Boot
# on, a layer that cannot be checked does not start; with it off, it starts unchecked and Task Manager says so.
MAN=""; MSIG=""
if [ -n "$SLOT" ]; then
	RS=$(sed -n 's/^serial //p' $SYSD/$SLOT/RELEASE 2>/dev/null)
	for m in $SYSD/$SLOT/manifest $SYSD/available; do
		[ -s $m.txt ] && [ -s $m.sig ] || continue
		[ "$m" = $SYSD/available ] && [ "$(sed -n 's/^serial //p' $m.txt)" != "$RS" ] && continue
		MAN=$m.txt; MSIG=$m.sig; break
	done
elif [ -n "$MEDIA" ] && [ -s /mnt/media/rudolf/manifest.txt ]; then MAN=/mnt/media/rudolf/manifest.txt; MSIG=/mnt/media/rudolf/manifest.sig
fi
UNV=""
mkdir -p /mnt/l
LOWER=""
for L in desktop chromium modules base; do
	F=""
	if [ -n "$SLOT" ] && [ -s $SYSD/$SLOT/$L.sfs ]; then F=$SYSD/$SLOT/$L.sfs
	elif [ -n "$MEDIA" ] && [ -s /mnt/media/rudolf/$L.sfs ]; then F=/mnt/media/rudolf/$L.sfs
	fi
	if [ -z "$F" ] && [ -e /mnt/media/rudolf/bootonly ]; then
		say "Rudolf OS: this drive has boot files only (1.2.8), and its installed system could not start."
		say "Start from a Rudolf OS USB stick and use Settings > Update and recovery > Install here."
		fail
	fi
	[ -n "$F" ] || { say "Rudolf OS: the system layer '$L' is missing."; fail; }
	if has rudolf.toram=1; then
		[ -d /mnt/ram ] || { mkdir -p /mnt/ram && mount -t tmpfs -o size=90% tmpfs /mnt/ram; }
		cp "$F" /mnt/ram/$L.sfs && F=/mnt/ram/$L.sfs
	fi
	mkdir -p /mnt/l/$L
	LOOP=$(losetup -f)
	losetup -r "$LOOP" "$F" || { say "Rudolf OS: the system layer '$L' cannot be read."; [ -n "$SLOT" ] && slot_bad; fail; }
	DEV=""; WHY="no signed release list"
	if [ -n "$MAN" ]; then DEV=$(rudolf-verity open "$MAN" "$MSIG" /etc/rudolf-keys "$L" "$LOOP" 2>/tmp/verity.err) || DEV=""; [ -s /tmp/verity.err ] && WHY=$(sed 's/^rudolf-verity: //' /tmp/verity.err | head -1); fi
	if [ -n "$DEV" ] && mount -t squashfs -o ro "$DEV" /mnt/l/$L 2>/dev/null; then :
	elif [ $SB = 1 ]; then
		say "Rudolf OS: the system layer '$L' did not pass the check ($WHY). With Secure Boot on, only a checked system starts."
		[ -n "$SLOT" ] && slot_bad; fail
	else
		[ -n "$DEV" ] && WHY="it does not match its signed hash"
		mount -t squashfs -o ro "$LOOP" /mnt/l/$L || { say "Rudolf OS: the system layer '$L' is damaged."; [ -n "$SLOT" ] && slot_bad; fail; }
		UNV="$UNV$L: $WHY\n"
	fi
	LOWER="$LOWER${LOWER:+:}/mnt/l/$L"
done
mount -t tmpfs -o mode=0755 tmpfs /mnt/rw
mkdir -p /mnt/rw/upper /mnt/rw/work
mount -t overlay overlay -o lowerdir=$LOWER,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work /newroot || { say "Rudolf OS: overlay mount failed."; fail; }

mkdir -p /newroot/live/media /newroot/persist /newroot/run
[ -n "$MEDIA" ] && mount --move /mnt/media /newroot/live/media
[ -n "$PERSIST" ] && mount --move /mnt/persist /newroot/persist
mkdir -p /newroot/etc/rudolf
echo "$MEDIA" > /newroot/etc/rudolf/media
echo "$BOOTVIA" > /newroot/etc/rudolf/bootvia
echo "$PERSIST" > /newroot/etc/rudolf/persist
echo "${SLOT:-disc}" > /newroot/etc/rudolf/slot
echo "$SB" > /newroot/etc/rudolf/secureboot
printf "%b" "$UNV" > /newroot/etc/rudolf/unverified
echo "$ENTRY" > /newroot/etc/rudolf/boot-entry
[ -e /tmp/check-result ] && cp /tmp/check-result /newroot/etc/rudolf/check.txt
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
# the start-up options the system uses (with the menu's choice, each option once): /etc/rudolf/cmdline. 1.2.8: no
# longer mounted over /proc/cmdline. A mount over a file in /proc makes the kernel refuse every new /proc mount in a
# user namespace ("mount_too_revealing"): the Debian sandbox and Flatpak's bubblewrap could not start ("mounting /proc
# failed (Operation not permitted)") on every computer running an installed update, whose kernel (started by kexec)
# always had options given twice, so this mount was always made there (since 1.2.3).
echo "$CMD" > /newroot/etc/rudolf/cmdline
mount --move /sys /newroot/sys
exec switch_root /newroot /sbin/rudolf-init
